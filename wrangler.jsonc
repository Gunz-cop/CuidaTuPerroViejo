{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuidatuperroviejo",
  "compatibility_date": "2026-05-23",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "kv_namespaces": [
    {
      "binding": "CONTACT_KV",
      "id": "707dd02ce0434005a78d89fd138d0647"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
