---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const pilaresEntries = await getCollection('pilares');
  const blogEntries = await getCollection('blog');

  return pilaresEntries.map(pilar => {
    // Filter posts from the blog collection that belong to this content pilar
    const filteredPosts = blogEntries.filter(post => post.data.pilar === pilar.slug);
    
    return {
      params: { pilar: pilar.slug },
      props: {
        pilar,
        posts: filteredPosts
      }
    };
  });
}

const { pilar, posts } = Astro.props;
const { Content } = await pilar.render();
---

<BaseLayout 
  title={pilar.data.seoTitle}
  description={pilar.data.metaDescription}
>
  <main class="max-w-4xl mx-auto px-4 py-8 sm:py-12 w-full">
    <!-- Breadcrumbs / Navigation -->
    <Breadcrumbs pilarSlug={pilar.slug} pilarName={pilar.data.title} />

    <!-- Pilar Content Section -->
    <div class="content-body prose dark:prose-invert max-w-none mb-12">
      <Content />
    </div>

    <!-- Elegant visual separator -->
    <hr class="border-brand-border my-12" />

    <!-- Intermediate Header (H2) -->
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-brand-text mb-8">
      Guías Especializadas de {pilar.data.title}
    </h2>

    <!-- Adaptable Articles Grid -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {posts.map(post => (
          <a 
            href={`/${pilar.slug}/${post.slug}`} 
            class="group flex flex-col justify-between bg-brand-card dark:bg-brand-bg/50 border border-brand-border rounded-xl p-5 shadow-sm hover:shadow-md hover:border-brand-primary/40 transition duration-300 relative overflow-hidden"
          >
            {/* Top border highlight on hover */}
            <div class="absolute top-0 left-0 right-0 h-1 bg-brand-primary transform -translate-y-1 group-hover:translate-y-0 transition-transform duration-300"></div>
            
            <div>
              <h3 class="text-lg font-bold text-brand-text group-hover:text-brand-accent transition-colors duration-200 line-clamp-2 leading-snug">
                {post.data.title}
              </h3>
              {post.data.metaDescription && (
                <p class="text-brand-muted text-sm mt-2 line-clamp-2 leading-relaxed">
                  {post.data.metaDescription}
                </p>
              )}
            </div>

            <div class="mt-4 flex items-center text-xs font-semibold text-brand-primary group-hover:text-brand-accent transition-colors duration-200">
              <span>Leer artículo</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <!-- Empty State -->
      <div class="text-center py-12 px-4 bg-brand-card border border-brand-border rounded-xl shadow-sm">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-brand-secondary/40 text-brand-primary mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-brand-text mb-1">Aún no hay artículos</h3>
        <p class="text-brand-muted text-sm">
          Estamos preparando el mejor contenido para esta sección. ¡Vuelve pronto!
        </p>
      </div>
    )}
  </main>
</BaseLayout>
