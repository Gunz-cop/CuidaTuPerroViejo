---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiloNavigation from '../../components/SiloNavigation.astro';
import PostReader from '../../components/PostReader.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';


export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { pilar: entry.data.pilar, slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const pilarNames: Record<string, string> = {
  'guia-para-cuidar-tu-perro-senior': 'Guía para Cuidar tu Perro Senior',
  'salud-perros-mayores': 'Salud de Perros Mayores',
  'alimentacion-perros-senior': 'Alimentación de Perro Senior',
  'movilidad-dolor-perros-mayores': 'Movilidad y Dolor en Perros Mayores',
  'salud-mental-emocional-perros': 'Salud Mental y Emocional',
  'higiene-hogar-perros-senior': 'Higiene y Hogar para Perros Senior',
  'cuidados-paliativos-perros': 'Cuidados Paliativos'
};

const pilarName = pilarNames[entry.data.pilar] || entry.data.pilar;
const heroImage = entry.data.heroImage;
const heroImageAlt = entry.data.heroImageAlt || entry.data.title;

// Construir srcset: incluye -400w (garantizado) y el original como 1200w
// El -800w no existe para todas las imágenes, se omite para evitar 404s
function buildSrcset(src: string | undefined): string {
  if (!src) return '';
  const base = src.replace(/\.webp$/i, '');
  return `${base}-400.webp 400w, ${src} 1200w`;
}
const heroImageSrcset = buildSrcset(heroImage);

// URL canónica del post
const postURL = new URL(`/${entry.data.pilar}/${entry.slug}`, Astro.site).href;
const pilarURL = new URL(`/${entry.data.pilar}`, Astro.site).href;
const siteURL = Astro.site?.href ?? 'https://cuidatuperroviejo.com/';

// Fechas — datePublished del frontmatter, dateModified siempre al build
const datePublished = entry.data.datePublished
  ? new Date(entry.data.datePublished).toISOString()
  : '2025-10-01T00:00:00-06:00';
const dateModified = new Date().toISOString();

// Imagen absoluta para schema
const schemaImage = heroImage
  ? new URL(heroImage, Astro.site).href
  : new URL('/images/home/perro-senior-hero-cama-ortopedica.webp', Astro.site).href;

// Schema BlogPosting
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${postURL}#article`,
      'headline': entry.data.seoTitle || entry.data.title,
      'name': entry.data.title,
      'description': entry.data.metaDescription,
      'url': postURL,
      'image': [
        {
          '@type': 'ImageObject',
          'url': schemaImage,
          'width': 1200,
          'height': 675,
          'caption': heroImageAlt,
        },
      ],
      'datePublished': datePublished,
      'dateModified': dateModified,
      'author': {
        '@type': 'Person',
        'name': 'Equipo Cuida a tu Perro Viejo',
        'jobTitle': 'Especialistas en bienestar y cuidado canino',
        'url': `${siteURL}acerca-de`,
      },
      'publisher': {
        '@type': 'Organization',
        'name': 'Cuida tu Perro Viejo',
        'url': siteURL,
        'logo': {
          '@type': 'ImageObject',
          'url': new URL('/favicon.png', Astro.site).href,
        },
      },
      'mainEntityOfPage': { '@id': postURL },
      'isPartOf': { '@id': `${pilarURL}#webpage` },
      'inLanguage': 'es',
      'keywords': entry.data.keywordPrincipal ?? '',
      'articleSection': pilarName,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${postURL}#breadcrumb`,
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': siteURL },
        { '@type': 'ListItem', 'position': 2, 'name': pilarName, 'item': pilarURL },
        { '@type': 'ListItem', 'position': 3, 'name': entry.data.title, 'item': postURL },
      ],
    },
  ],
};

// CSS para ocultar la heroImage dentro del body del post (evita imagen duplicada)
const hideHeroCSS = heroImage
  ? `.content-body img[src="${heroImage}"],
     .content-body p:has(> img[src="${heroImage}"]) { display: none !important; }
     .content-body p:has(> img[src="${heroImage}"]) + p:has(> em:only-child) { display: none !important; }`
  : '';
---

<BaseLayout
  title={entry.data.seoTitle || entry.data.title}
  description={entry.data.metaDescription}
  keywords={entry.data.keywordPrincipal}
  image={entry.data.heroImage}
  ogType="article"
>
  <!-- Schema BlogPosting + BreadcrumbList -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

  <!-- Ocultar heroImage donde aparezca repetida en el body -->
  {heroImage && (
    <style slot="head" is:inline set:html={hideHeroCSS} />
  )}

  <main class="max-w-5xl mx-auto px-4 py-8 md:py-12 w-full">
    <!-- Breadcrumbs -->
    <Breadcrumbs pilarSlug={entry.data.pilar} pilarName={pilarName} title={entry.data.title} />

    <article>
      <!-- ===== HERO HEADER ===== -->
      <header class="mb-8 md:mb-10 max-w-3xl mx-auto lg:max-w-none">
        <!-- Badge de pilar -->
        <div class="mb-4">
          <a
            href={`/${entry.data.pilar}`}
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-secondary text-brand-primary border border-brand-primary/20 uppercase tracking-wider hover:bg-brand-primary/10 transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            {pilarName}
          </a>
        </div>

        <!-- H1 -->
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-brand-text leading-tight mb-4">
          {entry.data.title}
        </h1>

        <!-- Subtítulo -->
        {entry.data.metaDescription && (
          <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light border-l-4 border-brand-primary/40 pl-4 mt-4 mb-6">
            {entry.data.metaDescription}
          </p>
        )}

        <!-- Feature Image Hero -->
        {heroImage ? (
          <figure class="mt-6 mb-2 -mx-4 sm:mx-0">
            <div class="overflow-hidden rounded-none sm:rounded-2xl shadow-lg aspect-[16/9] bg-brand-secondary/20">
              <img
                src={heroImage}
                alt={heroImageAlt}
                class="w-full h-full object-cover object-center transition-transform duration-700 hover:scale-[1.02]"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                width="1200"
                height="675"
                srcset={heroImageSrcset}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 800px"
              />
            </div>
            <figcaption class="mt-2 text-center text-xs text-brand-muted italic px-4 sm:px-0">
              {heroImageAlt}
            </figcaption>
          </figure>
        ) : (
          <div class="mt-6 mb-2 -mx-4 sm:mx-0 overflow-hidden rounded-none sm:rounded-2xl h-48 md:h-64 bg-gradient-to-br from-brand-secondary/30 via-brand-primary/10 to-brand-secondary/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-brand-primary/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
        )}

        <div class="mt-8 border-b border-brand-border"></div>
      </header>

      <!-- ===== ARTICLE CONTENT & TOC ===== -->
      <PostReader entry={entry}>
        <Content />
      </PostReader>
    </article>

    <FeedbackWidget slug={entry.slug} />

    <SiloNavigation currentPilar={entry.data.pilar} currentSlug={entry.slug} />
  </main>
</BaseLayout>
