            "@type": "WebSite",
            "@id": "https://www.cuidatuperroviejo.com/#website",
            "url": "https://www.cuidatuperroviejo.com/",
            "name": "Cuida tu perro viejo",
            "inLanguage": "es"
          },
          {
            "@type": "WebPage",
            "@id": "https://www.cuidatuperroviejo.com/",
            "url": "https://www.cuidatuperroviejo.com/",
            "name": "Guía completa para cuidar a tu perro senior",
            "isPartOf": { "@id": "https://www.cuidatuperroviejo.com/#website" },
            "breadcrumb": { "@id": "https://www.cuidatuperroviejo.com/#breadcrumb" },
