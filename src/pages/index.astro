              "@id": "https://www.cuidatuperroviejo.com/#primaryimage",
              "url": "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgL1bwXO4TGe9u8VLw1VvD9AzfngIkDvfms2g9m7HHQhGb9gNxH6iPGq7o3xd2am92yEynp4NWKA9ZUHb6HwVUL0_CGtnpnOcLKBNwLs4gxzH6EeEMGKBqj0etFIs-w8glDF93KAqWN3ix4MIfak60A-JNJvh4GFyarkCeHCr6IRNUpDnUGQrTZVQoJ9xE/w1200/perro-senior-hero-cama-ortopedica-1200x675.webp",
              "width": 1200,
              "height": 675
            },
            "hasPart": [
              { "@id": "https://www.cuidatuperroviejo.com/#faq" },
              { "@id": "https://www.cuidatuperroviejo.com/#cluster" }
            ],
            "inLanguage": "es"
          },
          {
            "@type": "BreadcrumbList",
            "@id": "https://www.cuidatuperroviejo.com/#breadcrumb",
            "itemListElement": [
              { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.cuidatuperroviejo.com/" }
            ]
          },
          {
            "@type": "BlogPosting",
            "@id": "https://www.cuidatuperroviejo.com/#article",
            "headline": "Guía completa para cuidar a tu perro senior",
            "description": "Empieza aquí: guía para cuidar a tu perro senior con salud, alimentación, movilidad, higiene y bienestar emocional. Consejos claros y fáciles.",
            "image": [
              "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgL1bwXO4TGe9u8VLw1VvD9AzfngIkDvfms2g9m7HHQhGb9gNxH6iPGq7o3xd2am92yEynp4NWKA9ZUHb6HwVUL0_CGtnpnOcLKBNwLs4gxzH6EeEMGKBqj0etFIs-w8glDF93KAqWN3ix4MIfak60A-JNJvh4GFyarkCeHCr6IRNUpDnUGQrTZVQoJ9xE/w1200/perro-senior-hero-cama-ortopedica-1200x675.webp"
            ],
            "mainEntityOfPage": { "@id": "https://www.cuidatuperroviejo.com/" },
            "datePublished": "2025-10-01T00:00:00-06:00",
            "dateModified": "2025-10-01T00:00:00-06:00",
            "author": {
              "@type": "Organization",
              "name": "Cuida tu perro viejo",
              "url": "https://www.cuidatuperroviejo.com/"
            },
            "publisher": {
              "@type": "Organization",
              "name": "Cuida tu perro viejo",
              "url": "https://www.cuidatuperroviejo.com/"
            },
            "inLanguage": "es"
          },
          {
            "@type": "FAQPage",
            "@id": "https://www.cuidatuperroviejo.com/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "¿A qué edad se considera senior un perro según su tamaño?",
                "acceptedAnswer": { "@type": "Answer", "text": "Pequeños/medianos ~7–8 años; grandes/giantes ~5–6 años (orientativo; personalizar por individuo)." }
              },
              {
                "@type": "Question",
                "name": "¿Cuánto debe caminar un perro mayor al día?",
                "acceptedAnswer": { "@type": "Answer", "text": "Paseos cortos y frecuentes de bajo impacto; ajusta por dolor, clima y recuperación." }
              },
              {
                "@type": "Question",
                "name": "¿Qué comida es mejor para perros senior y cuánta proteína?",
                "acceptedAnswer": { "@type": "Answer", "text": "Dieta equilibrada acorde a condición corporal y comorbilidades; prioriza proteína de calidad salvo indicación contraria." }
              },
              {
                "@type": "Question",
                "name": "¿Cómo saber si mi perro tiene dolor de articulaciones?",
                "acceptedAnswer": { "@type": "Answer", "text": "Rigidez al levantarse, dificultad para subir/bajar, intolerancia al ejercicio y cambios de conducta." }
              },
              {
                "@type": "Question",
                "name": "¿Cómo adaptar mi casa para un perro mayor con movilidad reducida?",
                "acceptedAnswer": { "@type": "Answer", "text": "Alfombras antideslizantes, rampas, cama ortopédica, cuencos elevados y zonas de descanso tranquilas." }
              },
              {
                "@type": "Question",
                "name": "¿Cuándo ir a urgencias con un perro anciano?",
                "acceptedAnswer": { "@type": "Answer", "text": "Ante dificultad respiratoria, colapso, dolor intenso, vómitos persistentes, anorexia prolongada o convulsiones." }
              }
            ],
            "inLanguage": "es"
          },
          {
            "@type": "ItemList",
            "@id": "https://www.cuidatuperroviejo.com/#cluster",
            "name": "Explora por tema (pilares secundarios)",
            "itemListOrder": "https://schema.org/ItemListOrderAscending",
            "numberOfItems": 6,
            "itemListElement": [
              { "@type": "ListItem", "position": 1,
                "item": { "@type": "WebPage", "name": "Salud en perros mayores", "url": "https://www.cuidatuperroviejo.com/salud-perros-mayores" } },
              { "@type": "ListItem", "position": 2,
                "item": { "@type": "WebPage", "name": "Alimentación del perro senior", "url": "https://www.cuidatuperroviejo.com/alimentacion-perros-senior" } },
              { "@type": "ListItem", "position": 3,
                "item": { "@type": "WebPage", "name": "Movilidad y dolor", "url": "https://www.cuidatuperroviejo.com/movilidad-dolor-perros-mayores" } },
              { "@type": "ListItem", "position": 4,
                "item": { "@type": "WebPage", "name": "Salud mental y emociones", "url": "https://www.cuidatuperroviejo.com/salud-mental-emocional-perros" } },
              { "@type": "ListItem", "position": 5,
                "item": { "@type": "WebPage", "name": "Higiene y hogar", "url": "https://www.cuidatuperroviejo.com/higiene-hogar-perros-senior" } },
              { "@type": "ListItem", "position": 6,
                "item": { "@type": "WebPage", "name": "Cuidados paliativos", "url": "https://www.cuidatuperroviejo.com/cuidados-paliativos-perros" } }
            ],
            "inLanguage": "es"
          }
        ]
      }
    </script>
  </slot>

  <main class="w-full">
    <!-- HERO SECTION -->
    <section class="max-w-5xl mx-auto px-5 md:px-4 py-12 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center">
        <!-- Hero Text -->
        <div class="md:col-span-7 flex flex-col items-start text-left">
          <span class="text-xs font-extrabold tracking-widest uppercase text-brand-primary mb-3 flex items-center gap-1.5">
            <span class="animate-pulse">🐾</span> Cuidado Amoroso y Profesional
          </span>
          <h1 class="text-3xl md:text-5xl font-semibold tracking-tight text-brand-text mb-6 leading-tight">
            El bienestar de tu compañero senior empieza aquí
          </h1>
          <p class="text-base md:text-lg text-brand-muted mb-8 leading-relaxed font-light">
            Aprende a identificar sus necesidades cambiantes, adaptar tu hogar y brindarle una vida plena, activa y libre de dolor durante sus valiosos años dorados.
          </p>
          <div class="flex flex-wrap gap-4 w-full sm:w-auto">
            <a href="#pilares" class="w-full sm:w-auto text-center px-6 py-3.5 rounded-xl bg-brand-primary hover:bg-brand-primary-hover text-white text-sm font-semibold transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5 transform">
              Explorar por tema
            </a>
            <a href="#calculadora" class="w-full sm:w-auto text-center px-6 py-3.5 rounded-xl border border-brand-primary/30 text-brand-primary hover:bg-brand-primary/5 text-sm font-semibold transition-all duration-200">
              Calcular Edad Canina
            </a>
            <a href="#guia-inicio" class="w-full sm:w-auto text-center px-6 py-3.5 rounded-xl bg-brand-secondary/35 text-brand-primary hover:bg-brand-secondary/50 text-sm font-semibold transition-all duration-200">
              Guía de Inicio
            </a>
          </div>
        </div>
        <!-- Hero Image -->
        <div class="md:col-span-5 relative">
          <!-- Decorative frame behind image -->
          <div class="absolute -inset-2 bg-brand-secondary/40 rounded-3xl -rotate-1 scale-[1.01] -z-10 border border-brand-primary/10"></div>
          <div class="overflow-hidden rounded-2xl shadow-lg bg-brand-secondary/20">
            <img 
              alt="Perro senior descansando cómodamente en una cama ortopédica premium" 
              decoding="async" 
              height="675" 
              loading="eager" 
              fetchpriority="high"
              src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgL1bwXO4TGe9u8VLw1VvD9AzfngIkDvfms2g9m7HHQhGb9gNxH6iPGq7o3xd2am92yEynp4NWKA9ZUHb6HwVUL0_CGtnpnOcLKBNwLs4gxzH6EeEMGKBqj0etFIs-w8glDF93KAqWN3ix4MIfak60A-JNJvh4GFyarkCeHCr6IRNUpDnUGQrTZVQoJ9xE/w1200/perro-senior-hero-cama-ortopedica-1200x675.webp" 
              srcset="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgL1bwXO4TGe9u8VLw1VvD9AzfngIkDvfms2g9m7HHQhGb9gNxH6iPGq7o3xd2am92yEynp4NWKA9ZUHb6HwVUL0_CGtnpnOcLKBNwLs4gxzH6EeEMGKBqj0etFIs-w8glDF93KAqWN3ix4MIfak60A-JNJvh4GFyarkCeHCr6IRNUpDnUGQrTZVQoJ9xE/w400/perro-senior-hero-cama-ortopedica-1200x675.webp 400w,
                      https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgL1bwXO4TGe9u8VLw1VvD9AzfngIkDvfms2g9m7HHQhGb9gNxH6iPGq7o3xd2am92yEynp4NWKA9ZUHb6HwVUL0_CGtnpnOcLKBNwLs4gxzH6EeEMGKBqj0etFIs-w8glDF93KAqWN3ix4MIfak60A-JNJvh4GFyarkCeHCr6IRNUpDnUGQrTZVQoJ9xE/w600/perro-senior-hero-cama-ortopedica-1200x675.webp 600w,
                      https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgL1bwXO4TGe9u8VLw1VvD9AzfngIkDvfms2g9m7HHQhGb9gNxH6iPGq7o3xd2am92yEynp4NWKA9ZUHb6HwVUL0_CGtnpnOcLKBNwLs4gxzH6EeEMGKBqj0etFIs-w8glDF93KAqWN3ix4MIfak60A-JNJvh4GFyarkCeHCr6IRNUpDnUGQrTZVQoJ9xE/w800/perro-senior-hero-cama-ortopedica-1200x675.webp 800w,
                      https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgL1bwXO4TGe9u8VLw1VvD9AzfngIkDvfms2g9m7HHQhGb9gNxH6iPGq7o3xd2am92yEynp4NWKA9ZUHb6HwVUL0_CGtnpnOcLKBNwLs4gxzH6EeEMGKBqj0etFIs-w8glDF93KAqWN3ix4MIfak60A-JNJvh4GFyarkCeHCr6IRNUpDnUGQrTZVQoJ9xE/w1200/perro-senior-hero-cama-ortopedica-1200x675.webp 1200w"
              sizes="(max-width: 768px) 100vw, 450px"
              width="1200" 
              class="object-cover w-full h-auto"
            />
          </div>
          <p class="text-[11px] text-center text-brand-muted mt-2.5 font-light italic">
            Pequeños ajustes mejoran la calidad de vida de un <a href="https://www.google.com/search?q=senior+dog" target="_blank" class="text-brand-accent hover:underline font-normal">perro senior</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- INTRODUCTORY TESTIMONIAL BLOCK -->
    <section class="bg-brand-card/45 border-y border-brand-border py-10 px-5 md:px-0 reveal-on-scroll">
      <div class="max-w-4xl mx-auto text-center">
        <blockquote class="italic text-base md:text-lg text-brand-text leading-relaxed font-light">
          "Un <a href="https://www.google.com/search?q=senior+dog+preventive+checkup" target="_blank" class="text-brand-accent hover:underline font-normal">chequeo preventivo</a> y pequeños ajustes en la rutina y el hogar mejoran de forma notable la calidad de vida de un perro senior."
        </blockquote>
      </div>
    </section>

    <!-- INTERACTIVE AGE CALCULATOR WIDGET -->
    <section id="calculadora" class="max-w-4xl mx-auto px-5 py-16 md:py-24 reveal-on-scroll">
      <div class="bg-brand-card border border-brand-border rounded-3xl p-6 md:p-10 shadow-md">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-6">
            <span class="text-xs font-bold tracking-wider uppercase text-brand-primary mb-2 block">Herramienta Interactiva</span>
            <h2 class="text-2.5xl md:text-3.5xl font-semibold text-brand-text mb-4">Calculadora de Edad Senior</h2>
            <p class="text-sm text-brand-muted font-light leading-relaxed mb-6">
              Los perros envejecen a ritmos diferentes según su tamaño. Calcula la edad equivalente en años humanos de tu mascota y obtén recomendaciones veterinarias específicas para su etapa.
            </p>
            
            <div class="space-y-4">
              <div>
                <label for="dog-size" class="block text-xs font-bold text-brand-text uppercase mb-1.5">Tamaño de tu perro</label>
                <select id="dog-size" class="w-full bg-brand-bg text-brand-text border border-brand-border rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-primary">
                  <option value="small">Pequeño (Menos de 10 kg)</option>
                  <option value="medium">Mediano (10 a 25 kg)</option>
                  <option value="large">Grande (25 a 40 kg)</option>
                  <option value="giant">Gigante (Más de 40 kg)</option>
                </select>
              </div>
              
              <div>
                <label for="dog-age" class="block text-xs font-bold text-brand-text uppercase mb-1.5">Edad cronológica (Años)</label>
                <select id="dog-age" class="w-full bg-brand-bg text-brand-text border border-brand-border rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-primary">
                  {Array.from({ length: 20 }, (_, i) => i + 1).map(year => (
                    <option value={year} selected={year === 8}>{year} {year === 1 ? 'año' : 'años'}</option>
                  ))}
                </select>
              </div>
            </div>
          </div>
          
          <div class="md:col-span-6 flex flex-col justify-center">
            <div id="calc-result-card" class="bg-brand-bg/60 border border-brand-border rounded-2xl p-6 text-center shadow-sm relative overflow-hidden">
              <div class="absolute -top-10 -right-10 w-24 h-24 bg-brand-primary/10 rounded-full blur-xl"></div>
              
              <p class="text-xs font-bold text-brand-muted uppercase tracking-wider mb-1">Edad Humana Equivalente</p>
              <div id="human-age-result" class="text-4xl md:text-5xl font-extrabold text-brand-primary my-3">
                -- años
              </div>
              
              <div class="border-t border-brand-border/60 my-4 pt-4 text-left">
                <span id="rec-title" class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-brand-secondary text-brand-primary uppercase tracking-wider mb-2">
                  Cargando...
                </span>
                <p id="rec-text" class="text-xs text-brand-text leading-relaxed font-light">
                  Selecciona la edad y el tamaño para ver el plan recomendado.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CATEGORIES HUB ("EXPLORA POR TEMA") -->
    <section id="pilares" class="bg-brand-card/25 border-y border-brand-border py-16 md:py-24 reveal-on-scroll">
      <div class="max-w-5xl mx-auto px-5 md:px-4">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-bold tracking-wider uppercase text-brand-primary mb-2 block">Categorías principales</span>
          <h2 class="text-2.5xl md:text-3.5xl font-semibold text-brand-text mb-4">
            Explora por tema
          </h2>
          <p class="text-sm text-brand-muted font-light leading-relaxed">
            Accede a nuestras guías especializadas diseñadas para abordar los pilares clave del cuidado del perro anciano.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
          <!-- Tarjeta 1: Salud -->
          <a href="/salud-perros-mayores" class="group block border border-brand-border rounded-2xl p-6 bg-brand-card hover:shadow-md hover:border-brand-primary/45 hover:scale-[1.01] transition-all duration-300 focus-visible:outline-2 focus-visible:outline-brand-primary" aria-label="Salud en perros mayores: chequeos, señales de alerta y prevención">
            <div class="flex flex-col gap-4">
              <span class="w-12 h-12 rounded-xl flex items-center justify-center bg-brand-secondary text-brand-primary group-hover:scale-110 transition-transform duration-300" aria-hidden="true">
                <svg class="w-6 h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><path d="M6 3v6a4 4 0 0 0 8 0V3M6 9a6 6 0 1 0 12 0v4a4 4 0 0 1-4 4h-1"/><circle cx="19" cy="17" r="2"/></svg>
              </span>
              <div>
                <h3 class="text-lg font-bold text-brand-text group-hover:text-brand-accent transition-colors mb-2">Salud en perros mayores</h3>
                <p class="text-xs text-brand-muted leading-relaxed font-light">Chequeos, señales de alerta y prevención básica.</p>
              </div>
            </div>
          </a>

          <!-- Tarjeta 2: Alimentación -->
          <a href="/alimentacion-perros-senior" class="group block border border-brand-border rounded-2xl p-6 bg-brand-card hover:shadow-md hover:border-brand-primary/45 hover:scale-[1.01] transition-all duration-300 focus-visible:outline-2 focus-visible:outline-brand-primary" aria-label="Alimentación del perro senior: porciones, horarios y menús equilibrados">
            <div class="flex flex-col gap-4">
              <span class="w-12 h-12 rounded-xl flex items-center justify-center bg-brand-secondary text-brand-primary group-hover:scale-110 transition-transform duration-300" aria-hidden="true">
                <svg class="w-6 h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><path d="M3 13h18l-1 5H4l-1-5Z"/><path d="M7 13a5 5 0 0 1 10 0"/></svg>
              </span>
              <div>
                <h3 class="text-lg font-bold text-brand-text group-hover:text-brand-accent transition-colors mb-2">Alimentación del perro senior</h3>
                <p class="text-xs text-brand-muted leading-relaxed font-light">Porciones, horarios y menús equilibrados.</p>
              </div>
            </div>
          </a>

          <!-- Tarjeta 3: Movilidad -->
          <div class="group relative border border-brand-border rounded-2xl p-6 bg-brand-card hover:shadow-md hover:border-brand-primary/45 hover:scale-[1.01] transition-all duration-300 focus-within:ring-2 focus-within:ring-brand-primary/50" aria-label="Movilidad y dolor">
            <div class="flex flex-col gap-4 h-full justify-between">
              <!-- Enlace principal al pilar -->
              <a href="/movilidad-dolor-perros-mayores" class="focus:outline-none block" aria-label="Ir al pilar de movilidad y dolor en perros mayores">
                <!-- Capa absoluta para hacer clicable toda la tarjeta excepto elementos con z-10 -->
                <span class="absolute inset-0 rounded-2xl z-0" aria-hidden="true"></span>
                
                <div class="flex flex-col gap-4 relative z-10">
                  <span class="w-12 h-12 rounded-xl flex items-center justify-center bg-brand-secondary text-brand-primary group-hover:scale-110 transition-transform duration-300" aria-hidden="true">
                    <svg class="w-6 h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><path d="M12 14c-3 0-5 2-5 4 0 1.5 1.5 3 5 3s5-1.5 5-3c0-2-2-4-5-4Z"/><circle cx="5.5" cy="9" r="2"/><circle cx="9.5" cy="6" r="2"/><circle cx="14.5" cy="6" r="2"/><circle cx="18.5" cy="9" r="2"/></svg>
                  </span>
                  <div>
                    <h3 class="text-lg font-bold text-brand-text group-hover:text-brand-accent transition-colors mb-2">Movilidad y dolor</h3>
                    <p class="text-xs text-brand-muted leading-relaxed font-light">Ejercicios suaves, ayudas ortopédicas y ajustes en casa.</p>
                  </div>
                </div>
              </a>
              
              <!-- Enlace secundario al test de movilidad -->
              <div class="relative z-10 mt-2">
                <a href="/herramientas/selector-movilidad-perros-mayores" class="inline-flex items-center gap-1 text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline" aria-label="Iniciar test de selector de ayudas de movilidad">
                  <span>⚙️ Encontrar ayuda exacta (Test 30s)</span>
                  <svg class="w-3 h-3 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Tarjeta 4: Salud Mental -->
          <a href="/salud-mental-emocional-perros" class="group block border border-brand-border rounded-2xl p-6 bg-brand-card hover:shadow-md hover:border-brand-primary/45 hover:scale-[1.01] transition-all duration-300 focus-visible:outline-2 focus-visible:outline-brand-primary" aria-label="Salud mental y emociones: DCC, rutinas, juegos de olfato y sueño reparador">
