        <script>
          (() => {
            // Calcula la clave de semana ISO: "checklist-YYYY-Www"
            function getWeekKey() {
              const now = new Date();
              const jan4 = new Date(now.getFullYear(), 0, 4);
              const startOfWeek1 = new Date(jan4);
              startOfWeek1.setDate(jan4.getDate() - ((jan4.getDay() + 6) % 7));
              const diff = now.getTime() - startOfWeek1.getTime();
              const week = Math.floor(diff / (7 * 24 * 60 * 60 * 1000)) + 1;
              return `checklist-${now.getFullYear()}-W${String(week).padStart(2, '0')}`;
            }

            const STORAGE_KEY = getWeekKey();
            const items = document.querySelectorAll('.checklist-item');
            const countEl = document.getElementById('checklist-count');
            const barEl = document.getElementById('checklist-bar');
            const resetBtn = document.getElementById('checklist-reset');
            const total = items.length;

            // Carga estado guardado de esta semana
            const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');

            function updateUI() {
              const checked = Array.from(items).filter(i => i.checked).length;
              if (countEl) countEl.textContent = `${checked} / ${total}`;
              if (barEl) barEl.style.width = `${Math.round((checked / total) * 100)}%`;
              if (resetBtn) resetBtn.classList.toggle('hidden', checked === 0);
            }

            // Restaurar estado
            items.forEach(item => {
              const key = item.dataset.key;
              if (key && saved[key]) item.checked = true;
              item.addEventListener('change', () => {
                const k = item.dataset.key;
                if (!k) return;
                const state = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
                state[k] = item.checked;
                localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
                updateUI();
              });
            });

            // Botón de reset
            resetBtn?.addEventListener('click', () => {
              localStorage.removeItem(STORAGE_KEY);
              items.forEach(i => { i.checked = false; });
              updateUI();
            });

            // Limpia claves de semanas anteriores (housekeeping)
            Object.keys(localStorage)
              .filter(k => k.startsWith('checklist-') && k !== STORAGE_KEY)
              .forEach(k => localStorage.removeItem(k));

            updateUI();
          })();
        </script>

