---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Obtener los últimos 3 artículos de blog ordenados (o simplemente los primeros 3)
const blogEntries = await getCollection('blog');
const recentPosts = blogEntries.slice(0, 3);
---

<BaseLayout 
  title="Guía completa para cuidar a tu perro senior"
  description="Empieza aquí: guía para cuidar a tu perro senior con salud, alimentación, movilidad, higiene y bienestar emocional. Consejos claros y fáciles."
>
  <slot name="head" slot="head">
    <script type="application/ld+json">
