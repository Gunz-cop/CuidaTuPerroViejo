import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import EmergencyGeoWidget from '../components/EmergencyGeoWidget.astro';

// Obtener los últimos 3 artículos de blog ordenados por fecha de publicación (más recientes primero)
const blogEntries = await getCollection('blog', ({ data }) => {
  return data.status === 'Publicado' || !data.status; // Asegurarse de traer solo publicados
});

// Ordenar por fecha publicada. Si no está definida, asumimos una fecha muy antigua o fecha de metadata
const recentPosts = blogEntries
  .sort((a, b) => {
    const getPostDate = (post) => {
      if (post.data.datePublished) {
        return new Date(post.data.datePublished);
      }
      if (post.slug === 'prevencion-caidas-perro-mayor') {
        return new Date('2026-06-01');
      }
      if (post.data.legacyUrl) {
        const match = post.data.legacyUrl.match(/\/(\d{4})\/(\d{2})\//);
        if (match) {
          return new Date(match[0]);
        }
      }
      return new Date('2025-01-01');
    };

    const dateA = getPostDate(a);
    const dateB = getPostDate(b);
    
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 3);

const faqItems = [
  {
    question: "¿A qué edad se considera senior un perro según su tamaño?",
    answer: "Con carácter general, los perros de razas pequeñas y medianas se consideran senior a los 7 u 8 años; los perros de razas grandes y gigantes a los 5 o 6 años. Siempre debe individualizarse según el estado fisiológico de cada animal."
  },
  {
    question: "¿Cuánto debe caminar un perro mayor al día?",
    answer: "Es preferible estructurar paseos cortos y frecuentes de bajo impacto. El tiempo total y ritmo debe ajustarse permanentemente en función de si presenta dolores articulares, fatiga ante temperaturas extremas y su tiempo de recuperación."
  },
  {
    question: "¿Qué comida es mejor para perros senior y cuánta proteína?",
    answer: "Requieren una dieta equilibrada que controle la densidad de calorías para evitar el sobrepeso. Se debe dar prioridad a fuentes de proteínas de alta digestibilidad para preservar masa muscular, salvo indicación veterinaria contraria."
  },
  {
    question: "¿Cómo saber si mi perro tiene dolor de articulaciones?",
    answer: "Las señales habituales son rigidez al levantarse de descansar, dificultad para subir o bajar de muebles, rechazo o intolerancia al ejercicio habitual, apatía o cambios repentinos en su comportamiento (irritabilidad o aislamiento)."
  },
  {
    question: "¿Cómo adaptar mi casa para un perro mayor con movilidad reducida?",
    answer: "Colocando alfombras en zonas de suelos resbaladizos, instalando rampas para salvar pequeños desniveles, proporcionando una cama ortopédica confortable, situando cuencos ligeramente elevados y manteniendo zonas tranquilas para su descanso."
  },
  {
    question: "¿Cuándo ir a urgencias con un perro anciano?",
    answer: "Acude de forma inmediata si presenta respiración fatigosa o acelerada en reposo, pérdida de conocimiento o colapso, dolor agudo, vómitos repetidos, anorexia total de más de 24 horas o episodios convulsivos."
  }
];
