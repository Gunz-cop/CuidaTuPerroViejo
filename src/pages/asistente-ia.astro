---
import BaseLayout from '../layouts/BaseLayout.astro';
import AssistantChat from '../components/AssistantChat.astro';

const title = 'Asistente para cuidar a tu perro mayor | Cuida tu Perro Viejo';
const description = 'Cuéntanos qué le ocurre a tu perro senior y recibe orientación inicial junto con las guías más relevantes de nuestro sitio.';
---

<BaseLayout title={title} description={description} showAiAssistant={false}>
  <script slot="head" type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Asistente de bienestar para perros mayores",
      "url": "https://cuidatuperroviejo.com/asistente-ia",
      "description": "Orientación inicial y recomendaciones de lectura sobre el bienestar de perros mayores.",
      "applicationCategory": "HealthApplication",
      "operatingSystem": "All",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Cuida tu Perro Viejo",
        "url": "https://cuidatuperroviejo.com/"
      }
    }
  </script>

  <main tabindex="-1" id="main-content" class="mx-auto w-full max-w-3xl flex-1 px-4 pb-14 pt-6 sm:px-6 sm:pb-20 sm:pt-10">
    <header>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.12em] text-brand-primary">Asistente con IA · Basado en nuestras guías</p>
      <h1 class="font-display text-3xl font-extrabold leading-[1.08] tracking-[-0.035em] text-brand-text sm:text-5xl">
        Cuéntanos qué le pasa a tu perro mayor
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-brand-muted sm:text-lg">
        Describe lo que has notado y desde cuándo. El asistente consulta las guías del sitio, te responde con detalle y te indica cuáles leer. Puedes seguir preguntando sobre la misma conversación.
      </p>
    </header>

    <section class="assistant-page-panel mt-7 flex flex-col overflow-hidden rounded-[1.5rem] border border-brand-border bg-brand-bg shadow-[0_18px_50px_rgba(25,50,32,0.08)] dark:shadow-[0_20px_55px_rgba(0,0,0,0.25)] sm:mt-9" aria-labelledby="assistant-title">
      <div class="flex items-center justify-between gap-3 border-b border-brand-border bg-brand-card px-4 py-3 sm:px-5">
        <h2 id="assistant-title" class="font-display text-lg font-bold tracking-tight text-brand-text">Tu conversación</h2>
        <button type="button" data-ac-reset class="inline-flex min-h-11 items-center gap-2 rounded-xl px-3 text-sm font-bold text-brand-primary transition-colors hover:bg-brand-primary/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          Conversación nueva
        </button>
      </div>
      <AssistantChat surface="page" inputId="assistant-question" />
    </section>

    <aside class="mt-5 flex items-start gap-3 rounded-2xl border border-amber-500/25 bg-amber-500/10 px-4 py-3.5 text-sm leading-6 text-brand-text" aria-label="Aviso veterinario">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-700 dark:text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
      <p><strong>Esto no es un diagnóstico ni sustituye una consulta veterinaria.</strong> El asistente usa inteligencia artificial y puede equivocarse. Si hay dificultad para respirar, colapso, convulsiones, sangrado abundante o dolor intenso, contacta a un veterinario de urgencia.</p>
    </aside>
  </main>
</BaseLayout>

<style>
  /* El panel tiene altura propia para que la conversación se desplace dentro
     de él y el redactor quede siempre a la vista. */
  .assistant-page-panel {
    height: clamp(30rem, 72dvh, 46rem);
  }
</style>
