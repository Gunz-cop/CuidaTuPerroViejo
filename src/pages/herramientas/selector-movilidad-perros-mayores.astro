---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Selector de Ayudas de Movilidad para Perros Mayores | Test Interactivo";
const description = "Selector interactivo que recomienda la ayuda de movilidad exacta (calcetines, arnés, rampa, silla de ruedas) según el nivel de movilidad real y temperamento de tu perro mayor.";
---

<BaseLayout title={title} description={description}>
  <!-- Head injection using slots -->
  <script slot="head" type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://cuidatuperroviejo.com/#org",
        "name": "Cuida tu perro viejo",
        "url": "https://cuidatuperroviejo.com/",
        "logo": {
          "@type": "ImageObject",
          "url": "/images/home/calculadora-calidad-vida-hero.webp"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://cuidatuperroviejo.com/#website",
        "url": "https://cuidatuperroviejo.com/",
        "name": "Cuida tu perro viejo",
        "publisher": { "@id": "https://cuidatuperroviejo.com/#org" },
        "inLanguage": "es"
      },
      {
        "@type": "WebPage",
        "@id": "https://cuidatuperroviejo.com/herramientas/selector-movilidad-perros-mayores",
        "url": "https://cuidatuperroviejo.com/herramientas/selector-movilidad-perros-mayores",
        "name": "Selector de Ayudas de Movilidad para Perros Mayores | Test Interactivo",
        "description": "Selector interactivo que recomienda la ayuda de movilidad exacta (calcetines, arnés, rampa, silla de ruedas) según el nivel de movilidad real y temperamento de tu perro mayor.",
        "isPartOf": { "@id": "https://cuidatuperroviejo.com/#website" },
        "about": { "@id": "https://cuidatuperroviejo.com/movilidad-dolor-perros-mayores" },
        "breadcrumb": { "@id": "https://cuidatuperroviejo.com/herramientas/selector-movilidad-perros-mayores#breadcrumb" },
        "mainEntity": { "@id": "https://cuidatuperroviejo.com/herramientas/selector-movilidad-perros-mayores#selector" },
        "lastReviewed": "2026-05-14",
        "inLanguage": "es"
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://cuidatuperroviejo.com/herramientas/selector-movilidad-perros-mayores#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio",    "item": "https://cuidatuperroviejo.com/" },
          { "@type": "ListItem", "position": 2, "name": "Movilidad", "item": "https://cuidatuperroviejo.com/movilidad-dolor-perros-mayores" },
          { "@type": "ListItem", "position": 3, "name": "Selector de Movilidad", "item": "https://cuidatuperroviejo.com/herramientas/selector-movilidad-perros-mayores" }
        ]
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://cuidatuperroviejo.com/herramientas/selector-movilidad-perros-mayores#selector",
        "name": "Selector de Ayudas de Movilidad para Perros Mayores",
        "operatingSystem": "Web",
        "applicationCategory": "HealthApplication",
        "offers": { "@type": "Offer", "price": 0, "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
        "description": "Herramienta interactiva gratuita que recomienda ayudas de movilidad canina (calcetines, arnés, rampa, silla de ruedas, cama ortopédica) según el nivel de movilidad del perro mayor y su temperamento.",
        "softwareVersion": "1.0"
      },
      {
        "@type": "FAQPage",
        "@id": "https://cuidatuperroviejo.com/herramientas/selector-movilidad-perros-mayores#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Cómo saber si mi perro necesita silla de ruedas?",
            "acceptedAnswer": { "@type": "Answer", "text": "Está indicada cuando el perro ha perdido la función motora en sus patas traseras pero conserva buen estado general, apetito y voluntad de moverse. Consulta con tu veterinario antes: las medidas deben ser exactas." }
          },
          {
            "@type": "Question",
            "name": "¿Rampa o escalera adaptada?",
            "acceptedAnswer": { "@type": "Answer", "text": "La rampa es mejor para perros con displasia de cadera o dolor articular. Las escaleras adaptadas son más compactas y sirven para debilidad leve. Si cojea al bajar escaleras normales, empieza con rampa." }
          },
          {
            "@type": "Question",
            "name": "¿Por qué la cama ortopédica es vital?",
            "acceptedAnswer": { "@type": "Answer", "text": "Los perros mayores pasan hasta 18 horas tumbados. Una superficie dura genera callosidades y úlceras de decúbito. El memory foam distribuye el peso y facilita que el perro se levante solo." }
          },
          {
            "@type": "Question",
            "name": "¿El arnés de soporte trasero se puede usar todo el día?",
            "acceptedAnswer": { "@type": "Answer", "text": "No. Lo ideal son sesiones de 20-30 minutos para caminar, seguidas de descanso sin arnés. Revisa diariamente las zonas de contacto para evitar rozaduras." }
          }
        ]
      }
    ]
  }
  </script>

  <main class="max-w-3xl mx-auto px-5 py-6 sm:py-10 md:py-16 content-body">
    <!-- Header/Metadata -->
    <header class="mb-5 sm:mb-8">
      <div class="mb-3 sm:mb-4">
        <a href="/" class="inline-flex items-center text-sm text-brand-primary hover:text-brand-primary-hover font-semibold gap-1 no-underline transition-colors back-btn">
          <span>← Volver al inicio</span>
        </a>
      </div>

      <figure class="rounded-3xl overflow-hidden shadow-lg border border-brand-border/40 mb-4 sm:mb-6">
        <img
          alt="Mujer ayudando a un perro senior con debilidad en las patas traseras a caminar dentro de casa usando un arnés de soporte de movilidad"
          src="/images/home/selector-movilidad-perro.webp"
          width="1200"
          height="525"
          loading="eager"
          decoding="async"
          title="Selector de ayudas de movilidad para perros ancianos"
          class="w-full object-cover aspect-[16/7]"
        />
      </figure>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-brand-muted border-b border-brand-border pb-4 mb-5 sm:pb-6 sm:mb-8 font-light">
        <span>Por <strong>Equipo de Cuida a tu perro viejo</strong></span>
        <span class="text-brand-border">•</span>
        <span>Actualizado el <strong>14 de mayo de 2026</strong></span>
      </div>
    </header>

    <!-- Table of Contents -->
    <nav class="mb-5 sm:mb-8" aria-label="Tabla de contenidos">
      <details class="group bg-brand-card/30 dark:bg-slate-900/15 border border-brand-border/40 rounded-2xl p-4 transition-all duration-300">
        <summary class="flex justify-between items-center font-semibold text-brand-text cursor-pointer list-none select-none">
          <span>Contenido de esta página</span>
          <span class="text-brand-primary text-xl transition-transform duration-300 group-open:rotate-45">+</span>
        </summary>
        <ul class="mt-4 space-y-2 text-sm pl-4 list-disc text-brand-muted border-t border-brand-border/40 pt-4">
          <li><a href="#cm5-selector" class="hover:text-brand-accent transition-colors no-underline">Selector interactivo de movilidad</a></li>
          <li><a href="#cm5-faq" class="hover:text-brand-accent transition-colors no-underline">Preguntas frecuentes</a></li>
          <li><a href="#cm5-seo" class="hover:text-brand-accent transition-colors no-underline">La movilidad es autonomía emocional</a></li>
          <li><a href="#cm5-refs" class="hover:text-brand-accent transition-colors no-underline">Referencias médicas</a></li>
        </ul>
      </details>
    </nav>

    <!-- Empathetic Introduction -->
    <section class="mb-5 sm:mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold font-serif text-brand-text mb-3 sm:mb-4 leading-tight">
        Cuidar a un perro que ya no se mueve bien <span class="text-brand-primary block md:inline">es un acto de amor enorme. Hay ayudas concretas.</span>
      </h2>
      <p class="text-base sm:text-lg text-brand-muted leading-relaxed">
        Si estás aquí es porque ves a tu compañero luchar y quieres hacer algo <em>ahora</em>. Este selector te da una recomendación exacta según su nivel de movilidad actual.
      </p>
    </section>

    <!-- Interactive App Selector Container -->
    <div id="cm5-selector" class="scroll-mt-20"></div>
    <div id="m5widget" aria-label="Selector de ayudas de movilidad para perros mayores" class="scroll-mt-20 bg-brand-card/50 dark:bg-slate-900/30 border border-brand-border/60 rounded-3xl p-6 md:p-10 shadow-sm mb-12 h-calc-container" role="region">

      <!-- PANTALLA 0: Intro -->
      <div class="text-center" id="m5s0">
        <div aria-hidden="true" class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-brand-secondary/50 dark:bg-slate-800/50 text-4xl mb-5 select-none">🦴</div>
        <span class="inline-block text-[11px] font-bold tracking-widest uppercase text-brand-primary mb-2">Test • 2 preguntas • 30 segundos</span>
        <h3 class="text-2xl md:text-3xl font-extrabold text-brand-text mb-4 font-serif leading-tight">Encontremos la ayuda exacta para tu perro</h3>
        <p class="text-brand-muted text-sm max-w-lg mx-auto leading-relaxed mb-6">
          Responde según cómo está hoy. Al final recibes un plan de acción claro y, si lo necesita, orientación sobre cuidados paliativos.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-2 mb-8">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-green-500/10 text-green-700 dark:text-green-300"><span aria-hidden="true">🐾</span> Ligero</span>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-300"><span aria-hidden="true">🚶</span> Moderado</span>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-red-500/10 text-red-700 dark:text-red-300"><span aria-hidden="true">🛏️</span> Severo</span>
        </div>
        <button class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold bg-brand-primary text-white hover:bg-brand-primary-hover active:bg-brand-primary-hover active:scale-[0.98] shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-150 cursor-pointer" id="m5start" type="button">
          Empezar ahora →
        </button>
      </div>

      <!-- PANTALLA 1: Nivel de movilidad -->
      <div class="off" id="m5s1">
        <div class="flex items-center gap-4 mb-8">
          <button class="px-3 py-1.5 rounded-full bg-brand-card/70 hover:bg-brand-card-hover active:bg-brand-card-hover active:scale-95 text-brand-text text-xs font-semibold transition-all duration-150 cursor-pointer border border-brand-border/40" id="m5b1" type="button">← Volver</button>
          <div aria-valuemax="2" aria-valuemin="0" aria-valuenow="1" class="flex-1 h-2 bg-brand-border/40 rounded-full overflow-hidden" role="progressbar">
            <div class="h-full bg-brand-primary rounded-full transition-all duration-300" id="m5pb1"></div>
          </div>
          <span aria-label="Paso 1 de 2" class="text-xs font-bold text-brand-primary whitespace-nowrap">1 / 2</span>
        </div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-primary mb-2" id="m5lb1"></p>
        <p class="text-xl md:text-2xl font-bold text-brand-text font-serif mb-6 leading-tight" id="m5qt1"></p>
        <div class="flex flex-col gap-3" id="m5oo1"></div>
      </div>

      <!-- PANTALLA 2: Carácter -->
      <div class="off" id="m5s2">
        <div class="flex items-center gap-4 mb-8">
          <button class="px-3 py-1.5 rounded-full bg-brand-card/70 hover:bg-brand-card-hover active:bg-brand-card-hover active:scale-95 text-brand-text text-xs font-semibold transition-all duration-150 cursor-pointer border border-brand-border/40" id="m5b2" type="button">← Volver</button>
          <div aria-valuemax="2" aria-valuemin="0" aria-valuenow="2" class="flex-1 h-2 bg-brand-border/40 rounded-full overflow-hidden" role="progressbar">
            <div class="h-full bg-brand-primary rounded-full transition-all duration-300" id="m5pb2"></div>
          </div>
          <span aria-label="Paso 2 de 2" class="text-xs font-bold text-brand-primary whitespace-nowrap">2 / 2</span>
        </div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-primary mb-2" id="m5lb2"></p>
        <p class="text-xl md:text-2xl font-bold text-brand-text font-serif mb-6 leading-tight" id="m5qt2"></p>
        <div class="flex flex-col gap-3" id="m5oo2"></div>
      </div>

      <!-- PANTALLA 3: Resultado -->
      <div class="off" id="m5s3">
        <!-- Alerta paliativa (visible solo nivel S) -->
        <div class="off bg-red-500/10 dark:bg-red-950/20 border-l-4 border-l-red-600 rounded-r-2xl rounded-l-md p-5 my-6" id="m5alert" role="alert">
          <div class="text-xs font-extrabold tracking-widest uppercase text-red-600 dark:text-red-400 mb-3 flex items-center gap-1.5">
            <span>⚠️</span> Cuidado paliativo importante
          </div>
          <ul class="space-y-3 pl-0 list-none text-brand-text text-sm font-light">
            <li class="relative pl-6 leading-relaxed">
              <span class="absolute left-0 text-red-600 dark:text-red-400">⚠️</span>
              Para la higiene: considera <strong>pañales caninos</strong> y <strong>empapadores absorbentes</strong> bajo su zona de descanso. Cámbialos con frecuencia para evitar dermatitis.
            </li>
            <li class="relative pl-6 leading-relaxed">
              <span class="absolute left-0 text-red-600 dark:text-red-400">⚠️</span>
              <strong>Cambia su posición cada 4 horas</strong> si no puede moverse solo, para prevenir úlceras de decúbito.
              <a href="/cuidados-paliativos-perros/ulceras-presion-perros" rel="noopener" target="_blank" class="text-brand-primary hover:underline font-bold block mt-1">Cómo hacerlo sin causarle dolor →</a>
            </li>
            <li class="relative pl-6 leading-relaxed">
              <span class="absolute left-0 text-red-600 dark:text-red-400">⚠️</span>
              Evalúa si hay <strong>dolor controlado</strong> con nuestra
              <a href="/herramientas/calculadora-calidad-vida-perros" rel="noopener" target="_blank" class="text-brand-primary hover:underline font-bold block mt-1">Calculadora HHHHHMM →</a>
            </li>
          </ul>
        </div>

        <!-- Hero del resultado -->
        <div class="text-center pb-6 mb-6 border-b border-brand-border/40">
          <div aria-hidden="true" class="inline-flex items-center justify-center w-16 h-16 rounded-2xl text-3xl mb-3" id="m5ricowrap">
            <span id="m5rico"></span>
          </div>
          <div class="inline-block text-xs font-bold tracking-wider uppercase px-3 py-1 rounded-full mb-3" id="m5rbadge"></div>
          <h3 class="text-2xl font-bold font-serif text-brand-text mb-2" id="m5rtit" itemprop="name"></h3>
          <p class="text-base text-brand-muted leading-relaxed max-w-lg mx-auto" id="m5rdesc"></p>
        </div>

        <!-- Plan de acción -->
        <div class="mb-8">
          <h4 class="text-xs font-bold tracking-widest uppercase text-brand-primary mb-4 flex items-center gap-2">
            <span aria-hidden="true">🧭</span> Tu plan de acción
          </h4>
          <div class="flex flex-col gap-3" id="m5prods"></div>
        </div>

        <!-- CTA a la guía -->
        <div class="mb-8 text-center">
          <a href="/movilidad-dolor-perros-mayores" class="inline-block w-full sm:w-auto font-semibold rounded-xl px-5 py-3 transition-all border border-brand-primary text-brand-primary hover:bg-brand-primary/5 text-center no-underline text-sm">
            📖 Leer la guía completa de movilidad y dolor →
          </a>
        </div>

        <!-- Acciones (en móvil, WhatsApp y Repetir viven en la barra fija de abajo) -->
        <div class="flex flex-col sm:flex-row gap-3 border-t border-brand-border/40 pt-6">
          <button class="w-full sm:w-auto flex-1 py-3.5 px-6 rounded-xl font-semibold border border-brand-primary text-brand-primary hover:bg-brand-primary/5 active:bg-brand-primary/10 active:scale-[0.98] text-sm transition-all duration-150 cursor-pointer text-center" id="m5copy" type="button">
            📋 Copiar resultado
          </button>
          <button class="hidden sm:flex sm:w-auto flex-1 items-center justify-center py-3.5 px-6 rounded-xl font-semibold bg-brand-primary hover:bg-brand-primary-hover active:bg-brand-primary-hover active:scale-[0.98] text-white text-sm transition-all duration-150 cursor-pointer text-center" id="m5wa" type="button">
            📲 Enviar por WhatsApp
          </button>
          <button class="hidden sm:flex sm:w-auto items-center justify-center py-3.5 px-6 rounded-xl font-semibold border border-brand-border hover:bg-brand-card-hover active:bg-brand-card-hover active:scale-[0.98] text-brand-text text-sm transition-all duration-150 cursor-pointer text-center" id="m5rst" type="button">
            ↻ Repetir
          </button>
        </div>
        <p aria-live="polite" id="m5copyok" class="text-sm font-semibold text-green-600 text-center mt-3" style="display:none;">
          ¡Copiado! Ahora pégalo donde quieras.
        </p>
        <p class="text-xs text-brand-muted/70 text-center italic mt-4 max-w-md mx-auto leading-relaxed">
          Esta recomendación es una guía de apoyo. Ante dudas, consulta siempre a tu veterinario.
        </p>

        <!-- Espaciador para que la barra fija de móvil no tape el contenido -->
        <div class="h-24 sm:h-0" aria-hidden="true"></div>
      </div>

    </div><!--/.m5card-->

    <!-- Barra de acciones fija (solo móvil, solo mientras se ve el resultado) -->
    <div id="m5stickybar" class="off sm:hidden fixed bottom-0 inset-x-0 z-40 border-t border-brand-border bg-brand-bg/95 backdrop-blur-md px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-4px_16px_rgba(0,0,0,0.08)]">
      <div class="flex items-center gap-3">
        <button class="shrink-0 flex items-center justify-center w-12 h-12 rounded-full border border-brand-border text-brand-text text-lg active:bg-brand-card-hover active:scale-95 transition-all duration-150 cursor-pointer" id="m5rstFixed" type="button" aria-label="Repetir el test">
          ↻
        </button>
        <button class="flex-1 flex items-center justify-center gap-2 h-12 rounded-full font-semibold bg-brand-primary text-white text-sm active:bg-brand-primary-hover active:scale-[0.98] transition-all duration-150 cursor-pointer" id="m5waFixed" type="button">
          📲 Enviar por WhatsApp
        </button>
      </div>
    </div>

    <!-- FAQs -->
    <div id="cm5-faq" class="scroll-mt-20"></div>
    <section class="faq-section mt-12 border-t border-brand-border pt-10" aria-labelledby="faq-heading-sel">
      <div class="mb-6 flex items-center gap-3">
        <div class="h-px flex-1 bg-brand-border/60"></div>
        <h3 id="faq-heading-sel" class="text-xs font-bold tracking-widest uppercase text-brand-primary whitespace-nowrap">Preguntas frecuentes</h3>
        <div class="h-px flex-1 bg-brand-border/60"></div>
      </div>

      <div class="space-y-3">
        <details class="group bg-brand-card/40 dark:bg-slate-900/15 border border-brand-border/50 rounded-2xl overflow-hidden transition-colors duration-200 hover:border-brand-primary/35 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-semibold text-sm text-brand-text">
            <span>¿Cómo saber si mi perro necesita silla de ruedas?</span>
            <span class="shrink-0 text-brand-primary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
            </span>
          </summary>
          <div class="border-t border-brand-border/40 px-5 py-4 text-sm leading-relaxed text-brand-muted">
            Una silla de ruedas canina está indicada cuando el perro ha perdido la función motora en sus patas traseras pero conserva buen estado general, apetito y voluntad de moverse. Signos claros: arrastra las patas traseras sin corregirse, no puede levantarse ni con ayuda, pero sigue queriendo explorar y sigue comiendo bien. Consulta con tu veterinario antes de comprar: las medidas deben ser exactas para que no cause rozaduras.
          </div>
        </details>

        <details class="group bg-brand-card/40 dark:bg-slate-900/15 border border-brand-border/50 rounded-2xl overflow-hidden transition-colors duration-200 hover:border-brand-primary/35 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-semibold text-sm text-brand-text">
            <span>¿Rampa o escalera adaptada? ¿Cuál es mejor?</span>
            <span class="shrink-0 text-brand-primary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
            </span>
          </summary>
          <div class="border-t border-brand-border/40 px-5 py-4 text-sm leading-relaxed text-brand-muted">
            Depende del peso y del problema articular. <strong>La rampa</strong> es mejor para perros con displasia de cadera o dolor en las articulaciones: la inclinación gradual reduce el estrés en la cadera al subir al sofá o al coche. <strong>Las escaleras adaptadas</strong> ocupan menos espacio y son buenas para perros con debilidad leve que aún pueden doblar las rodillas sin dolor. Regla práctica: si cojea al bajar escaleras normales, empieza con rampa.
          </div>
        </details>

        <details class="group bg-brand-card/40 dark:bg-slate-900/15 border border-brand-border/50 rounded-2xl overflow-hidden transition-colors duration-200 hover:border-brand-primary/35 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-semibold text-sm text-brand-text">
            <span>¿Por qué la cama ortopédica es vital para un perro mayor?</span>
            <span class="shrink-0 text-brand-primary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
            </span>
          </summary>
          <div class="border-t border-brand-border/40 px-5 py-4 text-sm leading-relaxed text-brand-muted">
            Los perros mayores con movilidad reducida pasan hasta 18 horas tumbados. Una superficie dura concentra la presión en los puntos de contacto (codos, caderas, costillas), lo que genera callosidades, úlceras de decúbito y dolor crónico. Las camas de <strong>memory foam ortopédico</strong> distribuyen el peso uniformemente, mantienen el calor y facilitan que el perro se levante solo. Una cama ortopédica no es un lujo: es prevención activa del dolor.
          </div>
        </details>

        <details class="group bg-brand-card/40 dark:bg-slate-900/15 border border-brand-border/50 rounded-2xl overflow-hidden transition-colors duration-200 hover:border-brand-primary/35 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-semibold text-sm text-brand-text">
            <span>¿El arnés de soporte trasero se puede usar todo el día?</span>
            <span class="shrink-0 text-brand-primary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
            </span>
          </summary>
          <div class="border-t border-brand-border/40 px-5 py-4 text-sm leading-relaxed text-brand-muted">
            No se recomienda un uso continuo. Lo ideal son sesiones de 20–30 minutos para caminar y hacer necesidades, seguidas de descanso sin arnés para evitar rozaduras e irritación en la piel. Revisa diariamente las zonas de contacto (ingles, axilas traseras) y asegúrate de que no esté ni muy apretado ni tan suelto que no sostenga.
          </div>
        </details>
      </div>
