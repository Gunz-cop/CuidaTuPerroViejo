---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdBanner300x250 from '../../components/ads/AdBanner300x250.astro';
import AdSlotLoader from '../../components/ads/AdSlotLoader.astro';

const title = "Calculadora de Calidad de Vida Canina (Escala HHHHHMM) | Test Interactivo";
const description = "Registra siete observaciones de tu perro con una adaptación de HHHHHMM. Conserva el desglose y prepara la consulta veterinaria; la suma no diagnostica bienestar.";
---

<BaseLayout title={title} description={description}>
  <!-- Head injection using slots -->
  <script slot="head" type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://cuidatuperroviejo.com/#org",
        "name": "Cuida tu perro viejo",
        "url": "https://cuidatuperroviejo.com/",
        "logo": {
          "@type": "ImageObject",
          "url": "/images/home/calculadora-calidad-vida-hero.webp"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://cuidatuperroviejo.com/#website",
        "url": "https://cuidatuperroviejo.com/",
        "name": "Cuida tu perro viejo",
        "publisher": { "@id": "https://cuidatuperroviejo.com/#org" },
        "inLanguage": "es"
      },
      {
        "@type": "WebPage",
        "@id": "https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros",
        "url": "https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros",
        "name": "Calculadora de Calidad de Vida Canina (Escala HHHHHMM) | Test Interactivo",
        "description": "Registra siete observaciones de tu perro con una adaptación de HHHHHMM. Conserva el desglose y prepara la consulta veterinaria; la suma no diagnostica bienestar.",
        "isPartOf": { "@id": "https://cuidatuperroviejo.com/#website" },
        "about": { "@id": "https://cuidatuperroviejo.com/cuidados-paliativos-perros" },
        "breadcrumb": { "@id": "https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros#breadcrumb" },
        "mainEntity": { "@id": "https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros#calculator" },
        "lastReviewed": "2026-10-17",
        "inLanguage": "es"
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio",              "item": "https://cuidatuperroviejo.com/" },
          { "@type": "ListItem", "position": 2, "name": "Herramientas", "item": "https://cuidatuperroviejo.com/herramientas" },
          { "@type": "ListItem", "position": 3, "name": "Calculadora HHHHHMM","item": "https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros" }
        ]
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros#calculator",
        "name": "Calculadora de Calidad de Vida Canina HHHHHMM",
        "operatingSystem": "Web",
        "applicationCategory": "HealthApplication",
        "isPartOf": {
          "@type": "WebPage",
          "@id": "https://cuidatuperroviejo.com/cuidados-paliativos-perros"
        },
        "offers": {
          "@type": "Offer",
          "price": 0,
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        },
        "description": "Herramienta interactiva gratuita para calcular el puntaje HHHHHMM de calidad de vida en perros mayores, adaptada de HHHHHMM de Alice Villalobos; sin clasificación clínica por el total.",
        "softwareVersion": "3.0"
      },
      {
        "@type": "FAQPage",
        "@id": "https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Cuál es un puntaje aceptable en la escala HHHHHMM?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Esta adaptación no clasifica el bienestar por el total. Registra siete observaciones de 0 a 10 y destaca por separado las respuestas en 0. Una suma alta no compensa dolor u otra dificultad y no sustituye la valoración veterinaria."
            }
          }
        ]
      }
    ]
  }
  </script>

  <main id="main-content" tabindex="-1" class="max-w-3xl mx-auto px-5 py-6 sm:py-10 md:py-16 content-body">
    <!-- Header of the article -->
    <header class="mb-5 sm:mb-8">
      <div class="mb-3 sm:mb-4">
        <a href="/" class="inline-flex items-center text-sm text-brand-primary hover:text-brand-primary-hover font-semibold gap-1 no-underline transition-colors back-btn">
          <span>← Volver al inicio</span>
        </a>
      </div>

      <figure class="rounded-3xl overflow-hidden shadow-lg border border-brand-border/40 mb-4 sm:mb-6">
        <img
          alt="Mujer abrazando a su perro anciano en casa durante cuidados paliativos, momento tranquilo que refleja calidad de vida y bienestar en perros senior"
          src="/images/home/calculadora-hhhhhmm-perro.webp"
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
          title="Cuidados paliativos en perros: evaluar calidad de vida con amor y calma"
          class="w-full object-cover aspect-video"
        />
      </figure>

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-brand-text mb-4 sm:mb-6 leading-tight font-serif">
        Calculadora de Calidad de Vida Canina (Escala HHHHHMM)
      </h1>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-brand-muted border-b border-brand-border pb-4 mb-5 sm:pb-6 sm:mb-8 font-light">
        <span>Por <strong>Cuida tu Perro Viejo</strong></span>
        <span class="text-brand-border">•</span>
        <span>Actualizado el <strong>17 de octubre de 2026</strong></span>
      </div>
    </header>

    <!-- Table of Contents -->
    <nav class="mb-5 sm:mb-8" aria-label="Tabla de contenidos">
      <details class="group bg-brand-card/30 dark:bg-slate-900/15 border border-brand-border/40 rounded-2xl p-4 transition-all duration-300">
        <summary class="flex justify-between items-center font-semibold text-brand-text cursor-pointer list-none select-none">
          <span>Contenido de esta página</span>
          <span class="text-brand-primary text-xl transition-transform duration-300 group-open:rotate-45">+</span>
        </summary>
        <ul class="mt-4 space-y-2 text-sm pl-4 list-disc text-brand-muted border-t border-brand-border/40 pt-4">
          <li><a href="#cvc-calc" class="hover:text-brand-accent transition-colors no-underline">Calculadora interactiva HHHHHMM</a></li>
          <li><a href="#criterios" class="hover:text-brand-accent transition-colors no-underline">Qué significan los 7 criterios</a></li>
          <li><a href="#cvc-faq" class="hover:text-brand-accent transition-colors no-underline">Preguntas frecuentes</a></li>
          <li><a href="#metodo">Método y límites de la adaptación</a></li>
          <li><a href="#cvc-refs" class="hover:text-brand-accent transition-colors no-underline">Referencias médicas</a></li>
        </ul>
      </details>
    </nav>

    <div id="intro-text" class="text-lg text-brand-muted leading-relaxed mb-5 sm:mb-8">
      <p>Registra cómo está tu perro en siete áreas y lleva el desglose a la consulta. Esta <strong>adaptación digital de HHHHHMM</strong>, escala desarrollada por Alice Villalobos, conserva la suma de 0 a 70, pero no la convierte en un diagnóstico ni en una decisión sobre el final de vida.</p>
      <p>Si ahora tiene dolor intenso o dificultad para respirar, busca atención veterinaria inmediata; no esperes a completar la herramienta.</p>
    </div>

    <!-- Banner PDF -->
    <div class="flex items-center gap-4 bg-brand-primary/10 border border-brand-primary/20 rounded-2xl p-5 my-6 sm:my-8 callout">
      <div class="text-3xl text-brand-primary">📄</div>
      <div class="text-sm">
        <strong class="text-brand-text font-bold block mb-1">¿Prefieres papel para la consulta veterinaria?</strong>
        <p>Copia en una libreta la fecha y tus observaciones de dolor, apetito, hidratación, higiene, ánimo, movilidad y días buenos o malos. Al completar la herramienta puedes usar «Guardar PDF» para abrir la impresión del navegador.</p>
      </div>
    </div>

    <!-- CALCULADORA INTERACTIVA -->
    <div id="cvc-calc" class="scroll-mt-20"></div>
    <div id="qol-widget" aria-label="Calculadora interactiva de calidad de vida HHHHHMM" class="scroll-mt-20 bg-brand-card/50 dark:bg-slate-900/30 border border-brand-border/60 rounded-3xl p-6 md:p-10 shadow-sm mb-10 sm:mb-12 qol-container" role="region">

      <!-- PANTALLA 0: Intro -->
      <div class="text-center" id="qol-intro">
        <div aria-hidden="true" class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-brand-secondary/50 dark:bg-slate-800/50 text-4xl mb-5 select-none">🩺</div>
        <span class="inline-block text-[11px] font-bold tracking-widest uppercase text-brand-primary mb-2">Registro • 7 preguntas</span>
        <h3 class="text-2xl md:text-3xl font-extrabold text-brand-text mb-4 font-serif leading-tight">Registra cómo está tu perro</h3>
        <p class="text-brand-muted text-sm max-w-lg mx-auto leading-relaxed mb-2">
          Responde según el <strong>periodo que estás observando</strong> y anota cuándo fue. Al final verás la suma, el desglose y los avisos; no es un diagnóstico.
        </p>
        <p class="text-sm text-brand-muted mb-8 mt-4">Siete observaciones de 0 a 10. Las advertencias se muestran por separado: ninguna suma garantiza bienestar.</p>
        <button class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold bg-brand-primary text-white hover:bg-brand-primary-hover active:bg-brand-primary-hover active:scale-[0.98] shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-150 cursor-pointer" id="qol-start" type="button">
          Empezar ahora →
        </button>
      </div>

      <!-- PANTALLA 1..7: Pregunta (contenido reutilizado dinámicamente) -->
      <div class="off" id="qol-question">
        <div class="flex items-center gap-4 mb-8">
          <button class="px-3 py-1.5 rounded-full bg-brand-card/70 hover:bg-brand-card-hover active:bg-brand-card-hover active:scale-95 text-brand-text text-xs font-semibold transition-all duration-150 cursor-pointer border border-brand-border/40" id="qol-back" type="button">← Volver</button>
          <div aria-label="Progreso del test" class="flex-1 h-2 bg-brand-border/40 rounded-full overflow-hidden" id="qol-progress-wrap" role="progressbar" aria-valuemin="1" aria-valuemax="7" aria-valuenow="1">
            <div class="h-full bg-brand-primary rounded-full transition-all duration-300" id="qol-progress-bar"></div>
          </div>
          <span class="text-xs font-bold text-brand-primary whitespace-nowrap" id="qol-step-label">1 / 7</span>
        </div>

        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl" aria-hidden="true" id="qol-q-emoji"></span>
          <p class="text-xs font-bold tracking-widest uppercase text-brand-primary" id="qol-q-name"></p>
        </div>
        <p class="text-xl md:text-2xl font-bold text-brand-text font-serif mb-6 leading-tight" id="qol-q-text"></p>

        <div class="flex items-center justify-between text-xs text-brand-muted font-semibold mb-2 px-0.5">
          <span id="qol-q-help-lo"></span>
          <span id="qol-q-help-hi"></span>
        </div>
        <div class="grid grid-cols-4 sm:grid-cols-11 gap-2 sm:gap-3" id="qol-q-chips" role="radiogroup"></div>
      </div>

      <!-- PANTALLA 8: Resultado -->
      <div class="off" id="qol-result" role="status" aria-live="polite" aria-atomic="true">
        <div class="p-6 md:p-8 rounded-2xl border text-center transition-all duration-300 shadow-sm my-2 sm:my-4" id="qol-result-box">
          <span class="text-xs font-semibold tracking-wider uppercase text-brand-muted">Puntaje Total (Mín 0 – Máx 70)</span>
          <span class="block text-5xl font-extrabold my-3 font-['Outfit']" id="qol-result-score">35</span>

          <div class="font-semibold text-lg" id="qol-interpretation">—</div>
          <p class="mt-2 text-sm italic opacity-90" id="qol-human-msg"></p>

          <!-- PROGRESS BAR -->
          <div aria-label="Puntuación registrada; no indica un porcentaje de bienestar" aria-valuemax="70" aria-valuemin="0" aria-valuenow="35" class="qol-progress-wrap mt-4" id="qol-result-progress" role="progressbar">
            <div class="h-2.5 bg-brand-border/40 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all duration-500 bg-brand-primary" id="qol-result-fill" style="width:50%"></div>
            </div>
          </div>
          <p class="mt-4 text-xs font-light">Esta herramienta ordena observaciones y no sustituye una valoración veterinaria.</p>
        </div>

        <section class="my-5 rounded-2xl border border-amber-500/40 p-5" aria-labelledby="qol-warnings-title">
          <h3 id="qol-warnings-title" class="font-bold">Advertencias independientes del total</h3>
          <p class="text-xs mt-2">Destacar las respuestas en 0 es una adaptación propia; no es un umbral clínico validado. La ausencia de estos avisos no garantiza bienestar.</p>
          <ul id="qol-warnings" class="mt-3 space-y-3"></ul>
        </section>
        <!-- RECOMENDACIÓN DINÁMICA -->
        <div class="bg-blue-500/10 border border-blue-500/20 text-brand-text text-sm rounded-2xl p-5 my-6 leading-relaxed shadow-sm" id="qol-recommendation"></div>

        <!-- DESGLOSE POR CRITERIO -->
        <div class="mb-6">
          <h4 class="text-xs font-bold tracking-widest uppercase text-brand-primary mb-3 flex items-center gap-2">
            <span aria-hidden="true">📋</span> Desglose por criterio
          </h4>
          <div class="bg-brand-bg/60 dark:bg-brand-bg/25 border border-brand-border/30 rounded-2xl px-4" id="qol-breakdown"></div>
        </div>

        <!-- CTA PILAR -->
        <div class="qol-cta-pilar my-6 text-center" id="qol-cta-pilar" style="display:none">
          <a href="/cuidados-paliativos-perros" class="inline-block w-full sm:w-auto font-semibold rounded-xl px-5 py-3 transition-all border border-brand-primary text-brand-primary hover:bg-brand-primary/5 text-center no-underline">
            📖 Entender mejor los cuidados paliativos y las opciones disponibles
          </a>
        </div>

        <p class="qol-anti-guilt text-xs text-brand-muted text-center italic mt-4 max-w-md mx-auto leading-relaxed">
          Una suma alta no descarta dolor ni enfermedad. Si observas dificultad respiratoria o dolor intenso, busca atención veterinaria inmediata.
        </p>

        <!-- ACCIONES (en móvil, WhatsApp y Repetir viven en la barra fija de abajo) -->
        <div class="qol-actions flex flex-wrap gap-3 justify-center mt-8 border-t border-brand-border/40 pt-8">
          <button class="w-full sm:w-auto font-semibold rounded-xl px-5 py-3 transition-all bg-brand-primary hover:bg-brand-primary-hover active:scale-[0.98] text-white text-center shadow-sm flex items-center justify-center gap-2 cursor-pointer" id="qol-copy" type="button">
            📋 Copiar resultado
          </button>
          <button class="hidden sm:flex sm:w-auto font-semibold rounded-xl px-5 py-3 transition-all border border-brand-primary text-brand-primary hover:bg-brand-primary/5 active:scale-[0.98] text-center items-center justify-center gap-2 cursor-pointer" id="qol-wa" type="button">
            📲 Enviar por WhatsApp
          </button>
          <button class="w-full sm:w-auto font-semibold rounded-xl px-5 py-3 transition-all border border-brand-primary text-brand-primary hover:bg-brand-primary/5 active:scale-[0.98] text-center flex items-center justify-center gap-2 cursor-pointer" id="qol-ics" type="button">
            📅 Recordatorio opcional: 3 días
          </button>
          <button class="w-full sm:w-auto font-semibold rounded-xl px-5 py-3 transition-all border border-brand-primary text-brand-primary hover:bg-brand-primary/5 active:scale-[0.98] text-center flex items-center justify-center gap-2 cursor-pointer" id="qol-print" type="button">
            🖨️ Guardar PDF
          </button>
          <button class="hidden sm:flex sm:w-auto font-semibold rounded-xl px-5 py-3 transition-all border border-brand-border text-brand-muted hover:bg-brand-card-hover active:scale-[0.98] text-center items-center justify-center gap-2 cursor-pointer" id="qol-reset" type="button">
            🔄 Reiniciar
          </button>
        </div>

        <p aria-live="polite" id="qol-copy-confirm" class="text-sm font-semibold text-green-600 text-center mt-3" style="display:none;">
          ¡Copiado! Ahora pégalo donde quieras.
        </p>

        <!-- Espaciador para que la barra fija de móvil no tape el contenido -->
        <div class="h-24 sm:h-0" aria-hidden="true"></div>
      </div>

    </div><!--/.qol-container-->

    <AdBanner300x250 />

    <!-- Barra de acciones fija (solo móvil, solo mientras se ve el resultado) -->
    <div id="qol-stickybar" class="off sm:hidden fixed bottom-0 inset-x-0 z-40 border-t border-brand-border bg-brand-bg/95 backdrop-blur-md [-webkit-backdrop-filter:blur(12px)] px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-4px_16px_rgba(0,0,0,0.08)]">
      <div class="flex items-center gap-3">
        <button class="shrink-0 flex items-center justify-center w-12 h-12 rounded-full border border-brand-border text-brand-text text-lg active:bg-brand-card-hover active:scale-95 transition-all duration-150 cursor-pointer" id="qol-reset-fixed" type="button" aria-label="Repetir el test">
          ↻
        </button>
        <button class="flex-1 flex items-center justify-center gap-2 h-12 rounded-full font-semibold bg-brand-primary text-white text-sm active:bg-brand-primary-hover active:scale-[0.98] transition-all duration-150 cursor-pointer" id="qol-wa-fixed" type="button">
          📲 Enviar por WhatsApp
        </button>
      </div>
    </div>

    <!-- DETALLES DE LOS CRITERIOS -->
    <div class="mt-10 sm:mt-12 border-t border-brand-border pt-8 sm:pt-10">
      <h3 id="criterios" class="scroll-mt-20 text-2xl font-bold text-brand-primary mb-6 font-serif">
        ¿Qué significan los criterios de la escala HHHHHMM?
      </h3>
      <p class="text-brand-muted mb-6 leading-relaxed">
        La Dra. Alice Villalobos diseñó esta escala para ayudar a los cuidadores y veterinarios a registrar observaciones de la vida diaria del animal para comentarlas en consulta:
      </p>

      <ul class="space-y-4 text-brand-muted leading-relaxed list-none pl-0">
        <li class="flex items-start gap-3">
          <span class="text-xl">❤️</span>
          <div>
            <strong class="text-brand-text">Hurt (Dolor):</strong>{' '}
            ¿Tiene un control adecuado del dolor y puede respirar con facilidad? El dolor no controlado es el principal factor de sufrimiento.
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-xl">🍖</span>
          <div>
            <strong class="text-brand-text">Hunger (Hambre):</strong>{' '}
            ¿Come suficiente por su cuenta o necesita asistencia/sonda? La falta de apetito sostenida compromete la energía del perro.
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-xl">💧</span>
          <div>
            <strong class="text-brand-text">Hydration (Hidratación):</strong>{' '}
            ¿Bebe suficiente o muestra cambios que deban valorarse en consulta? La necesidad de fluidoterapia la determina el veterinario.
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-xl">✨</span>
          <div>
            <strong class="text-brand-text">Hygiene (Higiene):</strong>{' '}
            ¿Se le puede mantener limpio y cepillado? ¿Tiene llagas por decúbito? La incontinencia o falta de aseo afecta su dignidad y salud cutánea.
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-xl">🐕</span>
          <div>
            <strong class="text-brand-text">Happiness (Felicidad):</strong>{' '}
            ¿Muestra alegría, interés en la familia, responde a caricias o juguetes? ¿Sigue experimentando pequeños placeres?
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-xl">🐾</span>
          <div>
            <strong class="text-brand-text">Mobility (Movilidad):</strong>{' '}
            ¿Puede levantarse y caminar solo, o necesita ayuda/carrito? ¿Tiene deseos de moverse a pesar de sus limitaciones físicas?
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-xl">☀️</span>
          <div>
            <strong class="text-brand-text">More Good Days (Más días buenos):</strong>{' '}
            Cuando hay más días malos que días buenos (donde domina el dolor o la inactividad), el balance indica que su bienestar general está muy comprometido.
          </div>
        </li>
      </ul>
    </div>

    <!-- PREGUNTAS FRECUENTES -->
    <div id="cvc-faq" class="scroll-mt-20"></div>
    <section class="faq-section mt-10 sm:mt-12 border-t border-brand-border pt-8 sm:pt-10" aria-labelledby="faq-heading-calc">
      <div class="mb-6 flex items-center gap-3">
        <div class="h-px flex-1 bg-brand-border/60"></div>
        <h3 id="faq-heading-calc" class="text-xs font-bold tracking-widest uppercase text-brand-primary whitespace-nowrap">Preguntas frecuentes</h3>
        <div class="h-px flex-1 bg-brand-border/60"></div>
      </div>

      <div class="space-y-3">
        <details class="group bg-brand-card/40 dark:bg-slate-900/15 border border-brand-border/50 rounded-2xl overflow-hidden transition-colors duration-200 hover:border-brand-primary/35 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-semibold text-sm text-brand-text">
            <span>¿Cuál es un puntaje "aceptable" en la escala?</span>
            <span class="shrink-0 text-brand-primary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
            </span>
          </summary>
          <div class="border-t border-brand-border/40 px-5 py-4 text-sm leading-relaxed text-brand-muted">
            Esta adaptación no asigna categorías clínicas al total. El documento HHHHHMM de referencia propone valorar cada área y la situación individual; aquí conservamos la suma y mostramos cada criterio por separado. Una respuesta crítica no queda compensada por las demás. Consulta el método y comparte tus observaciones con el veterinario.
          </div>
        </details>

        <details class="group bg-brand-card/40 dark:bg-slate-900/15 border border-brand-border/50 rounded-2xl overflow-hidden transition-colors duration-200 hover:border-brand-primary/35 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-semibold text-sm text-brand-text">
            <span>¿Con qué frecuencia debo evaluar a mi perro?</span>
            <span class="shrink-0 text-brand-primary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
            </span>
          </summary>
          <div class="border-t border-brand-border/40 px-5 py-4 text-sm leading-relaxed text-brand-muted">
            Acuerda la frecuencia con tu veterinario según su estado. Anota la fecha, las circunstancias y los cambios para comparar registros. Un deterioro brusco requiere consulta sin esperar al siguiente registro. El recordatorio opcional de tres días es una función de agenda, no un intervalo clínico recomendado; no ajustes medicación por tu cuenta.
          </div>
        </details>

        <details class="group bg-brand-card/40 dark:bg-slate-900/15 border border-brand-border/50 rounded-2xl overflow-hidden transition-colors duration-200 hover:border-brand-primary/35 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-semibold text-sm text-brand-text">
            <span>¿Qué debo hacer si el puntaje es bajo?</span>
            <span class="shrink-0 text-brand-primary transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
            </span>
          </summary>
          <div class="border-t border-brand-border/40 px-5 py-4 text-sm leading-relaxed text-brand-muted">
            Describe al veterinario qué áreas han empeorado y desde cuándo, con independencia de la suma. Esta herramienta no determina sufrimiento, pronóstico ni decisiones sobre eutanasia. Si observas dificultad para respirar o dolor intenso, busca atención inmediata.
          </div>
        </details>
      </div>
    </section>

    <section id="metodo" class="mt-10 border-t border-brand-border pt-6">
      <h2 class="text-2xl font-bold">Método y límites de esta adaptación</h2>
      <p>La <a href="https://www.speakingforspot.com/PDF/VillalobosDVM_QualityOfLifeScale.pdf" target="_blank" rel="noopener">explicación de HHHHHMM de Alice Villalobos (PDF)</a> describe siete áreas de 1 a 10 y subraya la valoración individual de cada animal. La prioridad que da al control del dolor incluye poder respirar correctamente. No utilizamos bandas clínicas ni cortes en 35 o 50 para interpretar la suma.</p>
      <p>Son adaptaciones propias ampliar la respuesta hasta 0 para registrar el extremo negativo, la suma mostrada de 0 a 70, la traducción y simplificación de preguntas, la interacción paso a paso y destacar cualquier respuesta en 0 con un aviso separado. Esta regla muestra extremos negativos declarados: no ha sido validada como detector clínico y no cambia la suma. Las puntuaciones intermedias también pueden reflejar problemas que requieren consulta.</p>
      <p>El registro y sus cambios sirven para conversar con el veterinario. La impresión y el texto para compartir incluyen desglose, límites y advertencias. El estudio de Testoni y colaboradores analiza una versión italiana y no valida esta implementación web ni sus avisos.</p>
    </section>
    <!-- REFERENCIAS -->
    <div id="cvc-refs" class="scroll-mt-20"></div>
    <footer class="mt-10 sm:mt-12 border-t border-brand-border pt-6 text-xs text-brand-muted leading-relaxed">
      <p class="mb-0">
        <strong>Referencias médicas:</strong>{' '}
        <a href="https://www.speakingforspot.com/PDF/VillalobosDVM_QualityOfLifeScale.pdf" rel="nofollow noopener" target="_blank" class="text-brand-primary hover:underline">Alice Villalobos — Quality of Life Scale Helps Make Final Call (PDF)</a>{' '}
        ·{' '}
        <a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10044252/" rel="nofollow noopener" target="_blank" class="text-brand-primary hover:underline">Testoni et al. (2023): estudio de una versión italiana de HHHHHMM</a>
      </p>
    </footer>
  </main>
  <AdSlotLoader />
</BaseLayout>

<style>
  /* Blogger-safe utility: off toggles display */
  .off {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) { .qolanim { animation: none !important; } }

  /* Fade-in animation */
  @keyframes qolin {
    from {
      opacity: 0;
      transform: translateY(7px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .qolanim {
    animation: qolin 0.26s ease forwards;
  }

  /* Mientras se ve el resultado en móvil, ocultamos el botón flotante del
     asistente IA para que no choque con la barra de acciones fija de abajo. */
  @media (max-width: 639px) {
    :global(body.qol-result-active #ai-chat-toggle) {
      display: none !important;
    }
  }

  @media print {
    /* Ocultar elementos innecesarios */
    .qol-actions,
    .qol-cta-pilar,
    #qol-copy-confirm,
    .qol-anti-guilt,
    #qol-stickybar,
    nav,
    footer,
    .callout,
    .toc,
    #intro-text,
    .back-btn {
      display: none !important;
    }

    body {
      background: white !important;
      color: black !important;
    }

    #qol-widget {
      margin: 0 !important;
      padding: 0 !important;
    }

    .qol-container {
      box-shadow: none !important;
      border: 1px solid #ccc !important;
      background: white !important;
      color: black !important;
      padding: 1.5rem !important;
    }

    #qol-result-score {
      color: #000 !important;
      font-size: 3rem !important;
    }

    #qol-result-box {
      border: 2px solid #000 !important;
      background: #fff !important;
      color: #000 !important;
      box-shadow: none !important;
    }
  }
</style>

<script>
// @ts-nocheck -- script de UI legado, sin tipos; la lógica tipada vive en src/lib/agent-tools/.
import { CRITERIA, MAX_SCORE, evaluateQualityOfLife } from '../../lib/agent-tools/calidad-vida.ts';

(function () {
  'use strict';

  /* ── Los 7 criterios y la fórmula viven en src/lib/agent-tools/calidad-vida.ts ── */
  /* (compartidos con la API y WebMCP; mismos textos y umbrales). */

  /* ── Estado ── */
  var answers = new Array(CRITERIA.length).fill(null);
  var currentIndex = 0;
  var lastScore = null;
  var lastResult = null;

  /* ── DOM (cacheado en init) ── */
  var D = {};

  function init() {
    D.intro     = document.getElementById('qol-intro');
    D.question  = document.getElementById('qol-question');
    D.result    = document.getElementById('qol-result');
    D.start     = document.getElementById('qol-start');
    D.back      = document.getElementById('qol-back');
    D.progWrap  = document.getElementById('qol-progress-wrap');
    D.progBar   = document.getElementById('qol-progress-bar');
    D.stepLabel = document.getElementById('qol-step-label');
    D.qEmoji    = document.getElementById('qol-q-emoji');
    D.qName     = document.getElementById('qol-q-name');
    D.qText     = document.getElementById('qol-q-text');
    D.qHelpLo   = document.getElementById('qol-q-help-lo');
    D.qHelpHi   = document.getElementById('qol-q-help-hi');
    D.qChips    = document.getElementById('qol-q-chips');
    D.resultBox = document.getElementById('qol-result-box');
    D.score     = document.getElementById('qol-result-score');
    D.interp    = document.getElementById('qol-interpretation');
    D.humanMsg  = document.getElementById('qol-human-msg');
    D.resultProg= document.getElementById('qol-result-progress');
    D.resultFill= document.getElementById('qol-result-fill');
    D.recBox    = document.getElementById('qol-recommendation');
    D.breakdown = document.getElementById('qol-breakdown');
    D.warnings = document.getElementById('qol-warnings');
    D.ctaPilar  = document.getElementById('qol-cta-pilar');
    D.copy      = document.getElementById('qol-copy');
    D.wa        = document.getElementById('qol-wa');
    D.ics       = document.getElementById('qol-ics');
    D.print     = document.getElementById('qol-print');
    D.reset     = document.getElementById('qol-reset');
    D.copyOk    = document.getElementById('qol-copy-confirm');
    D.stickybar = document.getElementById('qol-stickybar');
    D.resetFixed= document.getElementById('qol-reset-fixed');
    D.waFixed   = document.getElementById('qol-wa-fixed');

    D.start.addEventListener('click', function () {
      currentIndex = 0;
      renderQuestion(currentIndex);
      go(D.intro, D.question);
    });

    D.back.addEventListener('click', function () {
      if (currentIndex === 0) {
        go(D.question, D.intro);
      } else {
        currentIndex -= 1;
        renderQuestion(currentIndex);
        replay(D.question);
        scrollToWidget();
      }
    });

    D.copy.addEventListener('click', copyToClipboard);
    D.wa.addEventListener('click', shareWhatsApp);
    D.ics.addEventListener('click', downloadICS);
    D.print.addEventListener('click', function () { window.print(); });
    D.reset.addEventListener('click', reset);
    D.resetFixed.addEventListener('click', reset);
    D.waFixed.addEventListener('click', shareWhatsApp);
  }

  /* ── Mantener el widget a la vista en cada paso (clave en móvil) ── */
  function scrollToWidget() {
    var el = document.getElementById('qol-widget');
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* ── Transición entre pantallas ── */
  function go(from, to) {
    from.classList.add('off');
    to.classList.remove('off');
    replay(to);
    scrollToWidget();
  }

  function replay(el) {
    el.classList.remove('qolanim');
    void el.offsetWidth;
    el.classList.add('qolanim');
  }

  /* ── Pintar la pregunta N (0-indexada) ── */
  function renderQuestion(i) {
    var c = CRITERIA[i];

    D.qEmoji.textContent = c.emoji;
    D.qName.textContent  = c.name;
    D.qText.textContent  = c.question;
    D.qHelpLo.textContent = '0 = ' + c.lo;
    D.qHelpHi.textContent = '10 = ' + c.hi;
    D.stepLabel.textContent = (i + 1) + ' / ' + CRITERIA.length;
    D.stepLabel.setAttribute('aria-label', 'Pregunta ' + (i + 1) + ' de ' + CRITERIA.length);

    D.progBar.style.width = Math.round(((i + 1) / CRITERIA.length) * 100) + '%';
    D.progWrap.setAttribute('aria-valuenow', i + 1);
    D.qChips.setAttribute('aria-label', c.name + ': ' + c.question);

    buildChips(D.qChips, answers[i], function (v) {
      answers[i] = v;
      if (i < CRITERIA.length - 1) {
        currentIndex = i + 1;
        renderQuestion(currentIndex);
        replay(D.question);
        scrollToWidget();
      } else {
        showResult();
      }
    });
  }

  /* ── Construir la fila de chips 0-10 ── */
  function buildChips(container, selected, onPick) {
    container.innerHTML = '';
    var base = 'aspect-square w-full flex items-center justify-center rounded-xl font-bold text-base sm:text-lg border-2 transition-all duration-150 cursor-pointer select-none active:scale-90 outline-none focus-visible:border-brand-primary ';
    var unselected = base + 'bg-brand-card/50 dark:bg-slate-900/35 border-transparent hover:border-brand-primary/50 text-brand-text';
    var selectedCls = base + 'bg-brand-primary border-brand-primary text-white shadow-sm';

    for (var v = 0; v <= 10; v++) {
      (function (v) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(v);
        btn.setAttribute('role', 'radio');
        btn.setAttribute('aria-checked', v === selected ? 'true' : 'false');
        btn.setAttribute('aria-label', 'Valor ' + v + ' de 10');
        btn.className = v === selected ? selectedCls : unselected;
        btn.addEventListener('click', function () { onPick(v); });
        container.appendChild(btn);
      })(v);
    }
  }

  /* ── Mostrar resultado ── */
  function showResult() {
    var input = {};
    CRITERIA.forEach(function (c, i) { input[c.key] = answers[i] || 0; });
    var result = evaluateQualityOfLife(input);
    var total = result.score;
    lastScore = total;
    lastResult = result;

    D.score.textContent = total;
    D.resultFill.style.width = Math.round((total / MAX_SCORE) * 100) + '%';
    D.resultProg.setAttribute('aria-valuenow', total);

    /* Desglose por criterio */
    D.breakdown.innerHTML = '';
    CRITERIA.forEach(function (c, idx) {
      var row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-3 py-2.5 border-b border-brand-border/30 last:border-b-0';

      var label = document.createElement('span');
      label.className = 'text-sm text-brand-text flex items-center gap-2';
      var ico = document.createElement('span');
      ico.setAttribute('aria-hidden', 'true');
      ico.textContent = c.emoji;
      label.appendChild(ico);
      label.appendChild(document.createTextNode(' ' + c.label));

      var val = document.createElement('span');
      val.className = 'font-bold text-brand-primary text-sm bg-brand-card px-2.5 py-0.5 rounded-lg border border-brand-border shrink-0';
      val.textContent = answers[idx] + '/10';

      row.appendChild(label);
      row.appendChild(val);
      D.breakdown.appendChild(row);
    });

    /* Restablecer clases base */
    D.resultBox.className = 'p-6 md:p-8 rounded-2xl border text-center transition-all duration-300 shadow-sm my-2 sm:my-4';
    D.resultFill.className = 'h-full rounded-full transition-all duration-500';

    // Color neutral: el total no clasifica la situación clínica.
    D.resultBox.classList.add('bg-brand-primary/5', 'border-brand-border', 'text-brand-text');
    D.resultFill.classList.add('bg-brand-primary');
    D.warnings.replaceChildren();
    var warningTexts = result.warnings.length ? result.warnings.map(function (w) { return w.message; }) : ['No has marcado respuestas en 0. Revisa también las dificultades y cambios que la puntuación no recoja; esto no es una confirmación de bienestar.'];
    warningTexts.forEach(function (text) {
      var li = document.createElement('li');
      li.textContent = text;
      D.warnings.appendChild(li);
    });

    var strong = document.createElement('strong');
    strong.textContent = result.interpretation;
    D.interp.replaceChildren(strong);
    D.humanMsg.textContent = result.message;

    D.recBox.textContent = result.recommendation;

    if (result.guide) {
      D.ctaPilar.querySelector('a').textContent = result.guide.label;
      D.ctaPilar.style.display = 'block';
    } else {
      D.ctaPilar.style.display = 'none';
    }

    go(D.question, D.result);
    D.stickybar.classList.remove('off');
    document.body.classList.add('qol-result-active');
  }

  /* ── Texto plano del resultado (para copiar / compartir) ── */
  function resultText() {
    if (lastScore === null) return '';
    var lines = ['📊 *Puntaje HHHHHMM: ' + lastScore + '/70*', ''];
    CRITERIA.forEach(function (c, i) {
      lines.push('  • ' + c.label + ': ' + answers[i] + '/10');
    });
    lines.push('');
    lines.push(lastResult.message);
    lastResult.warnings.forEach(function (warning) { lines.push(warning.message); });
    lines.push(lastResult.recommendation);
    lines.push(lastResult.notices.join(' '));
    lines.push('🔗 https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros');
    return lines.join('\n');
  }

  /* ── Copiar resultado detallado ── */
  function copyToClipboard() {
    var text = resultText();
    if (!text || !navigator.clipboard) return;
    navigator.clipboard.writeText(text).then(function () {
      D.copyOk.style.display = 'block';
      setTimeout(function () { D.copyOk.style.display = 'none'; }, 3000);
    }).catch(function (err) {
      console.error('Error al copiar: ', err);
    });
  }

  /* ── Compartir por WhatsApp ── */
  function shareWhatsApp() {
    if (lastScore === null) return;
    var text = resultText();
    window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank');
  }

  /* ── Descargar recordatorio .ics ── */
  function downloadICS() {
    var score = lastScore === null ? '' : lastScore;
    var now    = new Date();
    var future = new Date(now.getTime() + 3 * 24 * 60 * 60 * 1000);

    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function fmtDate(d) {
      return d.getFullYear() + '' + pad(d.getMonth() + 1) + '' + pad(d.getDate());
    }

    var ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Cuida tu Perro Viejo//HHHHHMM//ES',
      'BEGIN:VEVENT',
      'UID:' + Date.now() + '@cuidatuperroviejo.com',
      'DTSTAMP:' + fmtDate(now),
      'DTSTART;VALUE=DATE:' + fmtDate(future),
      'SUMMARY:Reevaluar calidad de vida de mi perro (HHHHHMM)',
      'DESCRIPTION:Último puntaje: ' + score + '/70.\\nEvalúa nuevamente en: https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros',
      'URL:https://cuidatuperroviejo.com/herramientas/calculadora-calidad-vida-perros',
      'END:VEVENT',
      'END:VCALENDAR'
    ].join('\r\n');

    var blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement('a');
    a.href     = url;
    a.download = 'reevaluar-perro-hhhhhmm.ics';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  /* ── Reiniciar ── */
  function reset() {
    answers = new Array(CRITERIA.length).fill(null);
    currentIndex = 0;
    lastScore = null;
    lastResult = null;

    D.result.classList.add('off');
    D.result.classList.remove('qolanim');
    D.question.classList.add('off');
    D.question.classList.remove('qolanim');

    D.intro.classList.remove('off');
    replay(D.intro);

    D.stickybar.classList.add('off');
    document.body.classList.remove('qol-result-active');
    scrollToWidget();
  }

  /* ── Arranque robusto ── */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>
