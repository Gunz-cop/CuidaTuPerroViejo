---
// EmergencyGeoWidget: Componente de geolocalización de urgencias veterinarias
---

<div id="localized-emergency-box" class="mt-6 pt-5 border-t border-amber-200/60 dark:border-amber-900/40 hidden opacity-0 transition-all duration-500 transform translate-y-2">
  <p class="mb-3 flex items-start gap-2 text-sm leading-5 text-amber-900 dark:text-amber-200">
    <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
    <span id="localized-emergency-text">Detectando tu ubicación para sugerirte centros cercanos...</span>
  </p>
  <a 
    id="localized-emergency-btn" 
    href="https://www.google.com/search?q=clinicas+veterinarias+urgencias+cerca+de+mi" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-amber-700/10 bg-amber-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition duration-200 hover:bg-amber-800 hover:shadow active:scale-[0.98] focus:outline-none focus-visible:ring-4 focus-visible:ring-amber-600/30"
  >
    <span id="localized-emergency-btn-text">Buscar clínicas de urgencia</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  </a>
</div>

<script>
  // Mapeo de países de habla hispana a búsquedas locales optimizadas
  const countryConfig: Record<string, { name: string; url: string; btn: string }> = {
    ES: {
      name: 'España',
      url: 'https://www.google.com/search?q=clinicas+veterinarias+urgencias+espana',
      btn: 'Buscar clínicas de urgencia en España'
    },
    MX: {
      name: 'México',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+mexico',
      btn: 'Buscar clínicas de urgencia en México'
    },
    AR: {
      name: 'Argentina',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+argentina',
      btn: 'Buscar clínicas de urgencia en Argentina'
    },
    CO: {
      name: 'Colombia',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+colombia',
      btn: 'Buscar clínicas de urgencia en Colombia'
    },
    CL: {
      name: 'Chile',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+chile',
      btn: 'Buscar clínicas de urgencia en Chile'
    },
    PE: {
      name: 'Perú',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+peru',
      btn: 'Buscar clínicas de urgencia en Perú'
    },
    VE: {
      name: 'Venezuela',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+venezuela',
      btn: 'Buscar clínicas de urgencia en Venezuela'
    },
    EC: {
      name: 'Ecuador',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+ecuador',
      btn: 'Buscar clínicas de urgencia en Ecuador'
    },
    GT: {
      name: 'Guatemala',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+guatemala',
      btn: 'Buscar clínicas de urgencia en Guatemala'
    },
    CR: {
      name: 'Costa Rica',
      url: 'https://vet24cr.com/',
      btn: 'Buscar clínicas de urgencia en Costa Rica'
    },
    UY: {
      name: 'Uruguay',
      url: 'https://www.google.com/search?q=veterinarias+urgencias+uruguay',
      btn: 'Buscar clínicas de urgencia en Uruguay'
    }
  };

  const initGeoWidget = async () => {
    const box = document.getElementById('localized-emergency-box');
    const textSpan = document.getElementById('localized-emergency-text');
    const btn = document.getElementById('localized-emergency-btn') as HTMLAnchorElement;
    const btnText = document.getElementById('localized-emergency-btn-text');

    if (!box || !textSpan || !btn || !btnText) return;

    try {
      const response = await fetch('/api/geo');
      if (response.ok) {
        const data = await response.json();
        const country = data.country || 'UNKNOWN';

        if (countryConfig[country]) {
          const config = countryConfig[country];
          textSpan.textContent = `Hemos detectado que nos lees desde ${config.name}. Te sugerimos buscar centros veterinarios 24h:`;
          btn.href = config.url;
          btnText.textContent = config.btn;
        } else {
          // Fallback para países no listados o desconocidos
          textSpan.textContent = 'Encuentra centros veterinarios de urgencia 24 horas cerca de tu ubicación actual:';
          btn.href = 'https://www.google.com/search?q=clinicas+veterinarias+urgencias+cerca+de+mi';
          btnText.textContent = 'Buscar clínicas de urgencia cerca de mí';
        }
      }
    } catch (error) {
      console.error('Error al detectar geolocalización:', error);
      // Fallback silencioso por error de red
      textSpan.textContent = 'Encuentra centros veterinarios de urgencia 24 horas cerca de tu ubicación actual:';
      btn.href = 'https://www.google.com/search?q=clinicas+veterinarias+urgencias+cerca+de+mi';
      btnText.textContent = 'Buscar clínicas de urgencia cerca de mí';
    } finally {
      // Mostrar el widget animándolo
      box.classList.remove('hidden');
      // Esperar un frame de animación
      requestAnimationFrame(() => {
        box.classList.remove('opacity-0', 'translate-y-2');
        box.classList.add('opacity-100', 'translate-y-0');
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initGeoWidget);
  document.addEventListener('astro:page-load', initGeoWidget);
</script>
