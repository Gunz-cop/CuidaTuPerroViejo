---
import { getCollection } from 'astro:content';
import { CROSS_PILLAR_LINKS, PILAR_NAMES, TOOL_LINKS } from '../data/internal-links';

interface Props {
  currentPilar: 'guia-para-cuidar-tu-perro-senior' | 'salud-perros-mayores' | 'alimentacion-perros-senior' | 'movilidad-dolor-perros-mayores' | 'salud-mental-emocional-perros' | 'higiene-hogar-perros-senior' | 'cuidados-paliativos-perros';
  currentSlug: string;
}

const { currentPilar, currentSlug } = Astro.props;

const pilarName = PILAR_NAMES[currentPilar] || currentPilar;

// Fetch all posts from the blog collection
const allPosts = await getCollection('blog');

// Filter posts belonging to the same pilar, excluding the current article
const samePilarPosts = allPosts
  .filter((post) => post.data.pilar === currentPilar && post.slug !== currentSlug)
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime())
  .slice(0, 4);

const crossPilarPosts = (CROSS_PILLAR_LINKS[currentSlug] || [])
  .map((slug) => allPosts.find((post) => post.slug === slug))
  .filter((post): post is (typeof allPosts)[number] => Boolean(post));

const toolLink = TOOL_LINKS[currentSlug];
---

{(samePilarPosts.length > 0 || crossPilarPosts.length > 0 || toolLink) && (
  <section class="mt-16 pt-12 border-t border-brand-border w-full">
    {samePilarPosts.length > 0 && <>
      <h3 class="text-2xl font-extrabold text-brand-text mb-6 tracking-tight">
        Más guías de {pilarName}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {samePilarPosts.map((post) => (
        <a 
          href={`/${currentPilar}/${post.slug}`}
          class="group flex flex-col justify-between p-5 bg-brand-card dark:bg-brand-bg/50 border border-brand-border rounded-xl hover:shadow-sm hover:border-brand-primary/40 transition-all duration-300 relative overflow-hidden"
        >
          {/* Top border highlight on hover */}
          <div class="absolute top-0 left-0 right-0 h-1 bg-brand-primary transform -translate-y-1 group-hover:translate-y-0 transition-transform duration-300"></div>

          <div>
            <h4 class="text-lg font-bold text-brand-text mt-1 group-hover:text-brand-accent transition-colors duration-200 line-clamp-2 leading-snug">
              {post.data.title}
            </h4>
            {post.data.metaDescription && (
              <p class="text-brand-muted text-sm mt-2 line-clamp-2 leading-relaxed">
                {post.data.metaDescription}
              </p>
            )}
          </div>

          <div class="mt-4 flex items-center text-xs font-semibold text-brand-primary group-hover:text-brand-accent transition-colors duration-200">
            <span>Leer: {post.data.title}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </a>
      ))}
      </div>
    </>}

    {crossPilarPosts.length > 0 && <>
      <h3 class="text-2xl font-extrabold text-brand-text mt-12 mb-6 tracking-tight">
        También puede interesarte
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {crossPilarPosts.map((post) => (
        <a
          href={`/${post.data.pilar}/${post.slug}`}
          class="group flex flex-col justify-between p-5 bg-brand-secondary/15 dark:bg-brand-bg/50 border border-brand-border rounded-xl hover:shadow-sm hover:border-brand-primary/40 transition-all duration-300"
        >
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-primary mb-2">{PILAR_NAMES[post.data.pilar]}</p>
            <h4 class="text-lg font-bold text-brand-text group-hover:text-brand-accent transition-colors duration-200 leading-snug">{post.data.title}</h4>
          </div>
          <div class="mt-4 text-xs font-semibold text-brand-primary group-hover:text-brand-accent">Explorar esta guía →</div>
        </a>
      ))}
      </div>
    </>}

    {toolLink && <div class="mt-10 rounded-xl border border-brand-primary/25 bg-brand-primary/5 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-primary mb-2">Herramienta relacionada</p>
      <a href={toolLink.href} class="text-lg font-bold text-brand-text hover:text-brand-primary transition-colors">{toolLink.label}</a>
      <p class="mt-1 text-sm text-brand-muted">{toolLink.description}</p>
    </div>}
  </section>
)}
