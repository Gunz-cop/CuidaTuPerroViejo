---
// CanineAiAssistant.astro: Asistente virtual flotante con diseño premium, animaciones fluidas y alto contraste (soporte para modo claro y oscuro)
---
<!-- Toggle Button -->
<button 
  id="ai-chat-toggle" 
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-gradient-to-br from-[#45634f] to-[#5d7c67] dark:from-[#adcfb6] dark:to-[#8eb99a] text-white dark:text-[#121412] rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.15)] dark:shadow-[0_8px_30px_rgba(173,207,182,0.35)] hover:scale-[1.08] active:scale-[0.92] transition-all duration-300 cursor-pointer border border-[#45634f]/15 dark:border-[#adcfb6]/20 select-none group"
  aria-label="Abrir asistente de IA"
>
  <span class="ai-chat-attention-ring absolute inset-0 rounded-full bg-brand-primary opacity-20 pointer-events-none"></span>
  <div class="relative flex items-center justify-center">
    <span class="text-2xl group-hover:scale-110 group-hover:rotate-12 transition-all duration-300">🐾</span>
    <span class="ai-chat-status-pulse absolute -top-1.5 -right-1.5 w-3 h-3 bg-[#fdcb9b] dark:bg-[#7c5730] rounded-full border-2 border-white dark:border-[#121412]"></span>
    <span class="absolute -top-1.5 -right-1.5 w-3 h-3 bg-[#fdcb9b] dark:bg-[#7c5730] rounded-full border-2 border-white dark:border-[#121412]"></span>
  </div>
  <!-- Tooltip -->
  <span class="absolute right-18 scale-0 group-hover:scale-100 transition-all duration-200 bg-[#1b1c19] dark:bg-[#faf9f4] text-[#faf9f4] dark:text-[#1b1c19] text-[10px] font-bold px-3 py-1.5 rounded-xl shadow-md whitespace-nowrap pointer-events-none select-none tracking-wider uppercase">
    Asistente IA
  </span>
</button>

<!-- Chat Window Wrapper -->
<div 
  id="ai-chat-window" 
  class="fixed bottom-24 right-6 z-50 w-[calc(100vw-2rem)] sm:w-[400px] h-[600px] max-h-[calc(100dvh-8rem)] bg-white/95 dark:bg-[#121412]/98 backdrop-blur-lg border border-[#dbdad5]/70 dark:border-[#2f4d3a]/60 rounded-[32px] shadow-[0_20px_50px_rgba(0,0,0,0.15)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.4)] flex flex-col overflow-hidden transition-all duration-300 transform translate-y-4 opacity-0 pointer-events-none"
>
  <!-- Header (Gradient with brand identity) -->
  <header class="bg-gradient-to-r from-[#45634f] to-[#5d7c67] dark:from-[#1b1e1b] dark:to-[#121412] px-6 py-4.5 flex items-center justify-between text-white border-b border-[#dbdad5]/30 dark:border-[#2f4d3a]/30 shadow-md">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-white/10 dark:bg-[#adcfb6]/10 flex items-center justify-center text-lg shadow-inner">
        🐶
      </div>
      <div>
        <h3 class="text-[10px] font-bold tracking-widest uppercase text-white/70 dark:text-[#adcfb6]/70 leading-none mb-1">Asistente de Bienestar</h3>
        <span class="text-sm font-extrabold tracking-tight font-serif flex items-center gap-1.5 leading-none">
          Canine Advisor
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
        </span>
      </div>
    </div>
    
    <div class="flex items-center gap-1">
      <a 
        href="/asistente-ia" 
        class="w-8 h-8 rounded-full hover:bg-white/10 dark:hover:bg-[#adcfb6]/10 flex items-center justify-center text-white/80 dark:text-[#adcfb6]/80 hover:text-white dark:hover:text-[#adcfb6] transition-colors cursor-pointer"
        title="Ver en pantalla completa"
        aria-label="Ver en pantalla completa"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      
      <button 
        id="ai-chat-close" 
        class="w-8 h-8 rounded-full hover:bg-white/10 dark:hover:bg-[#adcfb6]/10 flex items-center justify-center text-white/80 dark:text-[#adcfb6]/80 hover:text-white dark:hover:text-[#adcfb6] transition-colors cursor-pointer"
        aria-label="Cerrar chat"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </header>

  <!-- Messages List -->
  <div id="ai-chat-messages" class="flex-1 overflow-y-auto p-5 space-y-6 scroll-smooth bg-gradient-to-b from-[#faf9f4]/20 to-[#f5f4ef]/40 dark:from-[#121412]/30 dark:to-[#121412]/50">
    
    <!-- Welcome message -->
    <div class="flex items-start gap-3 max-w-[85%] animate-fade-in">
      <div class="w-8 h-8 rounded-full bg-brand-primary/10 dark:bg-brand-primary/15 flex items-center justify-center text-xs shrink-0 select-none shadow-sm">
        🐾
      </div>
      <div class="bg-[#f4f6f3] dark:bg-[#1b1e1b] border border-[#dbdad5] dark:border-[#2f4d3a]/60 px-4 py-3.5 rounded-2xl rounded-tl-none shadow-sm">
        <p class="text-xs text-brand-text dark:text-[#f8fff7]/90 leading-relaxed font-light">
          ¡Hola! Soy tu asistente de bienestar para perros mayores. Pregúntame sobre alimentación, dolor articular (artrosis), ejercicio o cambios de comportamiento. ¿En qué te ayudo hoy?
        </p>
      </div>
    </div>

    <!-- Suggested Quick Prompts -->
    <div id="ai-chat-suggestions" class="space-y-3 pt-2">
      <p class="text-[10px] text-brand-muted/80 dark:text-[#adcfb6]/80 font-bold uppercase tracking-wider pl-11 select-none">Temas sugeridos:</p>
      <div class="flex flex-col gap-2.5 pl-11 pr-2">
        <button class="chat-suggest-btn flex items-center gap-2.5 w-full text-left px-4 py-3 bg-[#faf9f4]/80 dark:bg-[#1b1e1b]/80 hover:bg-[#45634f]/5 dark:hover:bg-[#adcfb6]/5 border border-[#dbdad5] dark:border-[#2f4d3a]/60 text-xs text-brand-text dark:text-[#f8fff7]/90 rounded-2xl transition-all cursor-pointer shadow-sm hover:scale-[1.02] active:scale-[0.98] font-medium">
          <span class="text-brand-primary dark:text-[#adcfb6]">💡</span>
          <span>¿Cómo saber si mi perro tiene dolor?</span>
        </button>
        <button class="chat-suggest-btn flex items-center gap-2.5 w-full text-left px-4 py-3 bg-[#faf9f4]/80 dark:bg-[#1b1e1b]/80 hover:bg-[#45634f]/5 dark:hover:bg-[#adcfb6]/5 border border-[#dbdad5] dark:border-[#2f4d3a]/60 text-xs text-brand-text dark:text-[#f8fff7]/90 rounded-2xl transition-all cursor-pointer shadow-sm hover:scale-[1.02] active:scale-[0.98] font-medium">
          <span class="text-brand-primary dark:text-[#adcfb6]">🦴</span>
          <span>¿Qué comida dar a un perro de 12 años?</span>
        </button>
        <button class="chat-suggest-btn flex items-center gap-2.5 w-full text-left px-4 py-3 bg-[#faf9f4]/80 dark:bg-[#1b1e1b]/80 hover:bg-[#45634f]/5 dark:hover:bg-[#adcfb6]/5 border border-[#dbdad5] dark:border-[#2f4d3a]/60 text-xs text-brand-text dark:text-[#f8fff7]/90 rounded-2xl transition-all cursor-pointer shadow-sm hover:scale-[1.02] active:scale-[0.98] font-medium">
          <span class="text-brand-primary dark:text-[#adcfb6]">🌙</span>
          <span>Mi perro senior está desorientado de noche</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Footer Disclaimer (High readability) -->
  <div class="px-5 py-3 border-t border-[#dbdad5]/30 dark:border-[#2f4d3a]/20 bg-[#faf9f4]/50 dark:bg-[#121613] text-center select-none shadow-[0_-2px_10px_rgba(0,0,0,0.01)]">
    <p class="text-[9px] text-brand-muted dark:text-[#adcfb6]/70 leading-relaxed font-light">
      ⚠️ <em>Este asistente virtual no sustituye el diagnóstico de un veterinario. Si tu mascota tiene una urgencia clínica, acude a un centro de inmediato.</em>
    </p>
  </div>

  <!-- Input Form -->
  <form id="ai-chat-form" class="p-3.5 border-t border-[#dbdad5]/30 dark:border-[#2f4d3a]/20 bg-white dark:bg-[#121613] flex items-center gap-2.5">
    <input 
      type="text" 
      id="ai-chat-input" 
      placeholder="Escribe tu consulta aquí..." 
      maxlength="300"
      required
      autocomplete="off"
      class="flex-1 px-4.5 py-3 bg-[#faf9f4]/50 dark:bg-[#1b1e1b] border border-[#dbdad5] dark:border-[#2f4d3a]/60 focus:border-brand-primary dark:focus:border-[#adcfb6] focus:ring-2 focus:ring-brand-primary/10 dark:focus:ring-[#adcfb6]/15 rounded-2xl text-base sm:text-xs text-brand-text dark:text-[#f8fff7] placeholder-brand-muted/50 focus:outline-none transition-all"
    />
    <button 
      type="submit" 
      class="w-10 h-10 bg-brand-primary hover:bg-[#5d7c67] active:scale-90 text-white dark:text-[#121412] dark:bg-[#adcfb6] dark:hover:bg-[#c9ebd1] rounded-2xl flex items-center justify-center shadow-md hover:shadow-lg transition-all shrink-0 cursor-pointer"
      aria-label="Enviar pregunta"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
      </svg>
    </button>
  </form>
      </svg>
    </button>
  </form>
</div>

<style is:global>
  /* Ocultar botón flotante en la página dedicada del asistente */
  .path-asistente-ia #ai-chat-toggle {
    display: none !important;
  }

  /* Custom Scrollbar for Chat Messages */
  #ai-chat-messages::-webkit-scrollbar {
    width: 6px;
  }
  #ai-chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  #ai-chat-messages::-webkit-scrollbar-thumb {
    background: rgba(69, 99, 79, 0.2);
    border-radius: 99px;
  }
  .dark #ai-chat-messages::-webkit-scrollbar-thumb {
    background: rgba(173, 207, 182, 0.15);
  }
  
  /* Animations */
  @keyframes attentionRing {
    0% {
      opacity: 0.22;
      transform: scale(1);
    }
    75%, 100% {
      opacity: 0;
      transform: scale(1.55);
    }
  }

  @keyframes statusPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(1.35);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fadeInUp 0.35s ease forwards;
  }

  .ai-chat-attention-ring {
    animation: attentionRing 1.35s ease-out 3;
  }

  .ai-chat-status-pulse {
    animation: statusPulse 1.2s ease-in-out 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-chat-attention-ring,
    .ai-chat-status-pulse {
      animation: none;
    }
  }
</style>

<script>
  const initAiChatWidget = () => {
    // Markdown Parser
    const parseMarkdown = (text: string): string => {
      // 1. Escapar HTML para seguridad
      let html = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // 2. Formato código en línea
      html = html.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 bg-brand-bg/60 dark:bg-slate-900/60 rounded font-mono text-[10px]">$1</code>');

      // 3. Negrita (**texto**)
      html = html.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-brand-text dark:text-white">$1</strong>');
      
      // 4. Cursiva (*texto*)
      html = html.replace(/\*(.*?)\*/g, '<em class="italic">$1</em>');

      // 5. Enlaces ([texto](url))
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (match, linkText, url) => {
        if (url.startsWith('/')) {
          return `<a href="${url}" class="text-brand-primary dark:text-brand-accent hover:underline font-bold decoration-2 cursor-pointer transition-colors">${linkText}</a>`;
        }
        return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-brand-primary dark:text-brand-accent hover:underline font-bold decoration-2 cursor-pointer transition-colors">${linkText} ↗</a>`;
      });

      // 6. Procesar por líneas para listas y párrafos
      const lines = html.split('\n');
      let result = '';
      let inList = false;
      let listType: 'ul' | 'ol' | null = null;

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (!line) {
          if (inList) {
            result += listType === 'ul' ? '</ul>' : '</ol>';
            inList = false;
            listType = null;
          }
          continue;
        }

        const isUnordered = /^[-*]\s+/.test(line);
        const isOrdered = /^\d+\.\s+/.test(line);

        if (isUnordered) {
          if (!inList || listType !== 'ul') {
            if (inList) result += listType === 'ul' ? '</ul>' : '</ol>';
            result += '<ul class="space-y-1.5 my-2.5 list-disc pl-5">';
            inList = true;
            listType = 'ul';
          }
          const content = line.replace(/^[-*]\s+/, '').trim();
          result += `<li class="text-xs text-brand-text dark:text-brand-text/90 leading-relaxed font-light">${content}</li>`;
        } else if (isOrdered) {
          if (!inList || listType !== 'ol') {
            if (inList) result += listType === 'ul' ? '</ul>' : '</ol>';
            result += '<ol class="space-y-1.5 my-2.5 list-decimal pl-5">';
            inList = true;
            listType = 'ol';
          }
          const content = line.replace(/^\d+\.\s+/, '').trim();
          result += `<li class="text-xs text-brand-text dark:text-brand-text/90 leading-relaxed font-light">${content}</li>`;
        } else {
          if (inList) {
            result += listType === 'ul' ? '</ul>' : '</ol>';
            inList = false;
            listType = null;
          }
          result += `<p class="text-xs text-brand-text dark:text-brand-text/90 leading-relaxed font-light mb-3">${line}</p>`;
        }
      }

      if (inList) {
        result += listType === 'ul' ? '</ul>' : '</ol>';
      }

      return result;
    };

    const toggleBtn = document.getElementById('ai-chat-toggle');
    const closeBtn = document.getElementById('ai-chat-close');
    const chatWindow = document.getElementById('ai-chat-window');
    const chatForm = document.getElementById('ai-chat-form') as HTMLFormElement;
    const chatInput = document.getElementById('ai-chat-input') as HTMLInputElement;
    const messagesContainer = document.getElementById('ai-chat-messages');
    const suggestionsBlock = document.getElementById('ai-chat-suggestions');
    const suggestBtns = document.querySelectorAll('.chat-suggest-btn');

    if (!toggleBtn || !closeBtn || !chatWindow || !chatForm || !chatInput || !messagesContainer) return;

    // Toggle ventana de chat
    const toggleChat = () => {
      const isOpen = !chatWindow.classList.contains('pointer-events-none');
      if (isOpen) {
        chatWindow.classList.add('pointer-events-none', 'opacity-0', 'translate-y-4');
      } else {
        chatWindow.classList.remove('pointer-events-none', 'opacity-0', 'translate-y-4');
        
        const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
        if (!isTouchDevice && window.innerWidth > 768) {
          chatInput.focus();
        }
        
        // Scroll automático
        setTimeout(() => {
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }, 100);
      }
    };

    toggleBtn.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', toggleChat);

    // Renderizar un mensaje en la ventana de chat
    const appendMessage = (sender: 'user' | 'ai', text: string) => {
      const messageRow = document.createElement('div');
      messageRow.className = `flex items-start gap-3 max-w-[85%] animate-fade-in ${sender === 'user' ? 'ml-auto flex-row-reverse' : ''}`;

      const iconDiv = document.createElement('div');
      iconDiv.className = `w-8 h-8 rounded-full flex items-center justify-center text-xs shrink-0 select-none shadow-sm ${
        sender === 'user' ? 'bg-[#fdcb9b]/25 dark:bg-[#7c5730]/25' : 'bg-brand-primary/10'
      }`;
      iconDiv.textContent = sender === 'user' ? '👤' : '🐾';

      const contentDiv = document.createElement('div');
      contentDiv.className = `px-4 py-3 rounded-2xl shadow-sm ${
        sender === 'user' 
          ? 'bg-[#45634f] dark:bg-[#2f4d3a] text-white dark:text-[#f8fff7] rounded-tr-none border border-transparent dark:border-[#adcfb6]/15' 
          : 'bg-[#f4f6f3] dark:bg-[#1b1e1b] border border-[#dbdad5] dark:border-[#2f4d3a]/60 text-brand-text dark:text-[#f8fff7]/90 rounded-tl-none'
      }`;

      if (sender === 'user') {
        const paragraph = document.createElement('p');
        paragraph.className = 'text-xs leading-relaxed font-light whitespace-pre-wrap';
        paragraph.textContent = text;
        contentDiv.appendChild(paragraph);
      } else {
        const markdownDiv = document.createElement('div');
        markdownDiv.className = 'markdown-body';
        markdownDiv.innerHTML = parseMarkdown(text);
        contentDiv.appendChild(markdownDiv);
      }

      messageRow.appendChild(iconDiv);
      messageRow.appendChild(contentDiv);
      messagesContainer.appendChild(messageRow);

      // Scroll al final
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    };

    // Renderizar indicador de carga (Perrito pensando)
    const appendTypingIndicator = (): HTMLDivElement => {
      const indicator = document.createElement('div');
      indicator.id = 'ai-typing-indicator';
      indicator.className = 'flex items-start gap-3 max-w-[85%] animate-fade-in';

      const iconDiv = document.createElement('div');
      iconDiv.className = 'w-8 h-8 rounded-full bg-brand-primary/10 dark:bg-brand-primary/15 flex items-center justify-center text-xs shrink-0 select-none shadow-sm';
      iconDiv.textContent = '🐾';

      const contentDiv = document.createElement('div');
      contentDiv.className = 'bg-[#f4f6f3] dark:bg-[#1b1e1b] border border-[#dbdad5] dark:border-[#2f4d3a]/60 px-4 py-3 rounded-2xl rounded-tl-none shadow-sm flex items-center gap-2';

      const text = document.createElement('span');
      text.className = 'text-[11px] text-brand-muted dark:text-brand-primary/80 italic font-light';
      text.textContent = 'Perrito pensando';

      // 3 puntitos de carga
      const dots = document.createElement('div');
      dots.className = 'flex gap-1 items-center mt-0.5';
      for (let i = 0; i < 3; i++) {
        const dot = document.createElement('span');
        dot.className = 'w-1.5 h-1.5 rounded-full bg-brand-primary animate-bounce';
        dot.style.animationDelay = `${i * 0.15}s`;
        dots.appendChild(dot);
      }

      contentDiv.appendChild(text);
      contentDiv.appendChild(dots);
      indicator.appendChild(iconDiv);
      indicator.appendChild(contentDiv);
      messagesContainer.appendChild(indicator);
      
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
      return indicator;
    };

    const handleQuestionSubmit = async (questionText: string) => {
      if (!questionText.trim()) return;

      // Ocultar sugerencias tras el primer envío
      if (suggestionsBlock) {
        suggestionsBlock.classList.add('hidden');
      }

      // 1. Mostrar mensaje del usuario
      appendMessage('user', questionText);
      chatInput.value = '';

      // 2. Mostrar indicador de "Perrito pensando"
      const indicator = appendTypingIndicator();

      try {
        const res = await fetch('/api/ask', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ question: questionText }),
        });

        // Eliminar indicador de carga
        indicator.remove();

        if (res.ok) {
          const data = await res.json();
          appendMessage('ai', data.answer);
        } else {
          const errData = await res.json();
          appendMessage('ai', `❌ Hubo un inconveniente: ${errData.error || 'No se pudo obtener respuesta de la IA.'}`);
        }
      } catch (error) {
        indicator.remove();
        console.error('Error al consultar el asistente de IA:', error);
        appendMessage('ai', '❌ Lo siento, no logré conectarme con el servidor. Revisa tu conexión a internet e inténtalo de nuevo.');
      }
    };

    // Manejar envío del formulario
    chatForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = chatInput.value;
      handleQuestionSubmit(text);
    });

    // Manejar clics en preguntas sugeridas
    suggestBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.textContent?.trim() || '';
        // Limpiar emojis decorativos de la pregunta antes de enviar
        // Remove emoji patterns if they exist
        const cleanText = text.replace(/^[^\w\s¿?¡!]+/g, '').trim();
        handleQuestionSubmit(cleanText);
      });
    });
  };

  // Inicializar
  document.addEventListener('DOMContentLoaded', initAiChatWidget);
  document.addEventListener('astro:page-load', initAiChatWidget);
</script>
