---
// CanineAiAssistant.astro: Asistente virtual flotante con inteligencia artificial para el cuidado de perros senior
---

<!-- Toggle Button -->
<button 
  id="ai-chat-toggle" 
  class="fixed bottom-6 right-6 z-50 flex items-center gap-2 px-4.5 py-3.5 bg-brand-primary hover:bg-brand-primary-hover text-white rounded-full shadow-2xl hover:shadow-primary/20 hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 cursor-pointer border border-brand-primary/10 select-none group"
  aria-label="Abrir asistente de IA"
>
  <span class="text-xl animate-pulse group-hover:scale-110 transition-transform">🐾</span>
  <span class="text-xs font-bold font-sans tracking-wide">Asistente IA</span>
</button>

<!-- Chat Window Wrapper -->
<div 
  id="ai-chat-window" 
  class="fixed bottom-22 right-6 z-50 w-[90vw] sm:w-[380px] h-[500px] bg-brand-card dark:bg-slate-900 border border-brand-border/80 rounded-3xl shadow-2xl flex flex-col overflow-hidden transition-all duration-300 transform translate-y-4 opacity-0 pointer-events-none"
>
  <!-- Header -->
  <header class="bg-brand-primary px-5 py-4 flex items-center justify-between text-white shadow-md">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-lg shadow-sm">
        🐶
      </div>
      <div>
        <h3 class="text-sm font-extrabold tracking-tight font-serif leading-tight">Asistente de Bienestar Canino</h3>
        <span class="text-[10px] text-white/80 font-light flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
          Conectado con IA
        </span>
      </div>
    </div>
    
    <button 
      id="ai-chat-close" 
      class="w-8 h-8 rounded-full hover:bg-white/10 flex items-center justify-center text-white/85 hover:text-white transition-colors cursor-pointer"
      aria-label="Cerrar chat"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </header>

  <!-- Messages List -->
  <div id="ai-chat-messages" class="flex-1 overflow-y-auto p-5 space-y-4 scroll-smooth bg-brand-bg/20 dark:bg-slate-950/10">
    
    <!-- Welcome message -->
    <div class="flex items-start gap-2.5 max-w-[85%]">
      <div class="w-6.5 h-6.5 rounded-full bg-brand-primary/10 flex items-center justify-center text-xs shrink-0 select-none">
        🐾
      </div>
      <div class="bg-white dark:bg-slate-800 border border-brand-border/40 px-3.5 py-2.5 rounded-2xl rounded-tl-none shadow-sm">
        <p class="text-xs text-brand-text leading-relaxed font-light">
          ¡Hola! Soy tu asistente de bienestar para perros mayores. Pregúntame sobre alimentación, dolor articular (artrosis), ejercicio o cambios de comportamiento. ¿En qué te ayudo hoy?
        </p>
      </div>
    </div>

    <!-- Suggested Quick Prompts -->
    <div id="ai-chat-suggestions" class="space-y-2 pt-2">
      <p class="text-[10px] text-brand-muted font-semibold uppercase tracking-wider pl-9">Temas sugeridos:</p>
      <div class="flex flex-wrap gap-1.5 pl-9">
        <button class="chat-suggest-btn px-3 py-1.5 bg-brand-primary/5 hover:bg-brand-primary/10 border border-brand-primary/15 text-[11px] text-brand-primary rounded-full transition-colors font-medium cursor-pointer">
          ¿Cómo saber si mi perro tiene dolor?
        </button>
        <button class="chat-suggest-btn px-3 py-1.5 bg-brand-primary/5 hover:bg-brand-primary/10 border border-brand-primary/15 text-[11px] text-brand-primary rounded-full transition-colors font-medium cursor-pointer">
          ¿Qué comida dar a un perro de 12 años?
        </button>
        <button class="chat-suggest-btn px-3 py-1.5 bg-brand-primary/5 hover:bg-brand-primary/10 border border-brand-primary/15 text-[11px] text-brand-primary rounded-full transition-colors font-medium cursor-pointer">
          Mi perro senior está desorientado de noche
        </button>
      </div>
    </div>
  </div>

  <!-- Footer Disclaimer -->
  <div class="px-5 py-2 border-t border-brand-border/40 bg-brand-card dark:bg-slate-900 text-center">
    <p class="text-[9px] text-brand-muted/80 leading-relaxed font-light">
      ⚠️ <em>Este asistente virtual no sustituye el diagnóstico de un veterinario. Si tu mascota tiene una urgencia clínica, acude a un centro de inmediato.</em>
    </p>
  </div>

  <!-- Input Form -->
  <form id="ai-chat-form" class="p-3 border-t border-brand-border/60 bg-brand-card dark:bg-slate-900 flex items-center gap-2">
    <input 
      type="text" 
      id="ai-chat-input" 
      placeholder="Escribe tu consulta aquí..." 
      maxlength="300"
      required
      autocomplete="off"
      class="flex-1 px-4 py-2.5 bg-brand-bg/50 dark:bg-slate-900/50 border border-brand-border/70 focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/15 rounded-full text-xs text-brand-text placeholder-brand-muted/60 focus:outline-none transition-all"
    />
    <button 
      type="submit" 
      class="w-9 h-9 bg-brand-primary hover:bg-brand-primary-hover active:scale-95 text-white rounded-full flex items-center justify-center shadow-md transition-all shrink-0 cursor-pointer"
      aria-label="Enviar pregunta"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 transform rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
      </svg>
    </button>
  </form>
</div>

<script>
  const initAiChatWidget = () => {
    const toggleBtn = document.getElementById('ai-chat-toggle');
    const closeBtn = document.getElementById('ai-chat-close');
    const chatWindow = document.getElementById('ai-chat-window');
    const chatForm = document.getElementById('ai-chat-form') as HTMLFormElement;
    const chatInput = document.getElementById('ai-chat-input') as HTMLInputElement;
    const messagesContainer = document.getElementById('ai-chat-messages');
    const suggestionsBlock = document.getElementById('ai-chat-suggestions');
    const suggestBtns = document.querySelectorAll('.chat-suggest-btn');

    if (!toggleBtn || !closeBtn || !chatWindow || !chatForm || !chatInput || !messagesContainer) return;

    // Toggle ventana de chat
    const toggleChat = () => {
      const isOpen = !chatWindow.classList.contains('pointer-events-none');
      if (isOpen) {
        chatWindow.classList.add('pointer-events-none', 'opacity-0', 'translate-y-4');
      } else {
        chatWindow.classList.remove('pointer-events-none', 'opacity-0', 'translate-y-4');
        chatInput.focus();
        // Scroll automático
        setTimeout(() => {
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }, 100);
      }
    };

    toggleBtn.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', toggleChat);

    // Renderizar un mensaje en la ventana de chat
    const appendMessage = (sender: 'user' | 'ai', text: string) => {
      const messageRow = document.createElement('div');
      messageRow.className = `flex items-start gap-2.5 max-w-[85%] ${sender === 'user' ? 'ml-auto flex-row-reverse' : ''}`;

      const iconDiv = document.createElement('div');
      iconDiv.className = `w-6.5 h-6.5 rounded-full flex items-center justify-center text-xs shrink-0 select-none ${
        sender === 'user' ? 'bg-brand-secondary/15' : 'bg-brand-primary/10'
      }`;
      iconDiv.textContent = sender === 'user' ? '👤' : '🐾';

      const contentDiv = document.createElement('div');
      contentDiv.className = `px-3.5 py-2.5 rounded-2xl shadow-sm ${
        sender === 'user' 
          ? 'bg-brand-primary text-white rounded-tr-none' 
          : 'bg-white dark:bg-slate-800 border border-brand-border/40 text-brand-text rounded-tl-none'
      }`;

      const paragraph = document.createElement('p');
      paragraph.className = 'text-xs leading-relaxed font-light whitespace-pre-wrap';
      paragraph.innerHTML = text.replace(/\n/g, '<br />'); // Mantener saltos de línea

      contentDiv.appendChild(paragraph);
      messageRow.appendChild(iconDiv);
      messageRow.appendChild(contentDiv);
      messagesContainer.appendChild(messageRow);

      // Scroll al final
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    };

    // Renderizar indicador de carga (Perrito pensando)
    const appendTypingIndicator = (): HTMLDivElement => {
      const indicator = document.createElement('div');
      indicator.id = 'ai-typing-indicator';
      indicator.className = 'flex items-start gap-2.5 max-w-[85%]';

      const iconDiv = document.createElement('div');
      iconDiv.className = 'w-6.5 h-6.5 rounded-full bg-brand-primary/10 flex items-center justify-center text-xs shrink-0 select-none';
      iconDiv.textContent = '🐾';

      const contentDiv = document.createElement('div');
      contentDiv.className = 'bg-white dark:bg-slate-800 border border-brand-border/40 px-3.5 py-2.5 rounded-2xl rounded-tl-none shadow-sm flex items-center gap-1.5';

      const text = document.createElement('span');
      text.className = 'text-[11px] text-brand-muted italic font-light';
      text.textContent = 'Perrito pensando';

      // 3 puntitos de carga
      const dots = document.createElement('div');
      dots.className = 'flex gap-0.5 items-center mt-1';
      for (let i = 0; i < 3; i++) {
        const dot = document.createElement('span');
        dot.className = 'w-1 h-1 rounded-full bg-brand-primary animate-bounce';
        dot.style.animationDelay = `${i * 0.15}s`;
        dots.appendChild(dot);
      }

      contentDiv.appendChild(text);
      contentDiv.appendChild(dots);
      indicator.appendChild(iconDiv);
      indicator.appendChild(contentDiv);
      messagesContainer.appendChild(indicator);
      
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
      return indicator;
    };

    const handleQuestionSubmit = async (questionText: string) => {
      if (!questionText.trim()) return;

      // Ocultar sugerencias tras el primer envío
      if (suggestionsBlock) {
        suggestionsBlock.classList.add('hidden');
      }

      // 1. Mostrar mensaje del usuario
      appendMessage('user', questionText);
      chatInput.value = '';

      // 2. Mostrar indicador de "Perrito pensando"
      const indicator = appendTypingIndicator();

      try {
        const res = await fetch('/api/ask', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ question: questionText }),
        });

        // Eliminar indicador de carga
        indicator.remove();

        if (res.ok) {
          const data = await res.json();
          appendMessage('ai', data.answer);
        } else {
          const errData = await res.json();
          appendMessage('ai', `❌ Hubo un inconveniente: ${errData.error || 'No se pudo obtener respuesta de la IA.'}`);
        }
      } catch (error) {
        indicator.remove();
        console.error('Error al consultar el asistente de IA:', error);
        appendMessage('ai', '❌ Lo siento, no logré conectarme con el servidor. Revisa tu conexión a internet e inténtalo de nuevo.');
      }
    };

    // Manejar envío del formulario
    chatForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = chatInput.value;
      handleQuestionSubmit(text);
    });

    // Manejar clics en preguntas sugeridas
    suggestBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.textContent?.trim() || '';
        handleQuestionSubmit(text);
      });
    });
  };

  // Inicializar
  document.addEventListener('DOMContentLoaded', initAiChatWidget);
  document.addEventListener('astro:page-load', initAiChatWidget);
</script>
