---
// Widget flotante del asistente IA. El chat en sí (mensajes, redactor, estilos
// y comportamiento) es AssistantChat.astro, que también usa /asistente-ia.
import AssistantChat from './AssistantChat.astro';

const PAW = 'M12 11.2c-3.5 0-6.4 2.7-6.4 6 0 2 1.5 3.2 3.4 3.2 1.1 0 2-.5 3-.5s1.9.5 3 .5c1.9 0 3.4-1.2 3.4-3.2 0-3.3-2.9-6-6.4-6Z';
---

<div class="ac-widget" data-assistant-widget>
  <button type="button" class="ac-toggle" data-ac-toggle aria-label="Abrir el asistente" aria-expanded="false" aria-controls="ac-panel">
    <svg class="ac-toggle-open" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="7.2" cy="8" r="2.2"></circle><circle cx="16.8" cy="8" r="2.2"></circle><circle cx="4.8" cy="12.7" r="1.9"></circle><circle cx="19.2" cy="12.7" r="1.9"></circle><path d={PAW}></path>
    </svg>
    <svg class="ac-toggle-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>

  <section id="ac-panel" class="ac-panel" data-ac-panel role="dialog" aria-labelledby="ac-panel-title" inert>
    <header class="ac-header">
      <span class="ac-avatar" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="7.2" cy="8" r="2.2"></circle><circle cx="16.8" cy="8" r="2.2"></circle><circle cx="4.8" cy="12.7" r="1.9"></circle><circle cx="19.2" cy="12.7" r="1.9"></circle><path d={PAW}></path></svg>
      </span>
      <div class="ac-heading">
        <h2 id="ac-panel-title" class="ac-title">Asistente IA</h2>
        <p class="ac-subtitle">Responde con nuestras guías</p>
      </div>
      <button type="button" class="ac-header-button" data-ac-reset aria-label="Empezar una conversación nueva" title="Conversación nueva">
        <svg class="ac-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
      </button>
      <a href="/asistente-ia" class="ac-header-button" aria-label="Abrir el asistente en pantalla completa" title="Pantalla completa">
        <svg class="ac-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg>
      </a>
      <button type="button" class="ac-header-button" data-ac-close aria-label="Cerrar el asistente" title="Cerrar">
        <svg class="ac-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </header>

    <AssistantChat surface="widget" inputId="ac-widget-input" />
  </section>
</div>
