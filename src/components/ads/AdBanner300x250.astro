---
// src/components/ads/AdBanner300x250.astro
// Banner in-content 300x250 (Adsterra). Contenedor con dimensiones fijas
// reservadas de antemano para evitar CLS. Se inserta programáticamente
// dentro del cuerpo del artículo (ver PostReader.astro).
---

<div
  class="ad-slot ad-slot--300x250 not-prose my-8 flex w-full justify-center"
  data-ad-pending="true"
  aria-label="Espacio publicitario"
>
  <div class="ad-slot__placeholder flex h-[250px] w-[300px] max-w-full items-center justify-center overflow-hidden rounded-xl border border-brand-border/40 bg-brand-card/30 text-[10px] uppercase tracking-wide text-brand-muted/50">
    <span aria-hidden="true">Publicidad</span>
  </div>
  <template>
    <!-- ADSTERRA_BANNER_300x250 -->
  </template>
</div>
