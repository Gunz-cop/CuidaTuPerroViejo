          </details>
        ))}
      </div>
      <p class="pr-done" hidden>Todo listo. Lo demás no depende de ti: quédate cerca y obsérvalo con calma.</p>
      <div class="pr-lista-actions" hidden>
        <button type="button" data-action="print">Imprimir la lista</button>
        <button type="button" data-action="reset">Desmarcar todo</button>
      </div>
      <p class="pr-note">Lo que marcas se guarda solo en este navegador.</p>
    </div>
  )}
</section>

<script>
  class PolvoraSequence {
    private step = 0;
    private playing = false;
    private timer: ReturnType<typeof setTimeout> | undefined;
    private events = new AbortController();
    private reduced = matchMedia('(prefers-reduced-motion: reduce)');
    private readonly last: number;
    constructor(private root: HTMLElement) {
      this.last = Number(root.dataset.last);
      root.dataset.enhanced = 'true';
      root.querySelectorAll<HTMLElement>('.pr-controls, .pr-timeline').forEach(el => (el.hidden = false));
      root.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button => button.addEventListener('click', () => {
        const action = button.dataset.action;
        if (action === 'play') {
          if (this.playing) this.stop();
          else if (!this.reduced.matches) {
            if (this.step === this.last) this.step = 0;
            this.playing = true;
            this.render();
            this.schedule();
          }
        } else {
          this.stop();
          if (action === 'restart') this.step = 0;
          else this.step = Math.max(0, Math.min(this.last, this.step + (action === 'next' ? 1 : -1)));
          this.render();
        }
      }, { signal: this.events.signal }));
      root.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach(button => button.addEventListener('click', () => {
        this.stop();
        this.step = Number(button.dataset.goto);
        this.render();
      }, { signal: this.events.signal }));
      this.reduced.addEventListener('change', this.preference, { signal: this.events.signal });
      document.addEventListener('visibilitychange', this.visibility, { signal: this.events.signal });
      window.addEventListener('pagehide', this.stop, { signal: this.events.signal });
      this.preference();
    }
    private preference = () => {
      this.stop();
      this.root.querySelector<HTMLButtonElement>('[data-action="play"]')!.disabled = this.reduced.matches;
    };
    private visibility = () => { if (document.hidden) this.stop(); };
    private stop = () => { clearTimeout(this.timer); this.timer = undefined; this.playing = false; this.render(); };
    private schedule() {
      clearTimeout(this.timer);
      this.timer = setTimeout(() => {
        if (!this.root.isConnected || !this.playing) { this.stop(); return; }
        if (this.step < this.last) { this.step++; this.render(); this.schedule(); }
        else this.stop();
      }, 5000);
    }
    private render() {
      const total = this.last + 1;
      this.root.dataset.step = String(this.step);
      this.root.dataset.playing = String(this.playing);
      this.root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel, i) => (panel.dataset.active = String(i === this.step)));
      this.root.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b, i) => b.setAttribute('aria-pressed', String(i === this.step)));
      const position = this.root.querySelector<HTMLElement>('.pr-position')!;
      position.setAttribute('aria-live', this.playing ? 'off' : 'polite');
      position.textContent = this.reduced.matches ? `Paso ${this.step + 1} de ${total} · movimiento reducido: usa las flechas` : `Paso ${this.step + 1} de ${total}`;
      this.root.querySelector<HTMLButtonElement>('[data-action="prev"]')!.disabled = this.step === 0;
      this.root.querySelector<HTMLButtonElement>('[data-action="next"]')!.disabled = this.step === this.last;
      this.root.querySelector<HTMLButtonElement>('[data-action="play"]')!.textContent = this.playing ? 'Pausar' : this.step === this.last ? 'Reproducir de nuevo' : 'Reproducir';
    }
    disconnect() { this.stop(); this.events.abort(); }
  }

  const STORAGE_KEY = 'ctpv:lista-polvora:v1';
  function readSaved(): Record<string, boolean> {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}') ?? {}; } catch { return {}; }
  }
  function save(state: Record<string, boolean>) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch { /* sin almacenamiento: la lista sigue funcionando */ }
  }
  function setupLista(root: HTMLElement): AbortController {
    const events = new AbortController();
    root.dataset.enhanced = 'true';
    root.querySelector<HTMLElement>('.pr-lista-actions')!.hidden = false;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const total = boxes.length;
    const saved = readSaved();
    boxes.forEach(b => (b.checked = !!saved[b.dataset.key!]));
    const update = (celebrate = false) => {
      const done = boxes.filter(b => b.checked).length;
      const pct = Math.round((done / total) * 100);
      root.style.setProperty('--pr-pct', String(pct));
      root.querySelector<HTMLElement>('.pr-pct')!.textContent = `${pct} %`;
      root.querySelector<HTMLElement>('.pr-count')!.textContent = done === 0 ? `${total} cosas, de noviembre a la mañana siguiente.` : `${done} de ${total} hechas.`;
      root.querySelectorAll<HTMLElement>('.pr-fase').forEach(fase => {
        const items = [...fase.querySelectorAll<HTMLInputElement>('input')];
        const n = items.filter(b => b.checked).length;
        fase.querySelector<HTMLElement>('[data-fase-count]')!.textContent = `${n} de ${items.length}`;
        fase.dataset.complete = String(n === items.length);
      });
      const complete = done === total;
      root.querySelector<HTMLElement>('.pr-done')!.hidden = !complete;
      root.dataset.complete = String(complete);
      if (complete && celebrate) {
        root.dataset.celebrate = 'false';
        void root.offsetWidth;
        root.dataset.celebrate = 'true';
      }
    };
    boxes.forEach(b => b.addEventListener('change', () => {
      const state = readSaved();
      state[b.dataset.key!] = b.checked;
      save(state);
      update(true);
    }, { signal: events.signal }));
    root.querySelector<HTMLButtonElement>('[data-action="reset"]')!.addEventListener('click', () => {
      boxes.forEach(b => (b.checked = false));
      save({});
      update();
    }, { signal: events.signal });
    root.querySelector<HTMLButtonElement>('[data-action="print"]')!.addEventListener('click', () => window.print(), { signal: events.signal });
    update();
    return events;
  }

  const sequences = new Map<HTMLElement, PolvoraSequence>();
  const listas = new Map<HTMLElement, AbortController>();
  function initializePolvora() {
    document.querySelectorAll<HTMLElement>('[data-pr-seq]').forEach(root => { if (!sequences.has(root)) sequences.set(root, new PolvoraSequence(root)); });
    document.querySelectorAll<HTMLElement>('[data-pr-lista]').forEach(root => { if (!listas.has(root)) listas.set(root, setupLista(root)); });
  }
  document.addEventListener('astro:before-swap', () => {
    sequences.forEach(instance => instance.disconnect());
    sequences.clear();
    listas.forEach(events => events.abort());
    listas.clear();
  });
  document.addEventListener('astro:page-load', initializePolvora);
  initializePolvora();
</script>

