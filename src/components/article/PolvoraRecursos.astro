            <g class="pr-tag pr-tag-high" transform="translate(475 172)"><rect x="-66" y="-16" width="132" height="24" rx="12"/><text text-anchor="middle">se oye mucho</text></g>
            <g class="pr-tag pr-tag-mid" transform="translate(352 400)"><rect x="-40" y="-16" width="80" height="24" rx="12"/><text text-anchor="middle">se oye</text></g>
