          <path class="pr-route-shadow" d="M160 392C200 380 225 345 250 338C300 326 330 352 380 356C420 360 440 358 468 356C482 355 490 350 494 344" fill="none" stroke="#294b3d" stroke-width="9" stroke-linecap="round" opacity=".55"/>
          <g class="pr-cueva">
            <rect x="466" y="284" width="64" height="108" rx="10" fill="none" stroke="#f6c453" stroke-width="4" stroke-dasharray="8 6"/>
            <g transform="translate(498 254)"><rect class="pr-pill" x="-50" y="-17" width="100" height="26" rx="13"/><text text-anchor="middle">su cueva</text></g>
