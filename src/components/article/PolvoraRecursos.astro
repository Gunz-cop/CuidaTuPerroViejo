---
// Tres apoyos visuales del artículo LA-01 (miedo a la pólvora en perros mayores).
// Todo el contenido sale del propio artículo; no se añaden datos clínicos nuevos.
// Sin reproducción automática; sin JavaScript se leen todos los pasos y la lista.
interface Props {
  variant: 'casa' | 'noche' | 'lista';
}
const { variant } = Astro.props;
const uid = `polvora-${variant}-${crypto.randomUUID().slice(0, 8)}`;
const planoSrc = '/images/blog/miedo-polvora-perros-mayores/anim-plano-casa-cenital-v1.webp';
const perroSrc = '/images/blog/miedo-polvora-perros-mayores/anim-mestizo-echado-v1.webp';

const casaSteps = [
  { title: 'Afuera, todo suena', text: 'En el patio no hay techo ni paredes entre tu perro y la pólvora de la calle. Por eso los perros de patio buscan entrar, y la UNAM recomienda no dejarlos en patios ni terrazas.' },
  { title: 'Lo entras antes del ruido', text: 'Con comida en la mano y sin jalarlo, antes de que empiece. Al entrar, se cierran el portón y la puerta del patio.' },
  { title: 'El cuarto donde menos se oye', text: 'Cada pared y cada puerta cerrada quedan entre él y la calle. Elige el cuarto más interior, sin ventana a la calle, y compruébalo escuchando una noche cualquiera.' },
  { title: 'Su cueva, con salida libre', text: 'Una mesa con una sábana por un lado y por detrás, su frazada y su agua, y dos lados abiertos. Si hace calor, un ventilador fuera de su alcance.' },
];

const nocheSteps = [
  { label: 'Tarde', title: 'La tarde', text: 'Placa con un teléfono que conteste esa noche. Paseo corto en llano y salida al baño antes de la hora fuerte.' },
  { label: 'Visitas', title: 'Antes de la primera visita', text: 'Entra a tu perro, deja su cueva lista con música o televisión y cierra el portón.' },
  { label: 'Hora fuerte', title: 'La hora fuerte', text: 'Quien abre, cierra. Nadie lo llama al patio. Si te busca, acompáñalo; si lo acepta, algo rico. Si tiene que salir, con correa y el portón cerrado.' },
  { label: 'Madrugada', title: 'Cuando baja la pólvora', text: 'Mira cómo respira, el color de sus encías y si te reconoce. Si se salió, repasa la ruta ahora, con la calle en silencio.' },
  { label: 'Mañana', title: 'La mañana del 25 o del 1', text: 'Recoge restos de cohetes en el patio, la acera y la azotea. Anota dónde se metió, a qué hora empezó y si comió.' },
];

const fases = [
  { id: 'nov', title: 'En noviembre', items: [
    'Pedir cita con la veterinaria',
    'Llevar escrito qué hizo el diciembre pasado, sus otros sustos y lo que toma',
    'Preguntar qué clínica atiende el 24 y el 31',
    'Si no se levanta: pedir que te enseñen a moverlo',
  ] },
  { id: 'antes', title: 'Los días antes', items: [
    'Elegir el cuarto donde menos se oye la calle',
    'Armar su cueva: mesa, sábana, frazada, agua y salida libre',
    'Dejarlo entrar a ratos con su cama y algo de comer',
    'Preguntar a los vecinos a qué hora empieza la pólvora',
    'Revisar la malla, el portón y que el collar no se le salga',
  ] },
  { id: 'tarde', title: 'La tarde del 24 y del 31', items: [
    'Placa con un teléfono que conteste esa noche',
    'Foto reciente de cuerpo entero en el teléfono',
    'Paseo corto en llano y salida al baño',
    'Entrarlo antes de la primera visita',
  ] },
  { id: 'noche', title: 'Esa noche', items: [
    'Acordar con la familia: quien abre, cierra',
    'Música o televisión en su cuarto',
    'Ventilador fuera de su alcance si hace calor',
    'Si sale al baño: con correa y el portón cerrado',
    'Veterinaria de guardia anotada a mano',
  ] },
  { id: 'manana', title: 'La mañana siguiente', items: [
    'Recoger restos de cohetes en patio, acera y azotea',
    'Anotar dónde se metió, a qué hora empezó y si comió',
    'Si no se levanta: revisar la piel de los apoyos y que haya bebido y orinado',
  ] },
];
const totalItems = fases.reduce((n, f) => n + f.items.length, 0);
---

<section class={`pr-visual pr-${variant}`} data-editorial-visual data-reader-atomic aria-labelledby={`${uid}-title`}>
  {variant === 'casa' && (
    <div data-pr-seq data-step="0" data-playing="false" data-last={casaSteps.length - 1}>
      <header>
        <p class="pr-kicker">Recorrido · cuatro pasos</p>
        <h3 id={`${uid}-title`} data-toc-exclude="true">Del patio a su cueva</h3>
      </header>
      <div class="pr-canvas pr-canvas-casa">
        <svg viewBox="0 0 720 460" role="img" aria-labelledby={`${uid}-svg-title ${uid}-svg-desc`}>
          <title id={`${uid}-svg-title`}>Plano de una casa de una planta con patio, vista desde arriba</title>
          <desc id={`${uid}-svg-desc`}>La calle arriba, con ondas de pólvora. A la izquierda, un patio con una pila, un tendedero y un portón verde a la calle. A la derecha, la casa: sala y comedor junto a la calle, cocina al fondo y un cuarto interior sin ventana a la calle, con una mesa cubierta por una sábana azul. El perro aparece primero en el patio, luego en la cocina y al final en su cueva bajo la mesa del cuarto interior.</desc>
          <defs><marker id={`${uid}-arrow`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10Z" fill="#fffdf6"/></marker></defs>
          <image href={planoSrc} x="0" y="0" width="720" height="460" preserveAspectRatio="none"/>
          <g class="pr-bursts">
            <g transform="translate(130 26)"><circle class="pr-ring pr-r1" r="30"/><circle class="pr-ring pr-r2" r="30"/><circle class="pr-ring pr-r3" r="30"/><path class="pr-spark" d="M0-14V-5M0 5V14M-14 0H-5M5 0H14M-10-10l5 5M5 5l5 5M-10 10l5-5M5-5l5-5"/></g>
            <g transform="translate(560 26)"><circle class="pr-ring pr-r2" r="30"/><circle class="pr-ring pr-r3" r="30"/><circle class="pr-ring pr-r1" r="30"/><path class="pr-spark" d="M0-14V-5M0 5V14M-14 0H-5M5 0H14M-10-10l5 5M5 5l5 5M-10 10l5-5M5-5l5-5"/></g>
          </g>
