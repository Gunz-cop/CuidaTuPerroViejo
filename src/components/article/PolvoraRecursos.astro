          <g class="pr-lock" transform="translate(228 356)"><rect x="-10" y="-2" width="20" height="16" rx="3" fill="#d9a53a" stroke="#5a3d0c" stroke-width="2"/><path d="M-5-2v-5a5 5 0 0 1 10 0v5" fill="none" stroke="#5a3d0c" stroke-width="3"/></g>
