---
interface Props {
  variant: 'primeros-minutos' | 'umbrales';
}
const { variant } = Astro.props;
const uid = `golpe-calor-${variant}-${crypto.randomUUID().slice(0, 8)}`;
const steps = [
  { title: 'Sácalo del calor y llama', text: 'Sombra o la habitación más fresca de casa. Llama a su clínica o a urgencias 24 horas mientras empiezas a enfriarlo.' },
  { title: 'Moja hasta la piel', text: 'Agua fresca del grifo, la ducha o una manguera suave, lejos de la cara. Que no se quede en la superficie del pelo. Nada de hielo.' },
  { title: 'Dale aire en movimiento', text: 'Ventilador o corriente mientras sigue mojado: así se pierde el calor. Pregunta a la clínica cuándo parar.' },
  { title: 'Llévalo a la clínica', text: 'Coche con el aire puesto. Si vais dos, uno conduce y el otro lo vigila. Aunque parezca mejor, que lo valoren.' },
];
const scaleMin = 26;
const scaleMax = 40;
const pct = (t: number) => `${((t - scaleMin) / (scaleMax - scaleMin)) * 100}%`;
const ticks = [26, 28, 30, 32, 34, 36, 38, 40];
const zones = [
  { name: 'Sierra de Madrid', threshold: 34 },
  { name: 'Metropolitana y Henares', threshold: 36 },
  { name: 'Campiña sevillana', threshold: 38 },
];
---

<section class={`gc-visual gc-${variant}`} data-editorial-visual data-reader-atomic aria-labelledby={`${uid}-title`}>
  {variant === 'primeros-minutos' ? <div data-gc-sequence data-step="0" data-playing="false">
    <header><p class="gc-kicker">Secuencia · cuatro pasos a la vez que llamas</p><h3 id={`${uid}-title`} data-toc-exclude="true">Los primeros minutos, de un vistazo</h3></header>
    <div class="gc-canvas">
      <svg viewBox="0 0 720 300" role="img" aria-labelledby={`${uid}-svg-title ${uid}-svg-desc`}>
        <title id={`${uid}-svg-title`}>Esquema de los primeros minutos ante un golpe de calor</title>
        <desc id={`${uid}-svg-desc`}>Cuatro escenas: pasar del sol a la sombra y llamar por teléfono; agua que atraviesa el pelo hasta la piel; un ventilador que mueve aire sobre el pelo mojado mientras el agua se evapora; y un coche con el aire puesto camino de la clínica.</desc>
        <rect width="720" height="300" rx="16" fill="#edf2e8"/>
        <g class="gc-scene" data-scene="0">
