            <rect x="0" y="0" width="62" height="112" rx="12" fill="#294b3d"/>
            <rect x="8" y="14" width="46" height="72" rx="4" fill="#d9e6d3"/>
            <circle cx="31" cy="98" r="5" fill="#d9e6d3"/>
            <g class="gc-ring" fill="none" stroke="#294b3d" stroke-width="5" stroke-linecap="round"><path d="M76 34q14 22 0 44"/><path d="M90 22q24 34 0 68"/></g>
          </g>
