          </g>
          <g class="gc-air" fill="none" stroke="#5b8a74" stroke-width="5" stroke-linecap="round" stroke-dasharray="24 18"><path d="M200 110C300 96 380 128 600 112"/><path d="M200 150C300 140 400 166 600 150"/><path d="M200 190C300 182 400 204 600 190"/></g>
          <rect x="230" y="236" width="400" height="26" rx="6" fill="#e9b6ac"/>
          <g stroke="#a46c3c" stroke-width="5" stroke-linecap="round"><path d="M250 236l10-30M290 236l12-32M330 236l10-30M370 236l12-32M410 236l10-30M450 236l12-32M490 236l10-30M530 236l12-32M570 236l10-30M610 236l10-30"/></g>
          <g class="gc-vapor" fill="none" stroke="#7aa6c4" stroke-width="4" stroke-linecap="round"><path d="M300 200q-10-14 0-28t0-28"/><path d="M420 200q-10-14 0-28t0-28"/><path d="M540 200q-10-14 0-28t0-28"/></g>
          <text x="420" y="66" text-anchor="middle">Aire sobre el pelo mojado</text>
        </g>
        <g class="gc-scene" data-scene="3">
          <path d="M30 238H690" stroke="#5b6f66" stroke-width="8"/>
