          <g class="gc-wet" fill="#3b82b8" fill-opacity=".55"><ellipse cx="300" cy="226" rx="34" ry="7"/><ellipse cx="380" cy="226" rx="34" ry="7"/><ellipse cx="460" cy="226" rx="30" ry="6"/></g>
