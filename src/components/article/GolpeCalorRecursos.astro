        </g>
        <g class="gc-scene" data-scene="1">
          <g transform="translate(300 34)"><path d="M0 0h120v18H0z" fill="#5b6f66"/><path d="M14 18h92l-12 22H26z" fill="#7d9671"/><path d="M52 -26h16v26H52z" fill="#5b6f66"/></g>
          <g class="gc-drops" fill="#3b82b8"><circle cx="330" cy="92" r="7"/><circle cx="360" cy="106" r="7"/><circle cx="390" cy="88" r="7"/><circle cx="345" cy="132" r="7"/><circle cx="378" cy="140" r="7"/><circle cx="406" cy="120" r="7"/></g>
          <rect x="110" y="226" width="500" height="36" rx="6" fill="#e9b6ac"/>
