          <rect x="314" y="140" width="176" height="94" fill="#294b3d" fill-opacity=".1"/>
          <path class="gc-move-arrow" d="M200 206H286" stroke="#294b3d" stroke-width="5" stroke-linecap="round" marker-end={`url(#${uid}-arrow)`}/>
          <text x="402" y="268" text-anchor="middle">Sombra</text>
