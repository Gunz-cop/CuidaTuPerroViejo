---
interface Props { variant: 'pausa' | 'espacio' | 'zonas'; }
const { variant } = Astro.props;
const scenes = {
  pausa: {
    title: 'Lee el cambio. Dale espacio.', kicker: '01 / La pausa también es cuidado',
    note: 'Una secuencia orientativa de manejo; no todos los perros avisan igual. Si hay dolor nuevo, consulta antes de reintentar.',
    steps: [
      ['Observa', 'Si se tensa, gira la cabeza o intenta salir, deja de avanzar. Una señal aislada necesita contexto.'],
      ['Detén', 'Cierra el agua y suspende el contacto. No aumentes la sujeción para terminar.'],
      ['Da espacio', 'Retira las manos y permite una salida segura sobre suelo con tracción. No lo persigas.'],
      ['Reevalúa', 'Decide si el aseo puede esperar. Si queda champú y no puedes retirarlo con seguridad, pide orientación veterinaria.'],
    ],
  },
  espacio: {
    title: 'Construye un baño que pueda recorrer.', kicker: '02 / Primero el espacio, después el agua',
    note: 'Adapta la superficie y el acceso a tu perro. Una esterilla no compensa dolor, debilidad ni una entrada peligrosa.',
    steps: [
      ['Entrada seca', 'Despeja el paso. Evita que tenga que saltar o girar en un espacio estrecho.'],
      ['Tracción', 'Coloca una esterilla estable en la ducha y comprueba que sus bordes no se levantan.'],
      ['Todo al alcance', 'Deja producto indicado, paños y toallas a mano. No abandones al perro para buscarlos.'],
      ['Salida preparada', 'Reserva un lugar seco, próximo y sin obstáculos para terminar el secado y descansar.'],
    ],
  },
  zonas: {
    title: 'Limpia lo necesario. Cambia de paño.', kicker: '03 / El mapa del aseo localizado',
    note: 'El mapa indica zonas externas, no técnicas de exploración. No levantes extremidades doloridas ni frotes piel lesionada.',
    steps: [
      ['Patas', 'Retira suciedad superficial si tolera el contacto. Evita levantar la pata para buscar una postura perfecta.'],
      ['Zona posterior', 'Usa material distinto para el periné externo. No arrastres suciedad hacia otras zonas.'],
      ['Pliegues', 'Revisa solo lo accesible sin forzar. Si hay dolor, herida, olor persistente o secreción, consulta.'],
      ['Secado', 'Retira humedad con una toalla suave, sin frotar. Termina antes si deja de tolerarlo.'],
    ],
  },
};
const scene = scenes[variant];
const uid = `bano-${variant}`;
---

<div data-bano-sequence data-variant={variant} data-step="0" data-playing="false">
  <figure class="lesson" aria-labelledby={`${uid}-title`}>
    <header><p class="kicker">{scene.kicker}</p><h3 id={`${uid}-title`}>{scene.title}</h3></header>
    <div class="canvas">
      <svg viewBox="0 0 760 360" role="img" aria-labelledby={`${uid}-svg-title ${uid}-desc`}>
        <title id={`${uid}-svg-title`}>{scene.title}</title>
        <desc id={`${uid}-desc`}>Esquema de un dogo argentino blanco con orejas naturales y una mancha gris sobre el ojo izquierdo. {scene.steps.map(s => s.join(': ')).join('. ')}</desc>
        <defs>
          <pattern id={`${uid}-mat`} width="12" height="12" patternUnits="userSpaceOnUse"><path d="M0 6h12M6 0v12" stroke="#fff" stroke-opacity=".25" /></pattern>
          <linearGradient id={`${uid}-room`} x2="0" y2="1"><stop stop-color="#e7f0ec"/><stop offset="1" stop-color="#faf7ee"/></linearGradient>
        </defs>
        <rect width="760" height="360" rx="16" fill={`url(#${uid}-room)`}/>
        <path d="M36 279H724" stroke="#9bb0a7" stroke-width="3"/>
        <path d="M80 34V279M680 34V279" stroke="#c5d3cc" stroke-width="2"/>
        <rect x="100" y="45" width="104" height="92" rx="10" fill="#fff9e4" stroke="#cad9ce"/>
        <path d="M152 45V137M100 91H204" stroke="#d6dfd5" stroke-width="3"/>
        <g class="mat"><ellipse cx="390" cy="281" rx="201" ry="22" fill="#16766b"/><ellipse cx="390" cy="281" rx="201" ry="22" fill={`url(#${uid}-mat)`}/></g>
        {variant === 'espacio' && <>
          <g class="entry"><path d="M50 303H182" stroke="#b38342" stroke-width="17" stroke-linecap="round"/><path d="m154 293 15 10-15 10" stroke="#fff" stroke-width="3" fill="none"/></g>
          <g class="supplies"><rect x="596" y="145" width="112" height="12" rx="5" fill="#a9754e"/><rect x="612" y="100" width="27" height="45" rx="5" fill="#287b70"/><path d="M619 100v-8h14" stroke="#254f48" stroke-width="5" fill="none"/><rect x="651" y="112" width="41" height="30" rx="4" fill="#e4ba67"/></g>
          <g class="exit"><rect x="535" y="301" width="167" height="26" rx="13" fill="#e5ba70"/><path d="M550 314H684" stroke="#fff6dd" stroke-width="3"/></g>
        </>}
        <g class="dog">
          <ellipse cx="382" cy="174" rx="135" ry="62" fill="#fffdf6" stroke="#3f5d55" stroke-width="3"/>
          <path d="M280 156q-33 13-53-12q8 42 37 41" fill="#fffdf6" stroke="#3f5d55" stroke-width="3"/>
          <path d="M285 204l-8 64q8 12 30 3l15-58M425 211l13 59q11 10 30 0l-3-68" fill="#fffdf6" stroke="#3f5d55" stroke-width="3" stroke-linejoin="round"/>
          <path d="M331 220l-2 46q9 9 26 0l10-42M473 201l12 63q11 11 25 0l-4-81" fill="#e6e9e3" stroke="#3f5d55" stroke-width="3"/>
          <g class="head">
            <path d="M450 144q-1-46 36-58q28-7 47 12l28 29q21 8 10 25l-22 9q-11 32-42 24l-34-16" fill="#fffdf6" stroke="#3f5d55" stroke-width="3"/>
            <path d="M480 96q-29-7-27 20l17 28q16-8 18-30" fill="#e0ddd1" stroke="#3f5d55" stroke-width="3"/>
            <ellipse cx="523" cy="113" rx="12" ry="9" fill="#8e918b"/>
            <circle cx="528" cy="121" r="4" fill="#3b352b"/>
            <ellipse cx="566" cy="137" rx="10" ry="7" fill="#233c37"/>
            <path d="M548 153q9 4 15-2" stroke="#3f5d55" stroke-width="2" fill="none"/>
          </g>
        </g>
        {variant === 'pausa' && <>
          <g class="water"><path d="M416 54l-47 94M429 58l-45 95M442 63l-43 95" stroke="#559fb2" stroke-width="4" stroke-dasharray="6 9"/><path d="M407 49l38 19" stroke="#3f5d55" stroke-width="13" stroke-linecap="round"/></g>
          <g class="hand"><path d="M668 72l-88 43-125 28q-20 12-8 21q8 6 19-2l117-14 75-28" fill="#d9ac87" stroke="#8e6552" stroke-width="3"/></g>
          <g class="space-ring"><ellipse cx="397" cy="206" rx="214" ry="112" fill="none" stroke="#338d7e" stroke-width="3" stroke-dasharray="9 9"/></g>
          <g class="pause-mark"><rect x="344" y="53" width="14" height="37" rx="4" fill="#ad633c"/><rect x="366" y="53" width="14" height="37" rx="4" fill="#ad633c"/></g>
          <g class="exit-arrow"><path d="M215 309H82m22-17-22 17 22 17" fill="none" stroke="#227b6b" stroke-width="5" stroke-linejoin="round"/></g>
        </>}
        {variant === 'zonas' && <>
          <g class="zone zone-0"><circle cx="454" cy="252" r="29"/><path class="cloth" d="M435 241h31v21h-31z"/></g>
          <g class="zone zone-1"><circle cx="278" cy="191" r="29"/><path class="cloth" d="M265 181h26v21h-26z"/></g>
          <g class="zone zone-2"><circle cx="441" cy="199" r="29"/><path class="cloth" d="M427 189h27v21h-27z"/></g>
          <g class="zone zone-3"><ellipse cx="375" cy="173" rx="85" ry="42"/><path class="cloth" d="M345 152h53v35h-53z"/></g>
        </>}
        <g class="step-pips" aria-hidden="true">{scene.steps.map((_, i) => <circle data-pip={i} cx={341+i*26} cy="337" r="5" fill="#a9bfb4"/>)}</g>
      </svg>
    </div>
    <ol class="step-list">{scene.steps.map(([title, text], i) => <li data-panel={i}><span class="ordinal">0{i+1}</span><div><strong>{title}</strong><p>{text}</p></div></li>)}</ol>
    <div class="controls" hidden>
      <div class="transport"><button type="button" data-action="prev" aria-label="Paso anterior">←</button><button type="button" data-action="play">Reproducir secuencia</button><button type="button" data-action="next" aria-label="Paso siguiente">→</button></div>
      <p class="position" aria-live="polite" aria-atomic="true"></p>
      <p class="motion-help">También puedes recorrerla paso a paso, sin reproducción.</p>
    </div>
    <figcaption>{scene.note} Ilustración representativa; el dogo no es un paciente del estudio.</figcaption>
  </figure>
</div>

<script>
  class BanoSequence {
    constructor(private root: HTMLElement) {}
    private step = 0;
    private timer: ReturnType<typeof setTimeout> | undefined;
    private playing = false;
    private reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    private aborter = new AbortController();
    connectedCallback() {
      this.root.querySelector<HTMLElement>('.controls')!.hidden = false;
      this.root.dataset.enhanced = 'true';
      this.root.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button => button.addEventListener('click', () => {
        const action = button.dataset.action;
        if (action === 'play') {
          if (this.playing) this.stop();
          else {
            if (this.step === 3) this.step = 0;
            this.playing = true; this.render(); this.schedule();
          }
        } else { this.stop(); this.step = Math.max(0, Math.min(3, this.step + (action === 'next' ? 1 : -1))); this.render(); }
      }, { signal: this.aborter.signal }));
      this.reduced.addEventListener('change', this.preference, { signal: this.aborter.signal });
      document.addEventListener('visibilitychange', this.visibility, { signal: this.aborter.signal });
      this.preference(); this.render();
    }
    private preference = () => {
      if (this.reduced.matches) this.stop();
      this.root.querySelector<HTMLButtonElement>('[data-action="play"]')!.disabled = this.reduced.matches;
      this.root.querySelector<HTMLElement>('.motion-help')!.textContent = this.reduced.matches ? 'Movimiento reducido: utiliza las flechas para ver cada paso sin animación.' : 'También puedes recorrerla paso a paso, sin reproducción.';
    };
    private visibility = () => { if (document.hidden) this.stop(); };
    private schedule() {
      this.timer = setTimeout(() => {
        if (!this.root.isConnected || !this.playing) return;
        if (this.step < 3) { this.step++; this.render(); this.schedule(); }
        else this.stop();
      }, 5500);
    }
    private stop() { clearTimeout(this.timer); this.playing = false; this.render(); }
    private render() {
      this.root.dataset.step = String(this.step); this.root.dataset.playing = String(this.playing);
      this.root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel, index) => panel.hidden = index !== this.step);
      const label = this.root.querySelector<HTMLElement>('.position')!;
      label.setAttribute('aria-live', this.playing ? 'off' : 'polite');
      label.textContent = `Paso ${this.step+1} de 4`;
      this.root.querySelector<HTMLButtonElement>('[data-action="play"]')!.textContent = this.playing ? 'Pausar' : this.step === 3 ? 'Repetir secuencia' : 'Reproducir secuencia';
      this.root.querySelector<HTMLButtonElement>('[data-action="prev"]')!.disabled = this.step === 0;
      this.root.querySelector<HTMLButtonElement>('[data-action="next"]')!.disabled = this.step === 3;
    }
    disconnectedCallback() { clearTimeout(this.timer); this.aborter.abort(); }
  }
  const instances = new Map<HTMLElement, BanoSequence>();
  function initialize() {
    document.querySelectorAll<HTMLElement>('[data-bano-sequence]').forEach(root => {
      if (instances.has(root)) return;
      const instance = new BanoSequence(root);
      instances.set(root, instance);
      instance.connectedCallback();
    });
  }
  document.addEventListener('astro:before-swap', () => {
    instances.forEach(instance => instance.disconnectedCallback());
    instances.clear();
  });
  document.addEventListener('astro:page-load', initialize);
  initialize();
</script>

<style>
  [data-bano-sequence] { display:block; margin:2.5rem 0; color:#254f48; }
  .lesson { margin:0; background:#f8faf5; border:1px solid #bbd0c1; border-radius:1.5rem; overflow:hidden; box-shadow:0 14px 40px #1c50370b; }
  header { padding:1.5rem 1.5rem .7rem; }
  .kicker { color:#426a5d; font:700 .72rem/1.5 system-ui,sans-serif; text-transform:uppercase; letter-spacing:.12em; margin:0 0 .5rem; }
  header h3 { margin:0; font:700 clamp(1.15rem,3vw,1.7rem)/1.25 system-ui,sans-serif; letter-spacing:-.025em; }
  .canvas { padding:.6rem 1rem; }
  svg { display:block; width:100%; height:auto; }
  .step-list { padding:0 1.5rem; margin:.5rem 0; list-style:none; }
  .step-list li { display:flex; align-items:flex-start; gap:1rem; padding:.8rem 0; }
  .step-list li[hidden] { display:none; }
  .ordinal { flex:0 0 2.5rem; height:2.5rem; display:grid; place-items:center; border-radius:50%; background:#dfecdf; font:700 .9rem system-ui,sans-serif; }
  .step-list strong { font-size:1.07rem; }
  .step-list p { margin:.3rem 0 0; font-size:.95rem; line-height:1.65; }
  .controls { padding:.6rem 1.5rem 1.2rem; }
  .controls[hidden] { display:none; }
  .transport { display:flex; gap:.5rem; }
  button { min-height:44px; min-width:44px; padding:.6rem .9rem; border-radius:.7rem; border:1px solid #aec5b6; background:#fff; color:#254f48; font:600 .85rem/1.3 system-ui,sans-serif; cursor:pointer; }
  [data-action=play] { background:#254f48; color:#fff; flex:1; }
  button:focus-visible { outline:3px solid #bb7b32; outline-offset:3px; }
  button:disabled { opacity:.45; cursor:default; }
  .position { margin:.8rem 0 .2rem; font-size:.8rem; font-weight:700; }
  .motion-help { margin:0; font-size:.78rem; color:#52685e; }
  figcaption { padding:1rem 1.5rem; border-top:1px solid #d4dfd4; font-size:.8rem; line-height:1.6; }
  .hand,.head,.water,.entry,.mat,.supplies,.exit,.space-ring,.pause-mark,.exit-arrow,.zone { transition:opacity .7s ease,transform .9s ease; transform-box:fill-box; transform-origin:center; }
  [data-variant=pausa][data-step='0'] .head { transform:rotate(-7deg); }
  .space-ring,.pause-mark,.exit-arrow { opacity:0; }
  [data-variant=pausa]:is([data-step='1'],[data-step='2'],[data-step='3']) .water { opacity:0; transform:translateY(-15px); }
  [data-variant=pausa]:is([data-step='1'],[data-step='2'],[data-step='3']) .pause-mark { opacity:1; }
  [data-variant=pausa]:is([data-step='2'],[data-step='3']) .hand { opacity:0; transform:translate(70px,-35px); }
  [data-variant=pausa]:is([data-step='2'],[data-step='3']) .space-ring { opacity:1; }
  [data-variant=pausa][data-step='3'] .exit-arrow { opacity:1; }
  [data-variant=espacio] .mat,[data-variant=espacio] .supplies,[data-variant=espacio] .exit { opacity:.08; transform:translateY(14px); }
  [data-variant=espacio]:is([data-step='1'],[data-step='2'],[data-step='3']) .mat { opacity:1; transform:none; }
  [data-variant=espacio]:is([data-step='2'],[data-step='3']) .supplies { opacity:1; transform:none; }
  [data-variant=espacio][data-step='3'] .exit { opacity:1; transform:none; }
  .zone { opacity:.08; }
  .zone circle,.zone ellipse { fill:#f4ca6a66; stroke:#a36a20; stroke-width:2; stroke-dasharray:5 4; }
  .cloth { fill:#79b9af; stroke:#28594f; stroke-width:2; }
  [data-step='0'] .zone-0,[data-step='1'] .zone-1,[data-step='2'] .zone-2,[data-step='3'] .zone-3 { opacity:1; }
  [data-playing=true][data-step='0'] .zone-0 .cloth,[data-playing=true][data-step='1'] .zone-1 .cloth,[data-playing=true][data-step='2'] .zone-2 .cloth,[data-playing=true][data-step='3'] .zone-3 .cloth { animation:wipe 2s ease-in-out 2; }
  [data-step='0'] [data-pip='0'],[data-step='1'] [data-pip='1'],[data-step='2'] [data-pip='2'],[data-step='3'] [data-pip='3'] { fill:#254f48; }
  @keyframes wipe { 0%,100% { transform:translateX(-5px); } 50% { transform:translateX(7px); } }
  @media(prefers-reduced-motion:reduce) { *,*::before,*::after { animation:none!important; transition:none!important; } }
  @media(max-width:480px) { header { padding:1.1rem 1rem .5rem; } .canvas { padding:.25rem; } .controls,.step-list { padding-inline:1rem; } figcaption { padding:1rem; } }
  @media print { .controls { display:none; } .step-list li[hidden] { display:flex!important; } .lesson { break-inside:avoid; box-shadow:none; } }
</style>
