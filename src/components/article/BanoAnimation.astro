---
interface Props { variant: 'pausa' | 'espacio' | 'zonas'; }
const { variant } = Astro.props;
const scenes = {
  pausa: {
    title: 'Lee el cambio. Dale espacio.', kicker: '01 / La pausa también es cuidado',
    note: 'Una secuencia orientativa de manejo; no todos los perros avisan igual. Si hay dolor nuevo, consulta antes de reintentar.',
    steps: [
      ['Observa', 'Si se tensa, gira la cabeza o intenta salir, deja de avanzar. Una señal aislada necesita contexto.'],
      ['Detén', 'Cierra el agua y suspende el contacto. No aumentes la sujeción para terminar.'],
      ['Da espacio', 'Retira las manos y permite una salida segura sobre suelo con tracción. No lo persigas.'],
      ['Reevalúa', 'Decide si el aseo puede esperar. Si queda champú y no puedes retirarlo con seguridad, pide orientación veterinaria.'],
    ],
  },
  espacio: {
    title: 'Construye un baño que pueda recorrer.', kicker: '02 / Primero el espacio, después el agua',
    note: 'Adapta la superficie y el acceso a tu perro. Una esterilla no compensa dolor, debilidad ni una entrada peligrosa.',
    steps: [
      ['Entrada seca', 'Despeja el paso. Evita que tenga que saltar o girar en un espacio estrecho.'],
      ['Tracción', 'Coloca una esterilla estable en la ducha y comprueba que sus bordes no se levantan.'],
      ['Todo al alcance', 'Deja producto indicado, paños y toallas a mano. No abandones al perro para buscarlos.'],
      ['Salida preparada', 'Reserva un lugar seco, próximo y sin obstáculos para terminar el secado y descansar.'],
    ],
  },
  zonas: {
    title: 'Limpia lo necesario. Cambia de paño.', kicker: '03 / El mapa del aseo localizado',
    note: 'El mapa indica zonas externas, no técnicas de exploración. No levantes extremidades doloridas ni frotes piel lesionada.',
    steps: [
      ['Patas', 'Retira suciedad superficial si tolera el contacto. Evita levantar la pata para buscar una postura perfecta.'],
      ['Zona posterior', 'Usa material distinto para el periné externo. No arrastres suciedad hacia otras zonas.'],
      ['Pliegues', 'Revisa solo lo accesible sin forzar. Si hay dolor, herida, olor persistente o secreción, consulta.'],
      ['Secado', 'Retira humedad con una toalla suave, sin frotar. Termina antes si deja de tolerarlo.'],
    ],
  },
};
const scene = scenes[variant];
const uid = `bano-${variant}`;
---

<div data-bano-sequence data-variant={variant} data-step="0" data-playing="false">
  <section class="lesson" aria-labelledby={`${uid}-title`}>
    <header><p class="kicker">{scene.kicker}</p><h3 id={`${uid}-title`}>{scene.title}</h3></header>
    <div class="canvas">
      <div class="scene-label" aria-hidden="true">
        <span class="live-dot"></span><span>{variant === 'pausa' ? 'Observar · detener · dar espacio' : variant === 'espacio' ? 'Preparar antes de empezar' : 'Una zona cada vez'}</span>
        <span class="senior-tag">Dogo senior</span>
      </div>
      <svg viewBox="0 0 760 420" role="img" aria-labelledby={`${uid}-svg-title ${uid}-desc`}>
        <title id={`${uid}-svg-title`}>{scene.title}</title>
        <desc id={`${uid}-desc`}>Ilustración realista del mismo dogo argentino de edad avanzada: orejas naturales, expresión envejecida y menor tono muscular. {scene.steps.map(s => s.join(': ')).join('. ')}</desc>
        <defs>
          <pattern id={`${uid}-mat`} width="14" height="14" patternUnits="userSpaceOnUse"><path d="M0 7h14M7 0v14" stroke="#fff" stroke-opacity=".28" stroke-width="1.5"/></pattern>
          <linearGradient id={`${uid}-room`} x2="0" y2="1"><stop stop-color="#e7eee6"/><stop offset="1" stop-color="#f9f6ed"/></linearGradient>
          <linearGradient id={`${uid}-cloth`} x2="1" y2="1"><stop stop-color="#faf1da"/><stop offset="1" stop-color="#cfb989"/></linearGradient>
        </defs>
        <rect width="760" height="420" rx="18" fill={`url(#${uid}-room)`}/>
        <path d="M30 345H730" stroke="#c4d0c0" stroke-width="2"/>
        <g class="room-lines" stroke="#cfdbcd" stroke-width="1.5" fill="none"><path d="M45 345V30M715 345V30"/><path d="M45 305H715" stroke-dasharray="2 8"/></g>
        <g class="mat">
          <rect x="136" y="321" width="493" height="37" rx="18" fill="#276d5c"/>
          <rect x="136" y="321" width="493" height="37" rx="18" fill={`url(#${uid}-mat)`}/>
        </g>
        <ellipse cx="382" cy="333" rx="209" ry="15" fill="#2e503c" opacity=".1"/>
        <image class="senior-dog" href="/images/blog/banar-perro-viejo-movilidad-reducida/dogo-argentino-senior-perfil.webp" x="125" y="45" width="510" height="300" preserveAspectRatio="xMidYMid meet"/>
        {variant === 'pausa' && <>
          <g class="observe-ring"><circle cx="544" cy="150" r="61" fill="none" stroke="#bd8e4b" stroke-width="2" stroke-dasharray="5 6"/><circle cx="594" cy="107" r="16" fill="#fff8e9" stroke="#bd8e4b" stroke-width="2"/><path d="M594 99v10m0 6v1" stroke="#99692e" stroke-width="3" stroke-linecap="round"/></g>
          <g class="water">
            <path d="M342 38q-12-15-23-4l-17 22" fill="none" stroke="#527369" stroke-width="8" stroke-linecap="round"/>
            <path d="m288 56 29 16" stroke="#527369" stroke-width="11" stroke-linecap="round"/>
            <g class="drops" stroke="#649fa3" stroke-width="3" stroke-linecap="round"><path d="M289 77l-8 18m22-10-7 18m-7 0-8 18m-10-16-6 15m34-9-5 15"/></g>
          </g>
          <g class="touch-icon" fill="none" stroke="#8b6a4f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <rect x="636" y="124" width="75" height="75" rx="20" fill="#fff9ee" stroke="#d9c9ac"/>
            <path d="M656 171v-22q0-7 6-7t6 7v12-27q0-7 6-7t6 7v27-20q0-7 6-7t6 7v30q0 15-15 15h-8q-11 0-15-12l-7-12q-3-6 2-8t8 5" transform="translate(0 2) scale(.99)"/>
          </g>
          <g class="pause-mark"><circle cx="336" cy="77" r="30" fill="#faf2e2" stroke="#b78b4e" stroke-width="2"/><path d="M328 64v26M345 64v26" stroke="#9e6b30" stroke-width="6" stroke-linecap="round"/></g>
          <g class="space-ring"><rect x="93" y="59" width="575" height="310" rx="120" fill="none" stroke="#50856a" stroke-width="2.5" stroke-dasharray="8 8"/></g>
          <g class="exit-arrow"><path d="M555 388H690m-17-13 17 13-17 13" fill="none" stroke="#28654f" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></g>
        </>}
        {variant === 'espacio' && <>
          <g class="entry" stroke="#876844" stroke-width="3" fill="none"><rect x="37" y="146" width="66" height="111" rx="9" fill="#fdf9ef" stroke="#d7cbb6"/><path d="M52 244v-81h36v81M79 204h1"/><path d="M43 383H127m-13-10 13 10-13 10" stroke="#739477" stroke-linecap="round"/></g>
          <g class="supplies"><rect x="645" y="194" width="80" height="7" rx="3" fill="#9c8061"/><rect x="651" y="146" width="27" height="48" rx="7" fill="#477865"/><path d="M658 146v-11h27" stroke="#385e4e" stroke-width="5" fill="none"/><rect x="686" y="164" width="29" height="30" rx="6" fill="#e2ceaa"/><path d="M690 174h20m-20 10h20" stroke="#bca17c" stroke-width="2"/></g>
          <g class="exit"><rect x="526" y="375" width="181" height="26" rx="13" fill="#cbb887"/><path d="M542 388h147" stroke="#f5e8c9" stroke-width="3"/><path d="M545 377v22m9-22v22m135-22v22m-9-22v22" stroke="#9b895e" stroke-width="2"/></g>
        </>}
        {variant === 'zonas' && <>
          <g class="zone-focus">
            <circle class="zone-halo" r="37" fill="#f3d58a" fill-opacity=".2" stroke="#b88b3a" stroke-width="2" stroke-dasharray="5 5"/>
            <circle r="5" fill="#b38332" stroke="#fff" stroke-width="2"/>
            <g class="cloth"><path d="M12-24h43l6 32-44 6z" fill={`url(#${uid}-cloth)`} stroke="#a58d63" stroke-width="1.5"/><path d="m20-17 31-1m-30 7 31-2m-30 8 32-3M24-23l4 32" fill="none" stroke="#fffaf0" stroke-width="2"/></g>
          </g>
          <g class="dry-sparkles" stroke="#c09b4c" stroke-width="2" stroke-linecap="round"><path d="M395 105v18m-9-9h18M440 86v14m-7-7h14M361 144v12m-6-6h12"/></g>
        </>}
      </svg>
      <div class="scene-progress" aria-hidden="true">{scene.steps.map(([label],i) => <span data-pip={i}><i></i><span>{label}</span></span>)}</div>
    </div>
    <ol class="step-list">{scene.steps.map(([title, text], i) => <li data-panel={i}><span class="ordinal">0{i+1}</span><div><strong>{title}</strong><p>{text}</p></div></li>)}</ol>
    <div class="controls" hidden>
      <div class="transport"><button type="button" data-action="prev" aria-label="Paso anterior">←</button><button type="button" data-action="play">Reproducir secuencia</button><button type="button" data-action="next" aria-label="Paso siguiente">→</button></div>
      <p class="position" aria-live="polite" aria-atomic="true"></p>
      <p class="motion-help">También puedes recorrerla paso a paso, sin reproducción.</p>
    </div>
    <p class="lesson-note">{scene.note} Ilustración generada con IA; no es una fotografía clínica.</p>
  </section>
</div>

<script>
  class BanoSequence {
    constructor(private root: HTMLElement) {}
    private step = 0;
    private timer: ReturnType<typeof setTimeout> | undefined;
    private playing = false;
    private reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    private aborter = new AbortController();
    connectedCallback() {
      this.root.querySelector<HTMLElement>('.controls')!.hidden = false;
      this.root.dataset.enhanced = 'true';
      this.root.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button => button.addEventListener('click', () => {
        const action = button.dataset.action;
        if (action === 'play') {
          if (this.playing) this.stop();
          else {
            if (this.step === 3) this.step = 0;
            this.playing = true; this.render(); this.schedule();
          }
        } else { this.stop(); this.step = Math.max(0, Math.min(3, this.step + (action === 'next' ? 1 : -1))); this.render(); }
      }, { signal: this.aborter.signal }));
      this.reduced.addEventListener('change', this.preference, { signal: this.aborter.signal });
      document.addEventListener('visibilitychange', this.visibility, { signal: this.aborter.signal });
      this.preference(); this.render();
    }
    private preference = () => {
      if (this.reduced.matches) this.stop();
      this.root.querySelector<HTMLButtonElement>('[data-action="play"]')!.disabled = this.reduced.matches;
      this.root.querySelector<HTMLElement>('.motion-help')!.textContent = this.reduced.matches ? 'Movimiento reducido: utiliza las flechas para ver cada paso sin animación.' : 'También puedes recorrerla paso a paso, sin reproducción.';
    };
    private visibility = () => { if (document.hidden) this.stop(); };
    private schedule() {
      this.timer = setTimeout(() => {
        if (!this.root.isConnected || !this.playing) return;
        if (this.step < 3) { this.step++; this.render(); this.schedule(); }
        else this.stop();
      }, 5500);
    }
    private stop() { clearTimeout(this.timer); this.playing = false; this.render(); }
    private render() {
      this.root.dataset.step = String(this.step); this.root.dataset.playing = String(this.playing);
      this.root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel, index) => panel.dataset.active = String(index === this.step));
      const label = this.root.querySelector<HTMLElement>('.position')!;
      label.setAttribute('aria-live', this.playing ? 'off' : 'polite');
      label.textContent = `Paso ${this.step+1} de 4`;
      this.root.querySelector<HTMLButtonElement>('[data-action="play"]')!.textContent = this.playing ? 'Pausar' : this.step === 3 ? 'Repetir secuencia' : 'Reproducir secuencia';
      this.root.querySelector<HTMLButtonElement>('[data-action="prev"]')!.disabled = this.step === 0;
      this.root.querySelector<HTMLButtonElement>('[data-action="next"]')!.disabled = this.step === 3;
    }
    disconnectedCallback() { clearTimeout(this.timer); this.aborter.abort(); }
  }
  const instances = new Map<HTMLElement, BanoSequence>();
  function initialize() {
    document.querySelectorAll<HTMLElement>('[data-bano-sequence]').forEach(root => {
      if (instances.has(root)) return;
      const instance = new BanoSequence(root);
      instances.set(root, instance);
      instance.connectedCallback();
    });
  }
  document.addEventListener('astro:before-swap', () => {
    instances.forEach(instance => instance.disconnectedCallback());
    instances.clear();
  });
  document.addEventListener('astro:page-load', initialize);
  initialize();
</script>

<style>
  [data-bano-sequence] { display:block; margin:2.5rem 0; color:#294b3d; }
  .lesson { margin:0; background:#fcfcf7; border:1px solid #c5d1bd; border-radius:1.4rem; overflow:hidden; box-shadow:0 12px 38px #193d2710; color:#294b3d; }
  .lesson header { padding:1.5rem 1.5rem .9rem; }
  .lesson .kicker { color:#536d51!important; font:700 .7rem/1.5 system-ui,sans-serif; text-transform:uppercase; letter-spacing:.1em; margin:0 0 .6rem; }
  .lesson header h3 { margin:0; color:#294b3d!important; font:700 clamp(1.15rem,3vw,1.65rem)/1.3 system-ui,sans-serif; letter-spacing:-.025em; }
  .canvas { margin:0 1rem; border-radius:1rem; overflow:hidden; background:#e7eee6; }
  .scene-label { display:flex; align-items:center; gap:.45rem; padding:.8rem 1rem .3rem; color:#466449; font:600 .66rem/1.5 system-ui,sans-serif; }
  .live-dot { width:6px; height:6px; border-radius:50%; background:#6c8b60; flex-shrink:0; }
  .senior-tag { margin-left:auto; border:1px solid #aebfa2; border-radius:1rem; padding:.15rem .5rem; white-space:nowrap; font-size:.6rem; }
  .canvas svg { display:block; width:100%; height:auto; }
  .scene-progress { display:flex; gap:.5rem; padding:.1rem 1rem 1rem; }
  .scene-progress>span { flex:1; display:flex; flex-direction:column; gap:.35rem; min-width:0; color:#52694b; font:500 .6rem/1.4 system-ui,sans-serif; }
  .scene-progress i { height:3px; border-radius:4px; background:#c0cfb9; }
  [data-step='0'] [data-pip='0'] i,[data-step='1'] [data-pip='1'] i,[data-step='2'] [data-pip='2'] i,[data-step='3'] [data-pip='3'] i { background:#355e41; }
  .lesson .step-list { padding:0 1.5rem; margin:.6rem 0; list-style:none; }
  .lesson .step-list li { display:flex; align-items:flex-start; gap:1rem; padding:.8rem 0; margin:0; }
  .lesson .step-list li[data-active='false'] { display:none; }
  .ordinal { flex:0 0 2.5rem; height:2.5rem; display:grid; place-items:center; border-radius:.8rem; background:#e4ecdb; color:#355a3d; font:700 .9rem system-ui,sans-serif; }
  .lesson .step-list strong { color:#294b3d!important; font-size:1.07rem; }
  .lesson .step-list p { color:#3f5844; margin:.3rem 0 0; font-size:.95rem; line-height:1.65; }
  .controls { padding:.6rem 1.5rem 1.2rem; }
  .controls[hidden] { display:none; }
  .transport { display:flex; gap:.5rem; }
  button { min-height:44px; min-width:44px; padding:.65rem .9rem; border-radius:.7rem; border:1px solid #aec1a6; background:#fff; color:#294b3d; font:600 .85rem/1.3 system-ui,sans-serif; cursor:pointer; }
  [data-action=play] { background:#355b40; color:#fff; flex:1; }
  button:focus-visible { outline:3px solid #a57227; outline-offset:3px; }
  button:disabled { opacity:.45; cursor:default; }
  .lesson .position { color:#3f5844; margin:.8rem 0 .2rem; font-size:.8rem; font-weight:700; }
  .lesson .motion-help { margin:0; font-size:.78rem; color:#52634c; }
  .lesson .lesson-note { margin:0;  color:#52634c; padding:1rem 1.5rem; border-top:1px solid #d8e0ce; font-size:.8rem; line-height:1.6; }
  .touch-icon,.water,.entry,.mat,.supplies,.exit,.space-ring,.pause-mark,.exit-arrow,.observe-ring,.dry-sparkles { transition:opacity .6s ease,transform .9s ease; transform-box:fill-box; transform-origin:center; }
  .space-ring,.pause-mark,.exit-arrow { opacity:0; }
  [data-variant=pausa]:is([data-step='1'],[data-step='2'],[data-step='3']) .water { opacity:0; transform:translateY(-15px); }
  [data-variant=pausa]:is([data-step='1'],[data-step='2'],[data-step='3']) .pause-mark { opacity:1; }
  [data-variant=pausa]:is([data-step='2'],[data-step='3']) .touch-icon { opacity:0; transform:translateX(60px); }
  [data-variant=pausa]:is([data-step='2'],[data-step='3']) .space-ring { opacity:1; }
  [data-variant=pausa]:is([data-step='1'],[data-step='2'],[data-step='3']) .observe-ring { opacity:0; }
  [data-variant=pausa][data-step='3'] .exit-arrow { opacity:1; }
  [data-variant=espacio] .mat,[data-variant=espacio] .supplies,[data-variant=espacio] .exit { opacity:.05; transform:translateY(15px); }
  [data-variant=espacio]:is([data-step='1'],[data-step='2'],[data-step='3']) .mat { opacity:1; transform:none; }
  [data-variant=espacio]:is([data-step='2'],[data-step='3']) .supplies { opacity:1; transform:none; }
  [data-variant=espacio][data-step='3'] .exit { opacity:1; transform:none; }
  .zone-focus { transform:translate(510px,310px); transition:transform 1s cubic-bezier(.2,.7,.3,1); }
  [data-step='1'] .zone-focus { transform:translate(260px,195px); }
  [data-step='2'] .zone-focus { transform:translate(490px,206px); }
  [data-step='3'] .zone-focus { transform:translate(384px,171px); }
  .dry-sparkles { opacity:0; }
  [data-step='3'] .dry-sparkles { opacity:1; }
  [data-playing=true] .drops { animation:water-fall 1s linear 4; }
  [data-playing=true] .zone-focus .cloth { animation:cloth-blot 1.5s ease-in-out 3; }
  [data-playing=false] .zone-focus .cloth { animation-play-state:paused; }
  @keyframes water-fall { from { transform:translateY(-3px); opacity:.4; } to { transform:translateY(7px); opacity:1; } }
  @keyframes cloth-blot { 0%,100% { transform:translate(3px,-2px); } 50% { transform:translate(-5px,2px); } }
  @media(prefers-reduced-motion:reduce) { *,*::before,*::after { animation:none!important; transition:none!important; } }
  @media(max-width:480px) { .lesson header { padding:1.2rem 1rem .8rem; } .canvas { margin:0 .6rem; } .scene-label { padding:.6rem .6rem .1rem; font-size:.6rem; } .scene-progress { padding:.2rem .7rem .7rem; gap:.35rem; } .scene-progress>span { font-size:.58rem; } .controls,.lesson .step-list { padding-inline:1rem; } .lesson .lesson-note { margin:0;  padding:1rem; } }
  @media print { .controls { display:none; } .lesson .step-list li[data-active='false'] { display:flex!important; } .lesson { break-inside:avoid; box-shadow:none; } }
</style>
