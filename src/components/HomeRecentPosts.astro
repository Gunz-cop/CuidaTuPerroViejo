---
interface Props {
  posts: any[];
}

const { posts = [] } = Astro.props;
---

{posts.length > 0 && (
  <section class="bg-brand-card/25 border-y border-brand-border py-16 md:py-24 reveal-on-scroll">
    <div class="max-w-5xl mx-auto px-5 md:px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold tracking-wider uppercase text-brand-primary mb-2 block">Información práctica</span>
        <h2 class="text-2.5xl md:text-3.5xl font-bold text-brand-text mb-4">Últimos artículos del blog</h2>
        <p class="text-sm text-brand-muted font-light leading-relaxed">
          Lee nuestras últimas publicaciones y guías detalladas para el cuidado del perro senior.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a
            href={`/${post.data.pilar}/${post.slug}`}
            class="group flex flex-col justify-between bg-brand-card border border-brand-border rounded-3xl p-6 shadow-sm hover:shadow-md hover:border-brand-primary/40 hover:scale-[1.01] transition-all duration-300 relative overflow-hidden"
          >
            <div class="absolute top-0 left-0 right-0 h-1 bg-brand-primary transform -translate-y-1 group-hover:translate-y-0 transition-transform duration-300"></div>
            <div>
              <span class="text-[10px] font-bold text-brand-primary uppercase tracking-wider block mb-2 opacity-80">
                Guía especializada
              </span>
              <h3 class="text-lg font-bold text-brand-text group-hover:text-brand-primary transition-colors duration-200 line-clamp-2 leading-snug">
                {post.data.title}
              </h3>
              {post.data.metaDescription && (
                <p class="text-brand-muted text-xs mt-3 line-clamp-3 leading-relaxed font-light">
                  {post.data.metaDescription}
                </p>
              )}
            </div>
            <div class="mt-6 flex items-center text-xs font-semibold text-brand-primary group-hover:text-brand-primary-hover transition-colors duration-200">
              <span>Leer artículo</span>
              <span class="material-symbols-outlined text-xs ml-1 transform group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
