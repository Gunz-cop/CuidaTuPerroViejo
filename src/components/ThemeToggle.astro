---
---
<button
  data-theme-toggle
  type="button"
  class="relative inline-flex items-center justify-center p-2 rounded-xl text-brand-muted hover:text-brand-primary hover:bg-brand-secondary/35 focus:outline-none transition-all duration-200 group"
  aria-label="Alternar tema oscuro y claro"
>
  <!-- Sun Icon (visible in dark mode) -->
  <svg
    data-theme-light-icon
    class="w-5 h-5 hidden transform group-hover:rotate-45 transition-transform duration-300"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
  </svg>
  
  <!-- Moon Icon (visible in light mode) -->
  <svg
    data-theme-dark-icon
    class="w-5 h-5 hidden transform group-hover:-rotate-12 transition-transform duration-300"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const themeToggleButtons = document.querySelectorAll('[data-theme-toggle]');

    function updateToggleIcon() {
      themeToggleButtons.forEach((button) => {
        const themeToggleLightIcon = button.querySelector('[data-theme-light-icon]');
        const themeToggleDarkIcon = button.querySelector('[data-theme-dark-icon]');

        if (document.documentElement.classList.contains('dark')) {
          themeToggleLightIcon?.classList.remove('hidden');
          themeToggleDarkIcon?.classList.add('hidden');
        } else {
          themeToggleLightIcon?.classList.add('hidden');
          themeToggleDarkIcon?.classList.remove('hidden');
        }
      });
    }

    // Set initial icon state on load
    updateToggleIcon();

    themeToggleButtons.forEach((themeToggleBtn) => {
      if (themeToggleBtn.dataset.themeToggleReady === 'true') return;
      themeToggleBtn.dataset.themeToggleReady = 'true';

      themeToggleBtn.addEventListener('click', function() {
        // Toggle class on root HTML
        const isDark = document.documentElement.classList.toggle('dark');

        // Save state
        localStorage.setItem('theme', isDark ? 'dark' : 'light');

        // Update icons
        updateToggleIcon();
      });
    });
  }

  // Run on page load
  setupThemeToggle();

  // Run on view transitions if active in the future
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
