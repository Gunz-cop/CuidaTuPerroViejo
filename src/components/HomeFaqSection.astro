---
import FAQ from './FAQ.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items = [] } = Astro.props;
---

<section class="max-w-3xl mx-auto px-5 py-8 reveal-on-scroll">
  <FAQ items={items} title="Preguntas frecuentes" />
</section>
