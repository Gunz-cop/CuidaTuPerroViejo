---
interface Props {
  type?: 'info' | 'warning' | 'danger';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const styles = {
  info: {
    wrapper: 'border-brand-primary/25 border-l-brand-primary bg-brand-secondary/30 text-brand-text',
    badge: 'bg-brand-primary/10 text-brand-primary',
  },
  warning: {
    wrapper: 'border-amber-500/35 border-l-amber-500 bg-amber-100/60 text-brand-text dark:bg-amber-950/20',
    badge: 'bg-amber-500/15 text-amber-700 dark:text-amber-300',
  },
  danger: {
    wrapper: 'border-red-500/35 border-l-red-500 bg-red-100/60 text-brand-text dark:bg-red-950/20',
    badge: 'bg-red-500/15 text-red-700 dark:text-red-300',
  },
}[type];
---

<aside class={`my-6 rounded-2xl border border-l-4 p-5 shadow-sm ${styles.wrapper}`}>
  {title && (
    <h3 data-toc-exclude="true" class={`mb-3 inline-block rounded-xl px-3 py-1 text-xs font-bold uppercase tracking-wider leading-relaxed ${styles.badge}`}>
      {title}
    </h3>
  )}
  <div class="text-sm leading-relaxed text-brand-text [&_a]:font-semibold [&_a]:text-brand-primary [&_a]:underline [&_a]:decoration-dotted [&_a]:underline-offset-4 [&_p:first-child]:mt-0 [&_p:last-child]:mb-0">
    <slot />
  </div>
</aside>
