---
import EmergencyGeoWidget from './EmergencyGeoWidget.astro';

const warningSigns = [
  'Dificultad para respirar, colapso repentino o dolor intenso.',
  'Convulsiones, pérdida de conocimiento o desorientación severa repentina.',
  'Vómitos repetidos, abdomen muy distendido o incapacidad para retener agua.',
  'Sangrado abundante o una herida profunda que no deja de sangrar al aplicar presión.',
];
---

<aside id="urgencias" class="scroll-mt-28 rounded-[1.75rem] border border-amber-300/70 bg-amber-50 p-5 shadow-sm dark:border-amber-800/60 dark:bg-amber-950/25 sm:p-7" aria-labelledby="emergency-title">
  <div class="flex items-start gap-4">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-600 text-white" aria-hidden="true">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z"></path>
        <path d="M12 9v4"></path><path d="M12 17h.01"></path>
      </svg>
    </span>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-300">Urgencias veterinarias</p>
      <h3 id="emergency-title" class="mt-1.5 text-xl font-bold text-brand-text sm:text-2xl">Señales para actuar sin demora</h3>
    </div>
  </div>

  <p class="mt-5 text-sm leading-6 text-brand-muted">
    Acude a un centro veterinario de urgencias si observas cualquiera de estas señales. Si dudas y tu perro empeora rápidamente, llama antes de desplazarte.
  </p>

  <ul class="mt-5 grid gap-3">
    {warningSigns.map((sign) => (
      <li class="flex gap-3 rounded-xl border border-amber-200/80 bg-white/55 px-3.5 py-3 text-sm leading-6 text-brand-text dark:border-amber-900/60 dark:bg-amber-950/20">
        <svg class="mt-1 h-4 w-4 shrink-0 text-amber-700 dark:text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v4"></path><path d="M12 16h.01"></path><circle cx="12" cy="12" r="9"></circle></svg>
        <span>{sign}</span>
      </li>
    ))}
  </ul>

  <EmergencyGeoWidget />
</aside>
