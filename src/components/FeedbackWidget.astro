---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="feedback-widget my-12 p-6 md:p-8 bg-brand-card/40 dark:bg-slate-900/20 border border-brand-border/60 rounded-3xl shadow-sm text-center max-w-xl mx-auto" data-slug={slug}>
  <!-- Prompt State -->
  <div data-feedback-prompt class="transition-opacity duration-300">
    <h3 class="text-lg font-bold text-brand-text mb-2 font-serif">¿Te ha resultado útil esta guía?</h3>
    <p class="text-xs text-brand-muted mb-5 font-light">Tu valoración nos ayuda a mejorar y a priorizar el contenido especializado.</p>
    
    <div class="flex justify-center items-center gap-4">
      <button 
        data-feedback-yes
        class="px-6 py-3 bg-brand-primary/10 hover:bg-brand-primary/20 text-brand-primary font-bold rounded-xl text-sm transition-all duration-200 cursor-pointer inline-flex items-center gap-2 active:scale-[0.97] border border-brand-primary/10 hover:border-brand-primary/30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2m0 10V10" />
        </svg>
        <span>Sí, me sirvió</span>
      </button>
      
      <button 
        data-feedback-no
        class="px-6 py-3 bg-brand-secondary/5 hover:bg-brand-secondary/15 text-brand-secondary dark:bg-brand-accent/10 dark:hover:bg-brand-accent/15 dark:text-brand-accent font-bold rounded-xl text-sm transition-all duration-200 cursor-pointer inline-flex items-center gap-2 active:scale-[0.97] border border-brand-secondary/10 hover:border-brand-secondary/30 dark:border-brand-accent/25 dark:hover:border-brand-accent/40"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2m0-10v10" />
        </svg>
        <span>No del todo</span>
      </button>
    </div>
  </div>
  
  <!-- Thanks State (Hidden initially) -->
  <div data-feedback-thanks class="hidden transition-opacity duration-300 flex flex-col items-center">
    <div class="w-12 h-12 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 text-xl">
      🐾
    </div>
    <h4 class="text-base font-bold text-brand-text mb-1 font-serif">¡Muchas gracias por tu valoración!</h4>
    <p data-feedback-stats class="text-xs text-brand-muted font-light leading-relaxed"></p>
  </div>
</div>

<script>
  // Script del lado del cliente
  const initFeedbackWidget = () => {
    document.querySelectorAll('.feedback-widget').forEach((widget) => {
      if (widget.dataset.feedbackReady === 'true') return;
      widget.dataset.feedbackReady = 'true';

      const slug = widget.getAttribute('data-slug');
      const promptDiv = widget.querySelector('[data-feedback-prompt]');
      const thanksDiv = widget.querySelector('[data-feedback-thanks]');
      const statsPara = widget.querySelector('[data-feedback-stats]');
      const btnYes = widget.querySelector('[data-feedback-yes]');
      const btnNo = widget.querySelector('[data-feedback-no]');

      if (!slug || !promptDiv || !thanksDiv || !statsPara || !btnYes || !btnNo) return;

      const storageKey = `voted-feedback-${slug}`;
      const hasVoted = localStorage.getItem(storageKey);

      // Cargar estadísticas
      const loadStats = async (showThanks = false) => {
        try {
          const res = await fetch(`/api/feedback?slug=${slug}`);
          if (res.ok) {
            const data = await res.json();
            const yesCount = data.yes || 0;
            if (yesCount > 0) {
              statsPara.textContent = `A ${yesCount} persona${yesCount !== 1 ? 's' : ''} le${yesCount !== 1 ? 's' : ''} ha sido útil esta guía para cuidar a su perro.`;
            } else {
              statsPara.textContent = 'Sé la primera persona en valorar este artículo.';
            }
          }
        } catch (e) {
          console.error('Error cargando estadísticas de feedback:', e);
        }

        if (showThanks) {
          promptDiv.classList.add('hidden');
          thanksDiv.classList.remove('hidden');
        }
      };

      // Si ya votó anteriormente, mostramos agradecimiento directo y cargamos estadísticas
      if (hasVoted) {
        loadStats(true);
      } else {
        // Si no ha votado, cargamos el conteo silenciosamente en segundo plano
        loadStats(false);
      }

      const resetButtons = () => {
        btnYes.removeAttribute('disabled');
        btnNo.removeAttribute('disabled');
        btnYes.classList.remove('opacity-50', 'pointer-events-none');
        btnNo.classList.remove('opacity-50', 'pointer-events-none');
      };

      const handleVote = async (type) => {
        // Deshabilitar botones optimistamente
        btnYes.setAttribute('disabled', 'true');
        btnNo.setAttribute('disabled', 'true');
        btnYes.classList.add('opacity-50', 'pointer-events-none');
        btnNo.classList.add('opacity-50', 'pointer-events-none');

        try {
          const res = await fetch('/api/feedback', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ slug, type }),
          });

          if (res.ok) {
            localStorage.setItem(storageKey, type);
            await loadStats(true);
          } else {
            console.error('Fallo al registrar voto.');
            resetButtons();
          }
        } catch (error) {
          console.error('Error registrando voto:', error);
          resetButtons();
        }
      };

      btnYes.addEventListener('click', () => handleVote('yes'));
      btnNo.addEventListener('click', () => handleVote('no'));
    });
  };

  // Ejecutar al cargar la página
  document.addEventListener('DOMContentLoaded', initFeedbackWidget);
  // Soporte para transiciones de página de Astro (si se usan en el futuro)
  document.addEventListener('astro:page-load', initFeedbackWidget);
</script>
