{
  "name": "cuida-tu-perro-viejo",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "npx tsx lib/discovery/run.ts",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "check": "astro check",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "types:worker": "wrangler types --env-file wrangler-types.env --strict-vars=false",
    "audit:migration": "node scripts/audit-specs-migracion.mjs",
    "test:assistant": "tsx scripts/test-assistant-retrieval.ts",
    "test:assistant:live": "tsx scripts/test-assistant-live.ts",
    "deploy": "npm run build && wrangler deploy",
    "sdi:run": "npx tsx lib/discovery/run.ts",
    "images:optimize": "node scripts/optimize-images.mjs --apply --delete-originals --responsive",
    "audit:seo": "node scripts/audit-seo.mjs",
    "images:optimize:dry": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "11",
    "@astrojs/mdx": "^3.1.0",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.10.0",
    "rehype-external-links": "3.0.0",
    "tailwindcss": "^3.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20260702.1",
    "sdi-cli": "^0.1.0",
    "sharp": "^0.35.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wrangler": "~4.107.0"
  }
}
