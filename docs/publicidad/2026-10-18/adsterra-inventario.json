        },
        {
          "line": 63,
          "text": "const AD_300x250_HTML = `<div class=\"ad-slot ad-slot--300x250 not-prose my-8 flex w-full justify-center\" data-ad-pending=\"true\" aria-label=\"Espacio publicitario\"><div class=\"ad-slot__placeholder flex h-[250px] w-[300px] max-w-full items-center justify-center overflow-hidden rounded-xl border border-brand-border/40 bg-brand-card/30 text-[10px] uppercase tracking-wide text-brand-muted/50\"><span aria-hidden=\"true\">Publicidad</span></div><template><script is:inline>atOptions = {'key' : '10df6b95565e4b70f014e77906b6218c','format' : 'iframe','height' : 250,'width' : 300,'params' : {}};</script><script is:inline src=\"https://www.highperformanceformat.com/10df6b95565e4b70f014e77906b6218c/invoke.js\"></script></template></div>`;"
        },
        {
          "line": 65,
          "text": "// 4. Insertar banner horizontal 320x50 (Adsterra) aprox. a la mitad del artículo,"
        },
        {
          "line": 67,
          "text": "const AD_320x50_MID_HTML = `<div class=\"ad-slot ad-slot--320x50-mid not-prose my-8 flex w-full justify-center\" data-ad-pending=\"true\" aria-label=\"Espacio publicitario\"><div class=\"ad-slot__placeholder flex h-[50px] w-[320px] max-w-full items-center justify-center overflow-hidden rounded-xl border border-brand-border/40 bg-brand-card/30 text-[10px] uppercase tracking-wide text-brand-muted/50\"><span aria-hidden=\"true\">Publicidad</span></div><template><script is:inline>atOptions = {'key' : '77fb25612074d9660a62a330b778e5ad','format' : 'iframe','height' : 50,'width' : 320,'params' : {}};</script><script is:inline src=\"https://www.highperformanceformat.com/77fb25612074d9660a62a330b778e5ad/invoke.js\"></script></template></div>`;"
        },
        {
          "line": 78,
          "text": "const withInContentAd = processedHtml.replace(/<p\\b[^>]*>[\\s\\S]*?<\\/p>/gi, (match, offset: number) => {"
        },
        {
          "line": 84,
          "text": "result += AD_300x250_HTML;"
        },
