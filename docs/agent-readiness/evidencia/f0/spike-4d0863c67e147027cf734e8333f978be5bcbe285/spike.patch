@@ -0,0 +1,109 @@
+import { handle as astroHandler } from '@astrojs/cloudflare/handler';
+
+const markdownAssets = new Map<string, string>([
+  ['/', '/agent-content/v1/documents/home.md'],
+  [
+    '/salud-perros-mayores/sindrome-cushing-perros-mayores',
+    '/agent-content/v1/documents/article--sindrome-cushing-perros-mayores.md',
+  ],
+]);
+
+function acceptedQuality(accept: string | null, mediaType: string): number | null {
+  if (accept === null || accept.trim() === '') return 1;
+  const validRanges = accept.split(',').flatMap((member, order) => {
+    const [rawType, ...parameters] = member.trim().split(';');
+    const type = rawType?.trim().toLowerCase();
+    if (!type || !/^(\*|[a-z0-9!#$&^_.+-]+)\/(\*|[a-z0-9!#$&^_.+-]+)$/.test(type)) return [];
+    if (type.startsWith('*/') && type !== '*/*') return [];
+    let q = 1;
+    for (const parameter of parameters) {
+      const pair = parameter.trim().match(/^q\s*=\s*(.*)$/i);
+      if (!pair) continue;
+      if (!/^(?:0(?:\.\d{0,3})?|1(?:\.0{0,3})?)$/.test(pair[1] ?? '')) return [];
+      q = Number(pair[1]);
+    }
+    return [{ type, q, order }];
+  });
+  if (validRanges.length === 0) return null;
+  const ranges = validRanges.flatMap(({ type, q, order }) => {
+    const [major, minor] = type.split('/');
+    const [targetMajor, targetMinor] = mediaType.split('/');
+    if (major !== '*' && major !== targetMajor) return [];
+    if (minor !== '*' && minor !== targetMinor) return [];
+    return [{ q, specificity: Number(major !== '*') + Number(minor !== '*'), order }];
+  });
+  if (ranges.length === 0) return 0;
+  const specificity = Math.max(...ranges.map((range) => range.specificity));
+  return Math.max(...ranges.filter((range) => range.specificity === specificity).map((range) => range.q));
+}
+
+function negotiate(accept: string | null): 'html' | 'markdown' | 'bad' | 'none' {
+  if (accept === null || accept.trim() === '') return 'html';
+  const htmlQ = acceptedQuality(accept, 'text/html');
+  const markdownQ = acceptedQuality(accept, 'text/markdown');
+  if (htmlQ === null && markdownQ === null) return 'bad';
+  if ((htmlQ ?? 0) === 0 && (markdownQ ?? 0) === 0) return 'none';
+  if ((markdownQ ?? 0) > (htmlQ ?? 0)) return 'markdown';
+  if ((htmlQ ?? 0) > 0) return 'html';
+  if ((markdownQ ?? 0) > 0) return 'markdown';
+  return 'none';
+}
+
+function withLocalDiagnostic(response: Response, request: Request): Response {
+  const host = new URL(request.url).hostname;
+  if (host !== '127.0.0.1' && host !== 'localhost' && host !== '[::1]') return response;
+  const headers = new Headers(response.headers);
+  headers.set('X-F0-Worker-Path', 'worker-first');
+  return new Response(response.body, { status: response.status, statusText: response.statusText, headers });
+}
+
+function matchesIfNoneMatch(request: Request, response: Response): boolean {
+  const validator = response.headers.get('ETag');
+  const condition = request.headers.get('If-None-Match');
+  if (!validator || !condition) return false;
+  if (condition.trim() === '*') return true;
+  const weakTag = (tag: string) => tag.trim().replace(/^W\//i, '');
+  return condition.split(',').some((candidate) => weakTag(candidate) === weakTag(validator));
+}
+
+function asNotModified(response: Response): Response {
+  const headers = new Headers(response.headers);
+  headers.delete('Content-Type');
+  headers.delete('Content-Length');
+  return new Response(null, { status: 304, headers });
+}
+
+export default {
+  async fetch(request: Request, env: Env, context: ExecutionContext): Promise<Response> {
+    const url = new URL(request.url);
+    const assetPath = markdownAssets.get(url.pathname);
+    if (assetPath && (request.method === 'GET' || request.method === 'HEAD')) {
+      const representation = negotiate(request.headers.get('Accept'));
+      if (representation === 'bad' || representation === 'none') {
+        const status = representation === 'bad' ? 400 : 406;
+        return withLocalDiagnostic(new Response(representation === 'bad' ? 'Invalid Accept header' : null, { status, headers: { Vary: 'Accept' } }), request);
+      }
+      if (representation === 'markdown') {
+        const assetResponse = await env.ASSETS.fetch(new Request(new URL(assetPath, url), { method: request.method }));
+        const headers = new Headers(assetResponse.headers);
+        headers.set('Vary', 'Accept');
+        headers.set('Content-Type', 'text/markdown; charset=utf-8');
+        const markdownResponse = new Response(request.method === 'HEAD' ? null : assetResponse.body, {
+          status: assetResponse.status,
+          statusText: assetResponse.statusText,
+          headers,
+        });
+        return withLocalDiagnostic(matchesIfNoneMatch(request, markdownResponse) ? asNotModified(markdownResponse) : markdownResponse, request);
+      }
+    }
+
+    const response = await astroHandler(request, env, context);
+    if (assetPath && (request.method === 'GET' || request.method === 'HEAD')) {
+      const headers = new Headers(response.headers);
+      headers.set('Vary', 'Accept');
+      const htmlResponse = new Response(response.body, { status: response.status, statusText: response.statusText, headers });
+      return withLocalDiagnostic(matchesIfNoneMatch(request, htmlResponse) ? asNotModified(htmlResponse) : htmlResponse, request);
+    }
+    return withLocalDiagnostic(response, request);
+  },
+};
