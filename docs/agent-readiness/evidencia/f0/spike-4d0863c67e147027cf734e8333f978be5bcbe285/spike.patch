+import { createHash } from 'node:crypto';
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { parse } from 'parse5';
+
+const fixtures = [
+  { path: '/', html: 'index.html', kind: 'home', id: 'home', selector: '#main-content', required: ['Ayúdale a envejecer con'] },
+  { path: '/salud-perros-mayores', html: 'salud-perros-mayores.html', kind: 'pillar', id: null, selector: 'h1 + main.health-main', required: [] },
+  { path: '/herramientas', html: 'herramientas.html', kind: 'pillar', id: null, selector: 'h1 + main', required: [] },
+  { path: '/salud-perros-mayores/sindrome-cushing-perros-mayores', html: 'salud-perros-mayores/sindrome-cushing-perros-mayores.html', kind: 'article', id: 'article--sindrome-cushing-perros-mayores', selector: 'main article', required: ['Señales de Alarma Médica Inmediata', 'Seguridad de Medicación y Riesgo de Crisis Addisoniana'] },
+  { path: '/higiene-hogar-perros-senior/incontinencia-fecal-perros-mayores', html: 'higiene-hogar-perros-senior/incontinencia-fecal-perros-senior.html', kind: 'article', id: null, selector: 'main article', required: ['Señales de alarma', 'Seguridad de manejo y medicación'] },
+  { path: '/herramientas/calculadora-calidad-vida-perros', html: 'herramientas/calculadora-calidad-vida-perros.html', kind: 'tool', id: null, selector: 'main', required: [] },
+  { path: '/herramientas/selector-movilidad-perros-mayores', html: 'herramientas/selector-movilidad-perros-mayores.html', kind: 'tool', id: null, selector: 'main', required: [] },
+];
+export const F0_SPIKE_FIXTURES = fixtures;
+
+const excludedTagNames = new Set(['nav', 'script', 'style', 'iframe']);
+const attr = (node, name) => node.attrs?.find((item) => item.name === name)?.value ?? '';
+const classList = (node) => attr(node, 'class').split(/\s+/).filter(Boolean);
+function children(node) { return node.childNodes ?? []; }
+function walk(node, fn, blocked = false) {
+  const classes = classList(node);
+  const exclude = blocked || excludedTagNames.has(node.tagName) || classes.some((name) => /^(ad-slot|feedback-widget|health-toc|toc|mobile-menu)$/.test(name)) || attr(node, 'data-ad-pending') === 'true' || attr(node, 'id') === 'mobile-menu';
+  if (!exclude) fn(node);
+  for (const child of children(node)) walk(child, fn, exclude);
+}
+function textOf(node) {
+  let value = '';
+  walk(node, (current) => { if (current.nodeName === '#text') value += `${current.value} `; });
+  return value.replace(/\s+/g, ' ').trim();
+}
+function elements(node, tagName) {
+  const result = [];
+  walk(node, (current) => { if (current.tagName === tagName) result.push(current); });
+  return result;
+}
+function byId(node, id) {
+  let found = null;
+  walk(node, (current) => { if (attr(current, 'id') === id) found = current; });
+  return found;
+}
+function hasClass(node, name) { return classList(node).includes(name); }
+function matchesSelector(ast, selector) {
+  if (selector === '#main-content') return byId(ast, 'main-content');
+  if (selector === 'h1 + main.health-main') return elements(ast, 'main').find((node) => hasClass(node, 'health-main'));
+  if (selector === 'h1 + main') return elements(ast, 'main')[0] ?? null;
+  if (selector === 'main article') return elements(ast, 'article').find((node) => elements(node, 'h1').length || elements(node, 'h2').length) ?? elements(ast, 'main')[0] ?? null;
+  if (selector === 'main') return elements(ast, 'main')[0] ?? null;
+  return null;
+}
+function normalizeLink(node) {
+  const href = attr(node, 'href');
+  const label = textOf(node);
+  return href ? { href, label } : null;
+}
+function faqPairs(root) {
+  const result = [];
+  for (const details of elements(root, 'details')) {
+    const summary = elements(details, 'summary')[0];
+    if (!summary) continue;
+    const answer = children(details).filter((child) => child !== summary).map(textOf).filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();
+    result.push({ question: textOf(summary), answer });
+  }
+  return result;
+}
+function headings(root) {
+  const result = [];
+  walk(root, (node) => {
+    if (/^h[2-4]$/.test(node.tagName ?? '')) result.push({ level: Number(node.tagName[1]), text: textOf(node) });
+  });
+  return result;
+}
+function extractFixture(fixture, html) {
+  const ast = parse(html);
+  const h1 = elements(ast, 'h1')[0] ?? null;
+  const main = matchesSelector(ast, fixture.selector);
+  const selectedText = [h1 && textOf(h1), main && textOf(main)].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();
+  const selectedLinks = [];
+  if (main) walk(main, (node) => { if (node.tagName === 'a') { const link = normalizeLink(node); if (link) selectedLinks.push(link); } });
+  const excludedNodes = [
+    { selector: 'nav', reason: 'navigation is site chrome, not page content' },
+    { selector: 'script, style, iframe', reason: 'runtime and embedded advertising code are not editorial text' },
+    { selector: '.ad-slot, [data-ad-pending="true"]', reason: 'advertising placement' },
+    { selector: '.health-toc, .toc', reason: 'repeated table of contents; heading hierarchy remains in content' },
+    { selector: '.feedback-widget', reason: 'visitor feedback control' },
+  ];
+  const warnings = elements(main ?? ast, 'aside')
+    .filter((aside) => elements(aside, 'nav').length === 0 && !classList(aside).some((name) => /toc/i.test(name)))
+    .map((aside) => ({ title: headings(aside).map((heading) => heading.text).join(' '), body: textOf(aside) }))
+    .filter((warning) => warning.body);
+  return {
+    path: fixture.path,
+    inputHtml: fixture.html,
+    sha256: createHash('sha256').update(html).digest('hex'),
+    kind: fixture.kind,
+    id: fixture.id,
+    selector: fixture.selector,
+    h1: h1 ? textOf(h1) : null,
+    orderedHeadings: headings(main ?? ast),
+    warningTexts: warnings,
+    faqPairs: faqPairs(main ?? ast),
+    sourceUrls: selectedLinks.filter(({ href }) => /^https?:/i.test(href)),
+    excludedNodes,
+    requiredSentinels: fixture.required,
+    missingSentinels: fixture.required.filter((sentinel) => !selectedText.includes(sentinel)),
+    selectedText,
+  };
+}
+export { extractFixture as inspectF0Fixture };
+
+export default function f0ContentBuildIntegration() {
+  let clientDir;
+  let rootDir;
+  let sourceConfig;
+  return {
+    name: 'f0-content-spike',
+    hooks: {
+      'astro:config:done'({ config }) {
+        clientDir = config.build.client;
+        rootDir = config.root;
+      },
+      async 'astro:build:done'({ logger }) {
+        if (process.env.F0_FAIL_GENERATOR === '1') throw new Error('F0_GENERATOR_FAILURE: intentional negative P2 run');
+        const outputRoot = new URL('./agent-content/v1/', clientDir);
+        const documentsRoot = new URL('./documents/', outputRoot);
+        await mkdir(documentsRoot, { recursive: true });
+        const extracted = [];
+        sourceConfig = JSON.parse(await readFile(new URL('./wrangler.jsonc', rootDir), 'utf8'));
+        for (const fixture of fixtures) {
+          const htmlUrl = new URL(fixture.html, clientDir);
+          const html = await readFile(htmlUrl, 'utf8');
+          extracted.push(extractFixture(fixture, html));
+        }
+        const home = extracted.find((item) => item.id === 'home');
+        const cushing = extracted.find((item) => item.id === 'article--sindrome-cushing-perros-mayores');
+        if (!home?.h1 || !cushing?.h1 || extracted.some((item) => item.missingSentinels.length)) {
+          throw new Error(`F0_SELECTION_FAILURE: ${JSON.stringify(extracted.filter((item) => item.missingSentinels.length))}`);
+        }
+        const samples = [home, cushing].map((item) => ({
+          id: item.id,
+          title: item.h1,
+          path: item.path,
+          url: `https://cuidatuperroviejo.com${item.path}`,
+          language: 'es',
+          markdown: `# ${item.h1}\n\n${item.selectedText}\n`,
+        }));
+        const artifactFiles = [];
+        for (const sample of samples) {
+          const name = `${sample.id}.md`;
+          const bytes = Buffer.from(sample.markdown, 'utf8');
+          await writeFile(new URL(name, documentsRoot), bytes);
+          artifactFiles.push({ path: `agent-content/v1/documents/${name}`, bytes: bytes.length, sha256: createHash('sha256').update(bytes).digest('hex') });
+        }
+        const index = {
+          schemaVersion: 'agent-content/1',
+          generatedFrom: 'rendered-html',
+          documents: samples.map(({ id, title, path, url, language }) => ({ id, title, path, url, language, markdownPath: `/agent-content/v1/documents/${id}.md` })),
+        };
+        const indexBytes = Buffer.from(`${JSON.stringify(index, null, 2)}\n`, 'utf8');
+        await writeFile(new URL('./index.json', outputRoot), indexBytes);
+        artifactFiles.push({ path: 'agent-content/v1/index.json', bytes: indexBytes.length, sha256: createHash('sha256').update(indexBytes).digest('hex') });
+        const parity = { schemaVersion: 'agent-content-parity/1', sourceCommit: process.env.F0_SOURCE_COMMIT ?? null, fixtures: extracted.map(({ selectedText, missingSentinels, ...fixture }) => fixture), selectionSummary: extracted.map(({ path, selector, missingSentinels }) => ({ path, selector, selected: missingSentinels.length === 0, missingSentinels })) };
+        const parityBytes = Buffer.from(`${JSON.stringify(parity, null, 2)}\n`, 'utf8');
+        const proof = {
+          schemaVersion: 'f0-build-hook-proof/1',
+          hook: 'astro:build:done',
+          observedOrder: 'HTML outputs already exist -> seven fixtures selected -> Markdown and index written during astro:build:done -> pack verification is performed by Wrangler dry-run after Astro build',
+          clientDirectory: new URL('.', clientDir).pathname,
+          effectiveWranglerSource: {
+            main: sourceConfig.main,
+            compatibilityDate: sourceConfig.compatibility_date,
+            assets: sourceConfig.assets,
+            namedBindings: Object.keys(sourceConfig).filter((key) => ['ai', 'kv_namespaces', 'd1_databases', 'send_email', 'ratelimits', 'services', 'r2_buckets', 'queues', 'durable_objects'].includes(key)),
+          },
+          activeCacheLayers: [
+            { layer: 'Astro middleware Cache API', representation: 'HTML responses only; internal key includes /html and excludes visitor query', exercised: 'only when Astro handler reaches middleware; static asset hits may short-circuit it' },
+            { layer: 'Cloudflare Assets local worker', representation: 'prebuilt HTML paths and separate Markdown asset paths', exercised: 'workerd local preview' },
+            { layer: 'Cloudflare CDN', representation: 'unknown from local workerd', exercised: false },
+          ],
+          sampleCount: samples.length,
+          fixtureCount: extracted.length,
+          emitted: [...artifactFiles, { path: 'agent-content/v1/.f0-spike-parity-manifest.json', bytes: parityBytes.length, sha256: createHash('sha256').update(parityBytes).digest('hex') }],
+        };
+        await writeFile(new URL('./.f0-spike-parity-manifest.json', outputRoot), parityBytes);
+        await writeFile(new URL('./build-proof.json', outputRoot), `${JSON.stringify(proof, null, 2)}\n`);
+        logger.info(`F0 spike generated ${samples.length} Markdown samples from ${extracted.length} rendered HTML fixtures in ${new URL('.', clientDir).pathname}`);
+      },
+    },
+  };
+}
