+import { createHash } from 'node:crypto';
+import { mkdir, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+const args = new Map();
+for (let index = 2; index < process.argv.length; index += 2) {
+  const key = process.argv[index];
+  const value = process.argv[index + 1];
+  if (!key?.startsWith('--') || !value || args.has(key)) throw new Error(`invalid or repeated argument: ${key ?? ''}`);
+  args.set(key, value);
+}
+if (args.size !== 2 || !args.has('--origin') || !args.has('--out')) throw new Error('usage: node scripts/f0-spike/verify-preview.mjs --origin http://127.0.0.1:8787 --out /tmp/f0-preview.json');
+const origin = new URL(args.get('--origin'));
+if (origin.protocol !== 'http:' || !['127.0.0.1', 'localhost', '[::1]'].includes(origin.hostname)) throw new Error('preview origin must be loopback HTTP');
+const target = new URL('/', origin);
+const checks = [];
+const hash = (bytes) => createHash('sha256').update(bytes).digest('hex');
+
+async function request(path = '/', { accept, method = 'GET', headers = {}, redirect = 'manual' } = {}) {
+  const requestHeaders = new Headers(headers);
+  if (accept !== undefined) requestHeaders.set('Accept', accept);
+  const response = await fetch(new URL(path, origin), { method, headers: requestHeaders, redirect });
+  const bytes = new Uint8Array(await response.arrayBuffer());
+  return {
+    status: response.status,
+    bodyBytes: bytes.length,
+    bodySha256: hash(bytes),
+    contentType: response.headers.get('Content-Type'),
+    vary: response.headers.get('Vary'),
+    etag: response.headers.get('ETag'),
+    location: response.headers.get('Location'),
+    workerPath: response.headers.get('X-F0-Worker-Path'),
+    edgeCache: response.headers.get('X-Edge-Cache'),
+    body: new TextDecoder().decode(bytes),
+  };
+}
+
+function assert(condition, message) { if (!condition) throw new Error(message); }
+async function record(name, run) {
+  const result = await run();
+  const { body, ...safeResult } = result;
+  checks.push({ name, ...safeResult });
+  return result;
+}
+
+const matrix = [
+  ['no Accept', undefined, 200, 'text/html'],
+  ['wildcard', '*/*', 200, 'text/html'],
+  ['HTML explicit', 'text/html', 200, 'text/html'],
+  ['Markdown explicit', 'text/markdown', 200, 'text/markdown'],
+  ['Markdown q0 exclusion', 'text/markdown;q=0, text/html;q=1', 200, 'text/html'],
+  ['Markdown preferred', 'text/markdown;q=1, text/html;q=0.5', 200, 'text/markdown'],
+  ['HTML preferred', 'text/markdown;q=0.5, text/html;q=1', 200, 'text/html'],
+  ['equal quality tie', 'text/markdown;q=1, text/html;q=1', 200, 'text/html'],
+  ['specific q0 beats text wildcard', 'text/*;q=0.8, text/markdown;q=0', 200, 'text/html'],
+  ['specific Markdown beats wildcard', 'text/markdown;q=1, */*;q=0.1', 200, 'text/markdown'],
+  ['Markdown q0 beats all wildcard', 'text/markdown;q=0, */*;q=1', 200, 'text/html'],
+  ['unsupported media type', 'application/json', 406, null],
+  ['all accepted representations excluded', 'text/html;q=0, text/markdown;q=0', 406, null],
+  ['invalid q only', 'text/markdown;q=wat', 400, null],
+];
+for (const [name, accept, status, contentPrefix] of matrix) {
+  const response = await record(`Accept: ${name}`, () => request('/', { accept }));
+  assert(response.status === status, `${name}: expected ${status}, got ${response.status}`);
+  if (contentPrefix) assert(response.contentType?.startsWith(contentPrefix), `${name}: unexpected MIME ${response.contentType}`);
+  if (status === 200) assert(response.vary?.toLowerCase().includes('accept'), `${name}: Vary: Accept absent`);
+}
+
+const cushingPath = '/salud-perros-mayores/sindrome-cushing-perros-mayores';
+for (const [representation, accept, mime] of [['HTML', 'text/html', 'text/html'], ['Markdown', 'text/markdown', 'text/markdown']]) {
+  const response = await record(`Cushing ${representation} route`, () => request(cushingPath, { accept }));
+  assert(response.status === 200 && response.contentType?.startsWith(mime), `Cushing ${representation} route failed: ${response.status}/${response.contentType}`);
+  assert(response.vary?.toLowerCase().includes('accept'), `Cushing ${representation} lacks Vary: Accept`);
+  if (representation === 'Markdown') assert(response.body.startsWith('# Síndrome de Cushing'), 'Cushing Markdown asset is not the matching document');
+}
+
+const assistantCatalog = await record('static assistant catalog delegation', () => request('/api/assistant-catalog.json'));
+assert(assistantCatalog.status === 200 && assistantCatalog.contentType?.includes('json'), `assistant catalog delegation failed: ${assistantCatalog.status}/${assistantCatalog.contentType}`);
+
+for (const order of [['html', 'markdown', 'html'], ['markdown', 'html', 'markdown']]) {
+  const representations = [];
+  for (let round = 0; round < 2; round += 1) {
+    for (const representation of order) {
+      const accept = representation === 'html' ? 'text/html' : 'text/markdown';
+      const response = await record(`alternation ${order.join('→')} round ${round + 1} ${representation}`, () => request('/', { accept }));
+      assert(response.status === 200, `alternation returned ${response.status}`);
+      assert(response.contentType?.startsWith(representation === 'html' ? 'text/html' : 'text/markdown'), `alternation returned wrong MIME for ${representation}`);
+      if (response.workerPath !== 'worker-first') throw new Error('loopback diagnostic header absent; request did not prove local worker path');
+      representations.push(response);
+    }
+  }
+  checks.push({ name: `alternation-summary ${order.join('→')}`, representations: representations.map(({ contentType, etag, edgeCache, bodySha256 }) => ({ contentType, etag, edgeCache, bodySha256 })) });
+}
+
+for (const [label, accept] of [['html', 'text/html'], ['markdown', 'text/markdown']]) {
+  const head = await record(`HEAD ${label}`, () => request('/', { method: 'HEAD', accept }));
+  assert(head.status === 200 && head.bodyBytes === 0, `HEAD ${label} status/body mismatch`);
+}
+
+const html = await request('/', { accept: 'text/html' });
+const markdown = await request('/', { accept: 'text/markdown' });
+if (html.etag) {
+  const same = await record('same representation validator HTML', () => request('/', { accept: 'text/html', headers: { 'If-None-Match': html.etag } }));
+  assert(same.status === 304, `same HTML ETag should return 304, got ${same.status}`);
+} else checks.push({ name: 'same representation validator HTML', result: 'HTML ETag absent' });
+if (markdown.etag) {
+  const same = await record('same representation validator Markdown', () => request('/', { accept: 'text/markdown', headers: { 'If-None-Match': markdown.etag } }));
+  assert(same.status === 304, `same Markdown ETag should return 304, got ${same.status}`);
+} else checks.push({ name: 'same representation validator Markdown', result: 'Markdown ETag absent' });
+const cross = await record('cross representation HTML validator sent to Markdown', () => request('/', { accept: 'text/markdown', headers: html.etag ? { 'If-None-Match': html.etag } : {} }));
+assert(cross.status !== 304, `HTML validator leaked to Markdown as 304 (${html.etag ?? 'no HTML ETag'})`);
+const crossReverse = await record('cross representation Markdown validator sent to HTML', () => request('/', { accept: 'text/html', headers: markdown.etag ? { 'If-None-Match': markdown.etag } : {} }));
+assert(crossReverse.status !== 304, `Markdown validator leaked to HTML as 304 (${markdown.etag ?? 'no Markdown ETag'})`);
+
+const missing = await record('missing negotiated document', () => request('/not-a-document', { accept: 'text/markdown' }));
+assert(missing.status === 404 && !missing.body.includes('agent-content/v1'), `missing route did not remain 404: ${missing.status}`);
+const legacy = await record('legacy redirect remains redirect', () => request('/2025/10/revision-veterinaria-perros-mayores.html', { accept: 'text/markdown' }));
+assert(legacy.status === 301 && legacy.location === '/salud-perros-mayores/chequeo-geriatrico-canino', `legacy redirect changed: ${legacy.status} ${legacy.location}`);
+const auth = await record('Authorization is not stored or logged', () => request('/', { accept: 'text/html', headers: { Authorization: 'Bearer F0-FICTITIOUS-NEVER-STORE' } }));
+assert(auth.status === 200, `Authorization check failed with ${auth.status}`);
+assert(!JSON.stringify(checks).includes('F0-FICTITIOUS-NEVER-STORE'), 'fictitious Authorization value entered evidence');
+const queryOne = await request('/?visitor=one', { accept: 'text/html' });
+const queryTwo = await request('/?visitor=two', { accept: 'text/html' });
+assert(queryOne.status === 200 && queryTwo.status === 200, 'visitor query changed static HTML status');
+
+const report = {
+  schemaVersion: 'f0-preview-verification/1',
+  target: target.origin,
+  remoteBindings: false,
+  checkedAt: new Date().toISOString(),
+  checks,
+  htmlMarkdownBodiesDiffer: html.bodySha256 !== markdown.bodySha256,
+  visitorQueryBodiesSame: queryOne.bodySha256 === queryTwo.bodySha256,
+};
+assert(report.htmlMarkdownBodiesDiffer, 'HTML and Markdown body hashes unexpectedly match');
+assert(report.visitorQueryBodiesSame, 'visitor query changed generated static HTML body');
+delete html.body;
+delete markdown.body;
+const output = resolve(args.get('--out'));
+await mkdir(dirname(output), { recursive: true });
+await writeFile(output, `${JSON.stringify(report, null, 2)}\n`, { flag: 'wx' });
+console.log(JSON.stringify({ output, checks: checks.length, remoteBindings: false, result: 'pass' }));
