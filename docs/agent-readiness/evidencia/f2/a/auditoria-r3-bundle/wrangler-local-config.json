{
  "name": "cuidatuperroviejo",
  "main": "entry.mjs",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../client",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/admin/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "local-session"
    }
  ],
  "dev": {
    "ip": "localhost",
    "local_protocol": "http",
    "upstream_protocol": "http",
    "enable_containers": true,
    "generate_types": false
  }
}
