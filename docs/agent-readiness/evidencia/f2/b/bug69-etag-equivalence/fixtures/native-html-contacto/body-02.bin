]/70 rounded-[32px] shadow-[0_20px_50px_rgba(0,0,0,0.15)] dark:shadow-[0_24px_60px_rgba(0,0,0,0.44)] flex flex-col overflow-hidden transition-all duration-300 transform translate-y-4 opacity-0 pointer-events-none"><!-- Header (Gradient with brand identity) --><header class="bg-gradient-to-r from-[#45634f] to-[#5d7c67] dark:from-[#202820] dark:to-[#182019] px-6 py-4.5 flex items-center justify-between text-white border-b border-[#dbdad5]/30 dark:border-[#385842]/60 shadow-md"><div class="flex items-center gap-3"><div class="w-9 h-9 rounded-xl bg-white/10 dark:bg-[#adcfb6]/14 flex items-center justify-center text-lg shadow-inner"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="7.2" cy="8" r="2.2"></circle><circle cx="16.8" cy="8" r="2.2"></circle><circle cx="4.8" cy="12.7" r="1.9"></circle><circle cx="19.2" cy="12.7" r="1.9"></circle><path d="M12 11.2c-3.5 0-6.4 2.7-6.4 6 0 2 1.5 3.2 3.4 3.2 1.1 0 2-.5 3-.5s1.9.5 3 .5c1.9 0 3.4-1.2 3.4-3.2 0-3.3-2.9-6-6.4-6Z"></path></svg></div><div><h3 class="text-[10px] font-bold tracking-widest uppercase text-white/70 dark:text-[#adcfb6]/70 leading-none mb-1">Asistente de Bienestar</h3><span class="text-sm font-extrabold tracking-tight font-serif flex items-center gap-1.5 leading-none">Canine Advisor<span class="relative flex h-2 w-2"><span class="ai-online-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span></span></div></div><div class="flex items-center gap-1"><a href="/asistente-ia" class="w-11 h-11 rounded-full hover:bg-white/10 dark:hover:bg-[#adcfb6]/10 flex items-center justify-center text-white/80 dark:text-[#adcfb6]/80 hover:text-white dark:hover:text-[#adcfb6] transition-colors cursor-pointer" title="Ver en pantalla completa" aria-label="Ver en pantalla completa"><svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></a><button id="ai-chat-close" class="w-11 h-11 rounded-full hover:bg-white/10 dark:hover:bg-[#adcfb6]/10 flex items-center justify-center text-white/80 dark:text-[#adcfb6]/80 hover:text-white dark:hover:text-[#adcfb6] transition-colors cursor-pointer" aria-label="Cerrar chat"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg></button></div></header><!-- Messages List --><div id="ai-chat-messages" class="flex-1 overflow-y-auto p-5 space-y-6 scroll-smooth bg-gradient-to-b from-[#faf9f4]/20 to-[#f5f4ef]/40 dark:from-[#131713] dark:to-[#171d18]"><!-- Welcome message --><div class="flex items-start gap-3 max-w-[85%] animate-fade-in"><div class="w-8 h-8 rounded-full bg-brand-primary/10 dark:bg-[#adcfb6]/14 flex items-center justify-center text-xs shrink-0 select-none shadow-sm"><svg class="h-4 w-4 text-brand-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="7.2" cy="8" r="2.2"></circle><circle cx="16.8" cy="8" r="2.2"></circle><circle cx="4.8" cy="12.7" r="1.9"></circle><circle cx="19.2" cy="12.7" r="1.9"></circle><path d="M12 11.2c-3.5 0-6.4 2.7-6.4 6 0 2 1.5 3.2 3.4 3.2 1.1 0 2-.5 3-.5s1.9.5 3 .5c1.9 0 3.4-1.2 3.4-3.2 0-3.3-2.9-6-6.4-6Z"></path></svg></div><div class="bg-[#f4f6f3] dark:bg-[#202820] border border-[#dbdad5] dark:border-[#385842]/70 px-4 py-3.5 rounded-2xl rounded-tl-none shadow-sm dark:shadow-[0_10px_28px_rgba(0,0,0,0.18)]"><p class="text-xs text-brand-text dark:text-[#f3fff1] leading-relaxed font-light">¡Hola! Soy tu asistente de bienestar para perros mayores. Pregúntame sobre alimentación, dolor articular (artrosis), ejercicio o cambios de comportamiento. ¿En qué te ayudo hoy?</p></div></div><!-- Suggested Quick Prompts --><div id="ai-chat-suggestions" class="space-y-3 pt-2"><p class="text-[10px] text-brand-muted/80 dark:text-[#adcfb6]/80 font-bold uppercase tracking-wider pl-11 select-none">Temas sugeridos:</p><div class="flex flex-col gap-2.5 pl-11 pr-2"><button class="chat-suggest-btn flex items-center gap-2.5 w-full text-left px-4 py-3 bg-[#faf9f4]/80 dark:bg-[#202820] hover:bg-[#45634f]/5 dark:hover:bg-[#273327] border border-[#dbdad5] dark:border-[#385842]/70 text-xs text-brand-text dark:text-[#f3fff1] rounded-2xl transition-all cursor-pointer shadow-sm hover:scale-[1.02] active:scale-[0.98] font-medium"><span class="text-brand-primary dark:text-[#adcfb6]">💡</span><span>¿Cómo saber si mi perro tiene dolor?</span></button><button class="chat-suggest-btn flex items-center gap-2.5 w-full text-left px-4 py-3 bg-[#faf9f4]/80 dark:bg-[#202820] hover:bg-[#45634f]/5 dark:hover:bg-[#273327] border border-[#dbdad5] dark:border-[#385842]/70 text-xs text-brand-text dark:text-[#f3fff1] rounded-2xl transition-all cursor-pointer shadow-sm hover:scale-[1.02] active:scale-[0.98] font-medium"><span class="text-brand-primary dark:text-[#adcfb6]">🦴</span><span>¿Qué comida dar a un perro de 12 años?</span></button><button class="chat-suggest-btn flex items-center gap-2.5 w-full text-left px-4 py-3 bg-[#faf9f4]/80 dark:bg-[#202820] hover:bg-[#45634f]/5 dark:hover:bg-[#273327] border border-[#dbdad5] dark:border-[#385842]/70 text-xs text-brand-text dark:text-[#f3fff1] rounded-2xl transition-all cursor-pointer shadow-sm hover:scale-[1.02] active:scale-[0.98] font-medium"><span class="text-brand-primary dark:text-[#adcfb6]">🌙</span><span>Mi perro senior está desorientado de noche</span></button></div></div></div><!-- Footer Disclaimer (High readability) --><div class="px-5 py-3 border-t border-[#dbdad5]/30 dark:border-[#385842]/45 bg-[#faf9f4]/50 dark:bg-[#151a16] text-center select-none shadow-[0_-2px_10px_rgba(0,0,0,0.01)]"><p class="text-[9px] text-brand-muted dark:text-[#adcfb6]/70 leading-relaxed font-light">⚠️ <em>Este asistente virtual no sustituye el diagnóstico de un veterinario. Si tu mascota tiene una urgencia clínica, acude a un centro de inmediato.</em></p></div><!-- Input Form --><form id="ai-chat-form" class="p-3.5 border-t border-[#dbdad5]/30 dark:border-[#385842]/45 bg-white dark:bg-[#151a16] flex items-center gap-2.5"><input type="text" id="ai-chat-input" placeholder="Escribe tu consulta aquí..." maxlength="300" required autocomplete="off" class="flex-1 px-4.5 py-3 bg-[#faf9f4]/50 dark:bg-[#202820] border border-[#dbdad5] dark:border-[#385842]/70 focus:border-brand-primary dark:focus:border-[#adcfb6] focus:ring-2 focus:ring-brand-primary/10 dark:focus:ring-[#adcfb6]/18 rounded-2xl text-base sm:text-xs text-brand-text dark:text-[#f3fff1] placeholder-brand-muted/50 dark:placeholder-[#9fc6aa]/60 focus:outline-none transition-all"><button type="submit" class="w-11 h-11 bg-brand-primary hover:bg-[#5d7c67] active:scale-95 text-white dark:text-[#121412] dark:bg-[#adcfb6] dark:hover:bg-[#c9ebd1] rounded-2xl flex items-center justify-center shadow-md hover:shadow-lg transition-all shrink-0 cursor-pointer" aria-label="Enviar pregunta"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg></button></form></div><script type="module" src="/_astro/CanineAiAssistant.astro_astro_type_script_index_0_lang.BGkTvlqC.js"></script><script>
      (() => {
        const toggle = document.querySelector('.mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        const openIcon = document.querySelector('.mobile-menu-open');
        const closeIcon = document.querySelector('.mobile-menu-close');
        if (!toggle || !menu || !openIcon || !closeIcon) return;

        const setMenuState = (isOpen) => {
          menu.classList.toggle('hidden', !isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
          toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
          openIcon.classList.toggle('hidden', isOpen);
          closeIcon.classList.toggle('hidden', !isOpen);
        };

        toggle.addEventListener('click', () => {
          setMenuState(toggle.getAttribute('aria-expanded') !== 'true');
        });

        menu.querySelectorAll('.mobile-menu-link').forEach((link) => {
          link.addEventListener('click', () => setMenuState(false));
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenuState(false);
        });

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (target instanceof Node && !menu.contains(target) && !toggle.contains(target)) {
            setMenuState(false);
          }
        });
      })();
    </script></body></html>