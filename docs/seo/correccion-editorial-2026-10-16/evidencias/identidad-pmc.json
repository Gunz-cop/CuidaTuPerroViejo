              "journalIssueId": 3429662,
              "dateOfPublication": "2022 Sep",
              "monthOfPublication": 9,
              "yearOfPublication": 2022,
              "journal": {
                "medlineAbbreviation": "J Vet Intern Med",
                "title": "Journal of veterinary internal medicine",
                "essn": "1939-1676",
                "issn": "0891-6640",
                "isoabbreviation": "J Vet Intern Med",
                "nlmid": "8708660"
