              "journalIssueId": 3987114,
              "dateOfPublication": "2025 Aug",
              "monthOfPublication": 8,
              "yearOfPublication": 2025,
              "journal": {
                "medlineAbbreviation": "Am J Vet Res",
                "title": "American journal of veterinary research",
                "essn": "1943-5681",
